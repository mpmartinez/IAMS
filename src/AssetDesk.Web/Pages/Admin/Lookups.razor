@page "/admin/lookups"
@using AssetDesk.Web.Components.UI
@attribute [Authorize(Roles = "SuperAdmin")]
@inject ApiClient Api
@inject SnackbarService Snackbar

<PageTitle>Reference Data - AssetDesk</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold text-foreground">Reference Data</h1>
        <p class="text-muted-foreground mt-1">
            The shared vocabulary every tenant's dropdowns draw from - device types, currencies,
            categories. Changes apply globally.
        </p>
    </div>

    <!-- Type picker -->
    <Card Class="p-4 sm:p-5">
        @if (_types is null)
        {
            <div class="space-y-3">
                <div class="h-4 w-24 rounded skeleton"></div>
                <div class="flex flex-wrap gap-2">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="h-8 w-28 rounded-lg skeleton"></div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="space-y-4">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">Editable</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var t in _types.Where(t => t.IsEditable))
                        {
                            <Button Variant="@TypeChipVariant(t)" Size="none" Class="@TypeChipClass" OnClick="() => SelectType(t)">
                                @t.DisplayName
                            </Button>
                        }
                    </div>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">Locked - read only</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var t in _types.Where(t => !t.IsEditable))
                        {
                            <Button Variant="@TypeChipVariant(t)" Size="none" Class="@TypeChipClass" OnClick="() => SelectType(t)">
                                <svg class="w-3.5 h-3.5 mr-1.5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                                @t.DisplayName
                            </Button>
                        }
                    </div>
                </div>
            </div>
        }
    </Card>

    <!-- Values -->
    @if (_selectedType is not null)
    {
        <Card Class="overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 sm:p-5 border-b border-border">
                <div>
                    <h2 class="font-semibold text-foreground">@_selectedType.DisplayName</h2>
                    @if (!_selectedType.IsEditable)
                    {
                        <p class="text-sm text-muted-foreground mt-0.5">Shown for reference only.</p>
                    }
                </div>
                @if (_selectedType.IsEditable)
                {
                    <Button OnClick="OpenAddModal" Size="sm">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Add Value
                    </Button>
                }
            </div>

            @if (!_selectedType.IsEditable)
            {
                <div class="p-4 sm:p-5">
                    <Alert Variant="warning" Title="Why this is locked">
                        @_selectedType.LockedReason
                    </Alert>
                </div>
            }

            <div class="p-4 sm:p-5 pt-0">
                @if (_loadingValues)
                {
                    <div class="space-y-2 pt-4">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="h-12 rounded-xl skeleton"></div>
                        }
                    </div>
                }
                else if (_values is null || _values.Count == 0)
                {
                    <EmptyState Title="No values yet" Description="Add the first value for this type." />
                }
                else
                {
                    <Table>
                        <TableHeader>
                            <TableRow>
                                <TableHead>Label</TableHead>
                                <TableHead>Code</TableHead>
                                <TableHead>Active</TableHead>
                                <TableHead Class="text-right">&nbsp;</TableHead>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @for (var i = 0; i < _values.Count; i++)
                            {
                                var value = _values[i];
                                var index = i;
                                <TableRow @key="value.Id" Class="@(value.IsActive ? "" : "opacity-50")">
                                    <TableCell>
                                        <span class="font-medium text-foreground text-sm">@value.Label</span>
                                    </TableCell>
                                    <TableCell>
                                        <span class="text-xs font-mono text-muted-foreground">@value.Value</span>
                                    </TableCell>
                                    <TableCell>
                                        @if (_selectedType.IsEditable)
                                        {
                                            <Switch Value="@value.IsActive" ValueChanged="v => ToggleActive(value, v)" />
                                        }
                                        else
                                        {
                                            <Badge Variant="@(value.IsActive ? "success" : "secondary")">@(value.IsActive ? "Active" : "Inactive")</Badge>
                                        }
                                    </TableCell>
                                    <TableCell>
                                        @if (_selectedType.IsEditable)
                                        {
                                            <div class="flex items-center justify-end gap-1">
                                                <Button Variant="ghost" Size="icon-sm" Disabled="@(index == 0)" Title="Move up" Class="text-muted-foreground" OnClick="() => Move(index, -1)">
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                                    </svg>
                                                </Button>
                                                <Button Variant="ghost" Size="icon-sm" Disabled="@(index == _values.Count - 1)" Title="Move down" Class="text-muted-foreground" OnClick="() => Move(index, 1)">
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                                    </svg>
                                                </Button>
                                                <Button Variant="ghost" Size="icon-sm" Title="Rename" Class="text-muted-foreground" OnClick="() => OpenEditModal(value)">
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                </Button>
                                            </div>
                                        }
                                    </TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                }
            </div>
        </Card>
    }
</div>

<!-- Add/Edit Modal -->
<Modal IsOpen="@_showValueModal" Title="@(_editingValue is null ? "Add Value" : "Rename Value")" OnClose="CloseValueModal">
    <ChildContent>
        <div class="space-y-4">
            @if (_editingValue is null)
            {
                <FormField LabelText="Code" Description="Stored on every record that uses this value - cannot be changed later.">
                    <Input Value="@_formValue" ValueChanged="v => _formValue = v" Placeholder="e.g. Drone" MaxLength="50" />
                </FormField>
            }
            else
            {
                <FormField LabelText="Code">
                    <Input Value="@_editingValue.Value" Disabled="true" />
                </FormField>
            }

            <FormField LabelText="Label" Description="What shows up in dropdowns.">
                <Input Value="@_formLabel" ValueChanged="v => _formLabel = v" Placeholder="e.g. Drone" MaxLength="100" />
            </FormField>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="flex items-start gap-2 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-900/50">
                    <p class="text-sm text-red-700 dark:text-red-400">@_formError</p>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <Button Variant="ghost" OnClick="CloseValueModal">Cancel</Button>
        <Button OnClick="SaveValue" Loading="@_saving" Disabled="@(string.IsNullOrWhiteSpace(_formLabel) || (_editingValue is null && string.IsNullOrWhiteSpace(_formValue)))">
            @(_editingValue is null ? "Add" : "Save")
        </Button>
    </FooterContent>
</Modal>

@code {
    private List<LookupTypeDto>? _types;
    private LookupTypeDto? _selectedType;
    private List<LookupValueDto>? _values;
    private bool _loadingValues;

    private bool _showValueModal;
    private LookupValueDto? _editingValue;
    private string _formValue = "";
    private string _formLabel = "";
    private string? _formError;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _types = await Api.GetLookupTypesAsync();
        var first = _types?.FirstOrDefault(t => t.IsEditable) ?? _types?.FirstOrDefault();
        if (first is not null)
            await SelectType(first);
    }

    private async Task SelectType(LookupTypeDto type)
    {
        _selectedType = type;
        _loadingValues = true;
        StateHasChanged();

        _values = (await Api.GetLookupValuesAsync(type.Type, includeInactive: true))
            ?.OrderBy(v => v.SortOrder).ThenBy(v => v.Label).ToList();

        _loadingValues = false;
    }

    private const string TypeChipClass = "px-3 py-1.5 rounded-lg text-sm font-medium";

    // A locked type is still selectable, just never editable - it reads as a neutral chip
    // rather than the primary one so the two groups stay visually distinct.
    private string TypeChipVariant(LookupTypeDto type)
    {
        if (_selectedType?.Type != type.Type)
            return "outline";

        return type.IsEditable ? "default" : "secondary";
    }

    private async Task ToggleActive(LookupValueDto value, bool isActive)
    {
        var (success, error) = await Api.UpdateLookupValueAsync(value.Id, new UpdateLookupValueDto { IsActive = isActive });
        if (success)
        {
            Snackbar.Success(isActive ? "Value activated" : "Value deactivated");
            await SelectType(_selectedType!);
        }
        else
        {
            Snackbar.Error(error ?? "Could not update the value.");
        }
    }

    private async Task Move(int index, int direction)
    {
        if (_values is null || _selectedType is null) return;

        var target = index + direction;
        if (target < 0 || target >= _values.Count) return;

        (_values[index], _values[target]) = (_values[target], _values[index]);
        var orderedIds = _values.Select(v => v.Id).ToList();

        var (success, error) = await Api.ReorderLookupValuesAsync(_selectedType.Type, orderedIds);
        if (!success)
            Snackbar.Error(error ?? "Could not reorder.");

        // Reload either way: on success this picks up the server-assigned SortOrder values:
        // on failure it reverts the optimistic local swap above.
        await SelectType(_selectedType);
    }

    private void OpenAddModal()
    {
        _editingValue = null;
        _formValue = "";
        _formLabel = "";
        _formError = null;
        _showValueModal = true;
    }

    private void OpenEditModal(LookupValueDto value)
    {
        _editingValue = value;
        _formValue = value.Value;
        _formLabel = value.Label;
        _formError = null;
        _showValueModal = true;
    }

    private void CloseValueModal()
    {
        _showValueModal = false;
        _editingValue = null;
        _formError = null;
    }

    private async Task SaveValue()
    {
        if (_selectedType is null) return;

        _formError = null;
        _saving = true;

        if (_editingValue is null)
        {
            var (success, _, error) = await Api.CreateLookupValueAsync(new CreateLookupValueDto
            {
                LookupType = _selectedType.Type,
                Value = _formValue.Trim(),
                Label = _formLabel.Trim()
            });

            if (success)
            {
                Snackbar.Success("Value added");
                CloseValueModal();
                await SelectType(_selectedType);
            }
            else
            {
                _formError = error;
            }
        }
        else
        {
            var (success, error) = await Api.UpdateLookupValueAsync(_editingValue.Id, new UpdateLookupValueDto
            {
                Label = _formLabel.Trim()
            });

            if (success)
            {
                Snackbar.Success("Value updated");
                CloseValueModal();
                await SelectType(_selectedType);
            }
            else
            {
                _formError = error;
            }
        }

        _saving = false;
    }
}
