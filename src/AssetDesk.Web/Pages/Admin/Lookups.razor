@page "/admin/lookups"
@using AssetDesk.Web.Components.UI
@attribute [Authorize(Roles = "SuperAdmin")]
@inject ApiClient Api
@inject SnackbarService Snackbar

<PageTitle>Reference Data - AssetDesk</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Reference Data</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-1">
            The shared vocabulary every tenant's dropdowns draw from - device types, currencies,
            categories. Changes apply globally.
        </p>
    </div>

    <!-- Type picker -->
    <Card Class="p-4 sm:p-5">
        @if (_types is null)
        {
            <div class="space-y-3">
                <div class="h-4 w-24 rounded skeleton"></div>
                <div class="flex flex-wrap gap-2">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="h-8 w-28 rounded-lg skeleton"></div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="space-y-4">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">Editable</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var t in _types.Where(t => t.IsEditable))
                        {
                            <button @onclick="() => SelectType(t)" class="@TypeChipClass(t)">
                                @t.DisplayName
                            </button>
                        }
                    </div>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2">Locked - read only</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var t in _types.Where(t => !t.IsEditable))
                        {
                            <button @onclick="() => SelectType(t)" class="@TypeChipClass(t)">
                                <svg class="w-3.5 h-3.5 mr-1.5 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                                @t.DisplayName
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </Card>

    <!-- Values -->
    @if (_selectedType is not null)
    {
        <Card Class="overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 sm:p-5 border-b border-slate-200 dark:border-slate-700">
                <div>
                    <h2 class="font-semibold text-slate-900 dark:text-white">@_selectedType.DisplayName</h2>
                    @if (!_selectedType.IsEditable)
                    {
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Shown for reference only.</p>
                    }
                </div>
                @if (_selectedType.IsEditable)
                {
                    <Button OnClick="OpenAddModal" Size="sm">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Add Value
                    </Button>
                }
            </div>

            @if (!_selectedType.IsEditable)
            {
                <div class="p-4 sm:p-5">
                    <Alert Variant="warning" Title="Why this is locked">
                        @_selectedType.LockedReason
                    </Alert>
                </div>
            }

            <div class="p-4 sm:p-5 pt-0">
                @if (_loadingValues)
                {
                    <div class="space-y-2 pt-4">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="h-12 rounded-xl skeleton"></div>
                        }
                    </div>
                }
                else if (_values is null || _values.Count == 0)
                {
                    <EmptyState Title="No values yet" Description="Add the first value for this type." />
                }
                else
                {
                    <div class="overflow-x-auto -mx-4 sm:mx-0">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-slate-200 dark:border-slate-700">
                                    <th class="text-left py-2 px-4 sm:px-2 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Label</th>
                                    <th class="text-left py-2 px-4 sm:px-2 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Code</th>
                                    <th class="text-left py-2 px-4 sm:px-2 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Active</th>
                                    <th class="text-right py-2 px-4 sm:px-2 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">&nbsp;</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
                                @for (var i = 0; i < _values.Count; i++)
                                {
                                    var value = _values[i];
                                    var index = i;
                                    <tr @key="value.Id" class="@(value.IsActive ? "" : "opacity-50")">
                                        <td class="py-2.5 px-4 sm:px-2">
                                            <span class="font-medium text-slate-900 dark:text-white text-sm">@value.Label</span>
                                        </td>
                                        <td class="py-2.5 px-4 sm:px-2">
                                            <span class="text-xs font-mono text-slate-500 dark:text-slate-400">@value.Value</span>
                                        </td>
                                        <td class="py-2.5 px-4 sm:px-2">
                                            @if (_selectedType.IsEditable)
                                            {
                                                <Switch Value="@value.IsActive" ValueChanged="v => ToggleActive(value, v)" />
                                            }
                                            else
                                            {
                                                <Badge Variant="@(value.IsActive ? "success" : "secondary")">@(value.IsActive ? "Active" : "Inactive")</Badge>
                                            }
                                        </td>
                                        <td class="py-2.5 px-4 sm:px-2">
                                            @if (_selectedType.IsEditable)
                                            {
                                                <div class="flex items-center justify-end gap-1">
                                                    <button @onclick="() => Move(index, -1)" disabled="@(index == 0)" title="Move up" class="p-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 disabled:opacity-30 disabled:cursor-not-allowed transition-colors">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                                        </svg>
                                                    </button>
                                                    <button @onclick="() => Move(index, 1)" disabled="@(index == _values.Count - 1)" title="Move down" class="p-1.5 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 disabled:opacity-30 disabled:cursor-not-allowed transition-colors">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                                        </svg>
                                                    </button>
                                                    <button @onclick="() => OpenEditModal(value)" title="Rename" class="p-1.5 text-slate-400 hover:text-primary-600 transition-colors">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                        </svg>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </Card>
    }
</div>

<!-- Add/Edit Modal -->
<Modal IsOpen="@_showValueModal" Title="@(_editingValue is null ? "Add Value" : "Rename Value")" OnClose="CloseValueModal">
    <ChildContent>
        <div class="space-y-4">
            @if (_editingValue is null)
            {
                <FormField LabelText="Code" Description="Stored on every record that uses this value - cannot be changed later.">
                    <Input Value="@_formValue" ValueChanged="v => _formValue = v" Placeholder="e.g. Drone" MaxLength="50" />
                </FormField>
            }
            else
            {
                <FormField LabelText="Code">
                    <Input Value="@_editingValue.Value" Disabled="true" />
                </FormField>
            }

            <FormField LabelText="Label" Description="What shows up in dropdowns.">
                <Input Value="@_formLabel" ValueChanged="v => _formLabel = v" Placeholder="e.g. Drone" MaxLength="100" />
            </FormField>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="flex items-start gap-2 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-900/50">
                    <p class="text-sm text-red-700 dark:text-red-400">@_formError</p>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <Button Variant="ghost" OnClick="CloseValueModal">Cancel</Button>
        <Button OnClick="SaveValue" Loading="@_saving" Disabled="@(string.IsNullOrWhiteSpace(_formLabel) || (_editingValue is null && string.IsNullOrWhiteSpace(_formValue)))">
            @(_editingValue is null ? "Add" : "Save")
        </Button>
    </FooterContent>
</Modal>

@code {
    private List<LookupTypeDto>? _types;
    private LookupTypeDto? _selectedType;
    private List<LookupValueDto>? _values;
    private bool _loadingValues;

    private bool _showValueModal;
    private LookupValueDto? _editingValue;
    private string _formValue = "";
    private string _formLabel = "";
    private string? _formError;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _types = await Api.GetLookupTypesAsync();
        var first = _types?.FirstOrDefault(t => t.IsEditable) ?? _types?.FirstOrDefault();
        if (first is not null)
            await SelectType(first);
    }

    private async Task SelectType(LookupTypeDto type)
    {
        _selectedType = type;
        _loadingValues = true;
        StateHasChanged();

        _values = (await Api.GetLookupValuesAsync(type.Type, includeInactive: true))
            ?.OrderBy(v => v.SortOrder).ThenBy(v => v.Label).ToList();

        _loadingValues = false;
    }

    private string TypeChipClass(LookupTypeDto type)
    {
        const string baseClasses = "inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-medium border transition-colors duration-150";
        var isSelected = _selectedType?.Type == type.Type;

        if (isSelected)
        {
            return type.IsEditable
                ? $"{baseClasses} bg-primary-600 border-primary-600 text-white"
                : $"{baseClasses} bg-slate-700 border-slate-700 text-white dark:bg-slate-600 dark:border-slate-600";
        }

        return $"{baseClasses} bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-500";
    }

    private async Task ToggleActive(LookupValueDto value, bool isActive)
    {
        var (success, error) = await Api.UpdateLookupValueAsync(value.Id, new UpdateLookupValueDto { IsActive = isActive });
        if (success)
        {
            Snackbar.Success(isActive ? "Value activated" : "Value deactivated");
            await SelectType(_selectedType!);
        }
        else
        {
            Snackbar.Error(error ?? "Could not update the value.");
        }
    }

    private async Task Move(int index, int direction)
    {
        if (_values is null || _selectedType is null) return;

        var target = index + direction;
        if (target < 0 || target >= _values.Count) return;

        (_values[index], _values[target]) = (_values[target], _values[index]);
        var orderedIds = _values.Select(v => v.Id).ToList();

        var (success, error) = await Api.ReorderLookupValuesAsync(_selectedType.Type, orderedIds);
        if (!success)
            Snackbar.Error(error ?? "Could not reorder.");

        // Reload either way: on success this picks up the server-assigned SortOrder values:
        // on failure it reverts the optimistic local swap above.
        await SelectType(_selectedType);
    }

    private void OpenAddModal()
    {
        _editingValue = null;
        _formValue = "";
        _formLabel = "";
        _formError = null;
        _showValueModal = true;
    }

    private void OpenEditModal(LookupValueDto value)
    {
        _editingValue = value;
        _formValue = value.Value;
        _formLabel = value.Label;
        _formError = null;
        _showValueModal = true;
    }

    private void CloseValueModal()
    {
        _showValueModal = false;
        _editingValue = null;
        _formError = null;
    }

    private async Task SaveValue()
    {
        if (_selectedType is null) return;

        _formError = null;
        _saving = true;

        if (_editingValue is null)
        {
            var (success, _, error) = await Api.CreateLookupValueAsync(new CreateLookupValueDto
            {
                LookupType = _selectedType.Type,
                Value = _formValue.Trim(),
                Label = _formLabel.Trim()
            });

            if (success)
            {
                Snackbar.Success("Value added");
                CloseValueModal();
                await SelectType(_selectedType);
            }
            else
            {
                _formError = error;
            }
        }
        else
        {
            var (success, error) = await Api.UpdateLookupValueAsync(_editingValue.Id, new UpdateLookupValueDto
            {
                Label = _formLabel.Trim()
            });

            if (success)
            {
                Snackbar.Success("Value updated");
                CloseValueModal();
                await SelectType(_selectedType);
            }
            else
            {
                _formError = error;
            }
        }

        _saving = false;
    }
}
