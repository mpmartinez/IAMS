@page "/admin/tenants"
@using AssetDesk.Web.Components.UI
@attribute [Authorize(Roles = "SuperAdmin")]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject SnackbarService Snackbar

<PageTitle>Tenants - AssetDesk</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-foreground">Tenants</h1>
            <p class="text-muted-foreground mt-1">Manage organizations and subscriptions</p>
        </div>
        <Button Class="shadow-lg shadow-primary/25" OnClick="OpenCreateModal">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Tenant
        </Button>
    </div>

    <!-- Filters -->
    <div class="flex flex-col sm:flex-row gap-4">
        <div class="relative flex-1 max-w-md">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <Input Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search by name or slug..." Class="pl-9" />
        </div>
        <Select Value="@_statusFilter" ValueChanged="OnStatusFilterChanged" Class="sm:w-48">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </Select>
    </div>

    <!-- Tenants Table -->
    <Card Class="p-6">
        @if (_loading)
        {
            <div class="space-y-4">
                @for (int i = 0; i < 5; i++)
                {
                    <Skeleton Class="h-20 w-full" />
                }
            </div>
        }
        else if (_tenants is null || _tenants.Items.Count == 0)
        {
            <EmptyState Title="No tenants found" Description="@(string.IsNullOrEmpty(_search) ? "Create your first tenant to get started." : "Try adjusting your search.")" />
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>Organization</TableHead>
                        <TableHead>Tier</TableHead>
                        <TableHead>Usage</TableHead>
                        <TableHead>Status</TableHead>
                        <TableHead Class="text-right">Actions</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var tenant in _tenants.Items)
                    {
                        <TableRow>
                            <TableCell Class="py-4">
                                <div class="flex items-center gap-3">
                                    <Avatar Size="sm" Fallback="@tenant.Name" Class="rounded-xl" />
                                    <div>
                                        <div class="font-medium text-foreground">@tenant.Name</div>
                                        <div class="text-muted-foreground">@tenant.Slug</div>
                                    </div>
                                </div>
                            </TableCell>
                            <TableCell Class="py-4">
                                <Badge Variant="@GetTierBadgeVariant(tenant.SubscriptionTier)">@tenant.SubscriptionTier</Badge>
                            </TableCell>
                            <TableCell Class="py-4">
                                <div class="space-y-2 min-w-[200px]">
                                    <UsageBar Label="Assets" Current="@tenant.CurrentAssetCount" Max="@tenant.MaxAssets" />
                                    <UsageBar Label="Users" Current="@tenant.CurrentUserCount" Max="@tenant.MaxUsers" />
                                    <UsageBar Label="Storage" Current="@tenant.CurrentStorageBytes" Max="@tenant.MaxStorageBytes" IsBytes="true" />
                                </div>
                            </TableCell>
                            <TableCell Class="py-4">
                                <Badge Variant="@(tenant.IsActive ? "Available" : "Assigned")" Pulse="true">
                                    @(tenant.IsActive ? "Active" : "Inactive")
                                </Badge>
                            </TableCell>
                            <TableCell Class="py-4">
                                <div class="flex items-center justify-end gap-1">
                                    <Button Variant="ghost" Size="icon-sm" Title="Edit" Class="text-muted-foreground" OnClick="() => OpenEditModal(tenant)">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </Button>
                                    @if (tenant.IsActive)
                                    {
                                        <Button Variant="ghost" Size="icon-sm" Title="Deactivate" Class="text-muted-foreground hover:text-destructive" OnClick="() => OpenDeactivateModal(tenant)">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                            </svg>
                                        </Button>
                                    }
                                </div>
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>

            <!-- Pagination -->
            @if (_tenants.TotalCount > _tenants.PageSize)
            {
                <div class="mt-4 border-t pt-2">
                    <Pagination CurrentPage="@_tenants.Page"
                                TotalPages="@((int)Math.Ceiling(_tenants.TotalCount / (double)_tenants.PageSize))"
                                OnPageChange="GoToPage"
                                MaxVisiblePages="5" />
                </div>
            }
        }
    </Card>
</div>

<!-- Create Tenant Modal -->
<Modal IsOpen="@_showCreateModal" Title="Create Tenant" Size="lg" OnClose="CloseCreateModal">
    <ChildContent>
        <div class="space-y-4">
            <p class="text-sm text-muted-foreground">Create a new organization with an admin user.</p>

            <FormField LabelText="Organization Name" Required="true">
                <Input Value="@_createModel.Name" ValueChanged="OnCreateNameChanged" Placeholder="Acme Corporation" />
            </FormField>

            <FormField LabelText="Slug" Required="true" Description="URL-friendly identifier (lowercase, no spaces)">
                <Input Value="@_createModel.Slug" ValueChanged="@(v => _createModel.Slug = v ?? "")" Placeholder="acme-corp" />
            </FormField>

            <FormField LabelText="Subscription Tier" Required="true">
                <Select Value="@_createModel.SubscriptionTier" ValueChanged="@(v => _createModel.SubscriptionTier = v ?? "Free")">
                    @if (_subscriptionTiers is not null)
                    {
                        @foreach (var tier in _subscriptionTiers)
                        {
                            <option value="@tier.Name">@tier.Name (@tier.MaxAssets assets, @tier.MaxUsers users, @tier.MaxStorageDisplay)</option>
                        }
                    }
                    else
                    {
                        <option value="Free">Free</option>
                        <option value="Pro">Pro</option>
                        <option value="Enterprise">Enterprise</option>
                    }
                </Select>
            </FormField>

            <div class="border-t pt-4 mt-4 space-y-4">
                <p class="text-sm font-medium text-foreground">Admin User</p>

                <FormField LabelText="Full Name" Required="true">
                    <Input Value="@_createModel.AdminFullName" ValueChanged="@(v => _createModel.AdminFullName = v ?? "")" Placeholder="John Doe" />
                </FormField>

                <FormField LabelText="Email" Required="true">
                    <Input Type="email" Value="@_createModel.AdminEmail" ValueChanged="@(v => _createModel.AdminEmail = v ?? "")" Placeholder="admin@example.com" />
                </FormField>

                <FormField LabelText="Password" Required="true" Description="Requires uppercase, lowercase, number, and special character">
                    <PasswordInput Value="@_createModel.AdminPassword"
                                   ValueChanged="@(v => _createModel.AdminPassword = v ?? "")"
                                   AutoComplete="new-password"
                                   Placeholder="Min. 8 characters" />
                </FormField>
            </div>

            @if (!string.IsNullOrEmpty(_modalError))
            {
                <Alert Variant="destructive">@_modalError</Alert>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <Button Variant="ghost" OnClick="CloseCreateModal">Cancel</Button>
        <Button OnClick="CreateTenant" Loading="@_saving">Create Tenant</Button>
    </FooterContent>
</Modal>

<!-- Edit Tenant Modal -->
<Modal IsOpen="@(_showEditModal && _editingTenant is not null)" Title="Edit Tenant" Size="lg" OnClose="CloseEditModal">
    <ChildContent>
        @if (_editingTenant is not null)
        {
            <div class="space-y-4">
                <FormField LabelText="Organization Name">
                    <Input Value="@_editModel.Name" ValueChanged="@(v => _editModel.Name = v ?? "")" Placeholder="Organization Name" />
                </FormField>

                <FormField LabelText="Slug" Description="Slug cannot be changed">
                    <Input Value="@_editingTenant.Slug" Disabled="true" />
                </FormField>

                <FormField LabelText="Subscription Tier">
                    <Select Value="@_editModel.SubscriptionTier" ValueChanged="@(v => _editModel.SubscriptionTier = v ?? "")">
                        @if (_subscriptionTiers is not null)
                        {
                            @foreach (var tier in _subscriptionTiers)
                            {
                                <option value="@tier.Name">@tier.Name (@tier.MaxAssets assets, @tier.MaxUsers users)</option>
                            }
                        }
                    </Select>
                </FormField>

                <FormField LabelText="Logo URL">
                    <Input Type="url" Value="@_editModel.LogoUrl" ValueChanged="@(v => _editModel.LogoUrl = v)" Placeholder="https://example.com/logo.png" />
                </FormField>

                <FormField LabelText="Primary Color">
                    <Input Value="@_editModel.PrimaryColor" ValueChanged="@(v => _editModel.PrimaryColor = v)" Placeholder="#3B82F6" />
                </FormField>

                <Switch Value="@_editModel.IsActive" ValueChanged="@(v => _editModel.IsActive = v)">Active</Switch>

                @if (!string.IsNullOrEmpty(_modalError))
                {
                    <Alert Variant="destructive">@_modalError</Alert>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        <Button Variant="ghost" OnClick="CloseEditModal">Cancel</Button>
        <Button OnClick="UpdateTenant" Loading="@_saving">Save Changes</Button>
    </FooterContent>
</Modal>

<!-- Deactivate Confirmation Modal -->
<Dialog IsOpen="@(_showDeactivateModal && _tenantToDeactivate is not null)" Size="sm" OnClose="CloseDeactivateModal">
    <ChildContent>
        @if (_tenantToDeactivate is not null)
        {
            <div class="text-center">
                <div class="w-16 h-16 mx-auto rounded-full bg-destructive/10 flex items-center justify-center mb-4">
                    <svg class="w-8 h-8 text-destructive" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-foreground mb-2">Deactivate Tenant?</h3>
                <p class="text-sm text-muted-foreground mb-6">
                    Are you sure you want to deactivate <span class="font-medium text-foreground">@_tenantToDeactivate.Name</span>? Users will no longer be able to access this organization.
                </p>
                <div class="flex gap-3">
                    <Button Variant="outline" Class="flex-1" OnClick="CloseDeactivateModal">Cancel</Button>
                    <Button Variant="destructive" OnClick="DeactivateTenant" Loading="@_deactivating" Class="flex-1">Deactivate</Button>
                </div>
            </div>
        }
    </ChildContent>
</Dialog>

@code {
    private bool _loading = true;
    private string _search = "";
    private string _statusFilter = "";
    private int _page = 1;
    private PagedResponse<TenantDto>? _tenants;
    private SubscriptionTierInfo[]? _subscriptionTiers;

    // Create Modal State
    private bool _showCreateModal;
    private bool _saving;
    private string? _modalError;
    private CreateTenantModel _createModel = new();

    // Edit Modal State
    private bool _showEditModal;
    private TenantDto? _editingTenant;
    private EditTenantModel _editModel = new();

    // Deactivate Modal State
    private bool _showDeactivateModal;
    private bool _deactivating;
    private TenantDto? _tenantToDeactivate;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubscriptionTiers();
        await LoadTenants();
    }

    private async Task LoadSubscriptionTiers()
    {
        try
        {
            _subscriptionTiers = await Api.GetSubscriptionTiersAsync();
        }
        catch { }
    }

    private async Task LoadTenants()
    {
        _loading = true;
        try
        {
            bool? isActive = _statusFilter switch
            {
                "active" => true,
                "inactive" => false,
                _ => null
            };
            _tenants = await Api.GetTenantsAsync(_search, isActive, _page);
        }
        catch { }
        _loading = false;
    }

    private async Task SearchTenants()
    {
        _page = 1;
        await LoadTenants();
    }

    private async Task GoToPage(int page)
    {
        _page = page;
        await LoadTenants();
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await SearchTenants();
    }

    private async Task OnStatusFilterChanged(string value)
    {
        _statusFilter = value;
        _page = 1;
        await LoadTenants();
    }

    private void OnCreateNameChanged(string value)
    {
        _createModel.Name = value;
        GenerateSlug();
    }

    // Create Modal
    private void OpenCreateModal()
    {
        _createModel = new CreateTenantModel { SubscriptionTier = "Free" };
        _modalError = null;
        _showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
        _modalError = null;
    }

    private void GenerateSlug()
    {
        if (!string.IsNullOrWhiteSpace(_createModel.Name))
        {
            _createModel.Slug = _createModel.Name
                .ToLowerInvariant()
                .Replace(" ", "-")
                .Replace("'", "")
                .Replace("\"", "");
        }
    }

    private async Task CreateTenant()
    {
        _modalError = null;

        if (string.IsNullOrWhiteSpace(_createModel.Name) ||
            string.IsNullOrWhiteSpace(_createModel.Slug) ||
            string.IsNullOrWhiteSpace(_createModel.AdminEmail) ||
            string.IsNullOrWhiteSpace(_createModel.AdminPassword) ||
            string.IsNullOrWhiteSpace(_createModel.AdminFullName))
        {
            _modalError = "Please fill in all required fields.";
            return;
        }

        _saving = true;

        var dto = new CreateTenantDto
        {
            Name = _createModel.Name,
            Slug = _createModel.Slug,
            SubscriptionTier = _createModel.SubscriptionTier,
            AdminEmail = _createModel.AdminEmail,
            AdminPassword = _createModel.AdminPassword,
            AdminFullName = _createModel.AdminFullName
        };

        var (success, _, error) = await Api.CreateTenantAsync(dto);
        _saving = false;

        if (success)
        {
            Snackbar.Success("Tenant created successfully");
            CloseCreateModal();
            await LoadTenants();
        }
        else
        {
            _modalError = error;
        }
    }

    // Edit Modal
    private void OpenEditModal(TenantDto tenant)
    {
        _editingTenant = tenant;
        _editModel = new EditTenantModel
        {
            Name = tenant.Name,
            SubscriptionTier = tenant.SubscriptionTier,
            LogoUrl = tenant.LogoUrl,
            PrimaryColor = tenant.PrimaryColor,
            IsActive = tenant.IsActive
        };
        _modalError = null;
        _showEditModal = true;
    }

    private void CloseEditModal()
    {
        _showEditModal = false;
        _editingTenant = null;
        _modalError = null;
    }

    private async Task UpdateTenant()
    {
        if (_editingTenant is null) return;

        _modalError = null;
        _saving = true;

        var dto = new UpdateTenantDto
        {
            Name = _editModel.Name,
            SubscriptionTier = _editModel.SubscriptionTier,
            LogoUrl = _editModel.LogoUrl,
            PrimaryColor = _editModel.PrimaryColor,
            IsActive = _editModel.IsActive
        };

        var (success, error) = await Api.UpdateTenantAsync(_editingTenant.Id, dto);
        _saving = false;

        if (success)
        {
            Snackbar.Success("Tenant updated successfully");
            CloseEditModal();
            await LoadTenants();
        }
        else
        {
            _modalError = error;
        }
    }

    // Deactivate Modal
    private void OpenDeactivateModal(TenantDto tenant)
    {
        _tenantToDeactivate = tenant;
        _showDeactivateModal = true;
    }

    private void CloseDeactivateModal()
    {
        _showDeactivateModal = false;
        _tenantToDeactivate = null;
    }

    private async Task DeactivateTenant()
    {
        if (_tenantToDeactivate is null) return;

        _deactivating = true;
        var success = await Api.DeactivateTenantAsync(_tenantToDeactivate.Id);
        _deactivating = false;

        if (success)
        {
            Snackbar.Success("Tenant deactivated successfully");
            CloseDeactivateModal();
            await LoadTenants();
        }
        else
        {
            Snackbar.Error("Failed to deactivate tenant");
        }
    }


    private static string GetTierBadgeVariant(string tier) => tier switch
    {
        "Enterprise" => "accent",
        "Pro" => "info",
        _ => "secondary"
    };

    private class CreateTenantModel
    {
        public string Name { get; set; } = "";
        public string Slug { get; set; } = "";
        public string SubscriptionTier { get; set; } = "Free";
        public string AdminEmail { get; set; } = "";
        public string AdminPassword { get; set; } = "";
        public string AdminFullName { get; set; } = "";
    }

    private class EditTenantModel
    {
        public string? Name { get; set; }
        public string? SubscriptionTier { get; set; }
        public string? LogoUrl { get; set; }
        public string? PrimaryColor { get; set; }
        public bool IsActive { get; set; }
    }
}
