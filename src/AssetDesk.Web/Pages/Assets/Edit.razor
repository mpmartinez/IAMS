@page "/assets/new"
@page "/assets/{Id:int}/edit"
@using System.Globalization
@using AssetDesk.Shared
@using AssetDesk.Web.Components.UI
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Navigation
@inject AppleDeviceLookupService AppleLookup
@inject IJSRuntime JS
@inject SnackbarService Snackbar

<PageTitle>@(IsNew ? "Add Asset" : "Edit Asset") - AssetDesk</PageTitle>

<PermissionView Permission="@(IsNew ? "iams:assets:create" : "iams:assets:edit")" ShowDeniedMessage="true">
<div class="max-w-3xl mx-auto space-y-4 sm:space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3 sm:gap-4">
        <a href="@(IsNew ? "/assets" : $"/assets/{Id}")" class="p-2 rounded-lg text-muted-foreground hover:text-muted-foreground hover:bg-muted transition-all duration-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </a>
        <h1 class="text-xl sm:text-2xl font-bold text-foreground">@(IsNew ? "Add Asset" : "Edit Asset")</h1>
    </div>

    @if (_loading)
    {
        <Card Class="p-6">
            <div class="space-y-4">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="h-12 rounded-xl skeleton"></div>
                }
            </div>
        </Card>
    }
    else
    {
        <EditForm id="asset-form" Model="@_model" OnValidSubmit="HandleSubmit">
            <!-- Device Information -->
            <Card>
                <CardHeader>
                    <CardTitle>Device Information</CardTitle>
                </CardHeader>
                <CardContent>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                    <div class="sm:col-span-2">
                        <FormField LabelText="Device Type *">
                            <Select @bind-Value="_model.DeviceType" Placeholder="Select device type">
                                @if (_deviceTypes is not null)
                                {
                                    @foreach (var dt in _deviceTypes)
                                    {
                                        <option value="@dt">@dt</option>
                                    }
                                }
                            </Select>
                        </FormField>
                    </div>
                    <FormField LabelText="Serial Number">
                        <div class="relative">
                            <Input Value="@_model.SerialNumber"
                                   ValueChanged="OnSerialNumberChanged"
                                   Placeholder="C02X1234ABCD"
                                   Class="@(_appleDeviceInfo is not null ? "pr-10" : "")" />
                            @if (_appleDeviceInfo is not null)
                            {
                                <div class="absolute right-3 top-1/2 -translate-y-1/2">
                                    <svg class="w-5 h-5 text-muted-foreground" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                                    </svg>
                                </div>
                            }
                        </div>
                    </FormField>
                    <FormField LabelText="Manufacturer">
                        <Input @bind-Value="_model.Manufacturer" Placeholder="Apple, Dell, HP..." />
                    </FormField>
                    <FormField LabelText="Model">
                        <Input @bind-Value="_model.Model" Placeholder="MacBook Pro 16&quot;, XPS 15..." />
                    </FormField>
                    <FormField LabelText="Model Year">
                        <Input Type="number" @bind-Value="_model.ModelYear" Placeholder="2024" />
                    </FormField>
                    <FormField LabelText="Location">
                        <Input @bind-Value="_model.Location" Placeholder="Office - Floor 2" />
                    </FormField>
                    <FormField LabelText="Name (Optional)">
                        <Input @bind-Value="_model.Name" Placeholder="Custom display name" />
                    </FormField>
                </div>
                </CardContent>
            </Card>

            <!-- Apple Auto-fill Suggestion -->
            @if (_appleDeviceInfo is not null && _showAutoFillSuggestion)
            {
                <div class="bg-muted/50 rounded-2xl border border-border p-4 animate-slide-up">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-xl bg-background flex items-center justify-center shadow-sm shrink-0">
                            <svg class="w-6 h-6 text-muted-foreground" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <h4 class="text-sm font-semibold text-foreground">Apple Device Detected</h4>
                                @if (_appleDeviceInfo.IsPartialMatch)
                                {
                                    <span class="px-1.5 py-0.5 text-[10px] font-medium bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 rounded">Partial</span>
                                }
                            </div>
                            <div class="text-sm text-muted-foreground space-y-0.5">
                                @if (_appleDeviceInfo.Model is not null)
                                {
                                    <p><span class="text-muted-foreground">Model:</span> @_appleDeviceInfo.Model</p>
                                }
                                @if (_appleDeviceInfo.Year.HasValue)
                                {
                                    <p><span class="text-muted-foreground">Year:</span> @_appleDeviceInfo.Year</p>
                                }
                                @if (_appleDeviceInfo.DeviceType is not null)
                                {
                                    <p><span class="text-muted-foreground">Type:</span> @_appleDeviceInfo.DeviceType</p>
                                }
                            </div>
                            <div class="flex items-center gap-2 mt-3">
                                <Button Size="sm" OnClick="ApplyAutoFill">Apply</Button>
                                <Button Variant="ghost" Size="sm" Class="text-muted-foreground" OnClick="DismissAutoFill">Dismiss</Button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Status & Assignment -->
            <Card>
                <CardHeader>
                    <CardTitle>Status & Assignment</CardTitle>
                </CardHeader>
                <CardContent>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                    <FormField LabelText="Status *">
                        <Select @bind-Value="_model.Status" Placeholder="Select status">
                            @if (_statuses is not null)
                            {
                                @foreach (var stat in _statuses)
                                {
                                    <option value="@stat">@stat</option>
                                }
                            }
                        </Select>
                    </FormField>
                    <FormField LabelText="Assigned To">
                        <Select @bind-Value="_model.AssignedToUserId" Placeholder="Unassigned">
                            @if (_users is not null)
                            {
                                @foreach (var user in _users)
                                {
                                    <option value="@user.Id">@user.FullName @(user.Department is not null ? $"({user.Department})" : "")</option>
                                }
                            }
                        </Select>
                    </FormField>
                </div>
                </CardContent>
            </Card>

            <!-- Purchase Information -->
            <Card>
                <CardHeader>
                    <CardTitle>Purchase Information</CardTitle>
                </CardHeader>
                <CardContent>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                    <FormField LabelText="@($"Purchase Price ({CurrencyFormat.SymbolFor(_model.Currency)})")">
                        <Input Type="number" @bind-Value="_model.PurchasePrice" Placeholder="129900.00" />
                    </FormField>
                    <FormField LabelText="Currency">
                        <Select @bind-Value="_model.Currency" @bind-Value:after="OnCurrencyChanged">
                            @foreach (var currencyCode in _currencies)
                            {
                                <option value="@currencyCode">@currencyCode</option>
                            }
                        </Select>
                    </FormField>
                    @if (_model.Currency != CurrencyFormat.Php)
                    {
                        <FormField LabelText="@($"Exchange Rate ({CurrencyFormat.SymbolFor(CurrencyFormat.Php)} per 1 {_model.Currency})")">
                            <Input Type="number" @bind-Value="_model.ExchangeRate" Placeholder="58.20" />
                        </FormField>
                    }
                    <FormField LabelText="Purchase Date">
                        <Input Type="date" @bind-Value="_model.PurchaseDate" />
                    </FormField>
                </div>
                </CardContent>
            </Card>

            <!-- Warranty Information -->
            <Card>
                <CardHeader>
                    <CardTitle>Warranty Information</CardTitle>
                </CardHeader>
                <CardContent>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                    <div class="sm:col-span-2">
                        <FormField LabelText="Warranty Provider">
                            <Input @bind-Value="_model.WarrantyProvider" Placeholder="Apple Care+, Dell ProSupport..." />
                        </FormField>
                    </div>
                    <FormField LabelText="Warranty Start Date">
                        <Input Type="date" @bind-Value="_model.WarrantyStartDate" />
                    </FormField>
                    <FormField LabelText="Warranty End Date">
                        <Input Type="date" @bind-Value="_model.WarrantyEndDate" />
                    </FormField>
                </div>
                </CardContent>
            </Card>

            <!-- Notes -->
            <Card>
                <CardHeader>
                    <CardTitle>Additional Notes</CardTitle>
                </CardHeader>
                <CardContent>
                <Textarea Value="@_model.Notes"
                          ValueChanged="@(v => _model.Notes = v)"
                          Rows="4"
                          Placeholder="Additional notes about this asset..."
                          Class="resize-none" />
                </CardContent>
            </Card>
        </EditForm>

        <!-- Attachments Section (only for existing assets) -->
        @if (!IsNew)
        {
            <Card>
                <div class="flex flex-row items-center justify-between space-y-0 p-6 pb-2">
                    <CardTitle>Attachments</CardTitle>
                    <Button Variant="link" Size="none" Class="text-sm" OnClick="ShowUploadModal">
                        Add File
                    </Button>
                </div>
                <CardContent>
                    @if (_attachmentsLoading)
                    {
                        <div class="space-y-3">
                            @for (int i = 0; i < 2; i++)
                            {
                                <div class="flex items-center gap-3 p-3">
                                    <div class="w-12 h-12 rounded-lg skeleton"></div>
                                    <div class="flex-1 space-y-1">
                                        <div class="h-3 w-1/2 rounded skeleton"></div>
                                        <div class="h-2 w-1/3 rounded skeleton"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (_attachments is null || _attachments.Count == 0)
                    {
                        <EmptyState Title="No attachments" Description="Upload receipts, photos, or documents for this asset.">
                            <Button OnClick="ShowUploadModal">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                </svg>
                                Upload File
                            </Button>
                        </EmptyState>
                    }
                    else
                    {
                        <div class="divide-y divide-border -mx-6 -mb-6">
                            @foreach (var attachment in _attachments)
                            {
                                <div class="flex items-center gap-3 px-6 py-4 hover:bg-muted/50 transition-colors">
                                    <!-- Thumbnail/Icon -->
                                    @if (attachment.IsImage && _attachmentThumbnails.TryGetValue(attachment.Id, out var thumbnailUrl))
                                    {
                                        <img src="@thumbnailUrl"
                                             alt="@attachment.FileName"
                                             class="w-12 h-12 object-cover rounded-lg" />
                                    }
                                    else if (attachment.IsImage)
                                    {
                                        <div class="w-12 h-12 rounded-lg bg-muted flex items-center justify-center">
                                            <div class="w-5 h-5 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-lg bg-muted flex items-center justify-center">
                                            <svg class="w-6 h-6 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                            </svg>
                                        </div>
                                    }

                                    <!-- Info -->
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-foreground truncate">@attachment.FileName</p>
                                        <p class="text-xs text-muted-foreground">
                                            @attachment.Category &bull; @attachment.FileSizeDisplay &bull; @attachment.CreatedAt.ToString("MMM dd, yyyy")
                                        </p>
                                    </div>

                                    <!-- Actions -->
                                    <div class="flex items-center gap-1">
                                        <Button Variant="ghost" Size="icon-sm" Title="Download" Class="text-muted-foreground" OnClick="() => DownloadAttachment(attachment)">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                            </svg>
                                        </Button>
                                        <Button Variant="ghost" Size="icon-sm" Title="Delete" Class="text-destructive hover:bg-destructive/10 hover:text-destructive" OnClick="() => ConfirmDeleteAttachment(attachment)">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </Button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </CardContent>
            </Card>

            <!-- Upload Modal -->
            <Modal IsOpen="@_showUploadModal" Title="Upload Attachment" OnClose="HideUploadModal">
                <ChildContent>
                    <div class="space-y-4">
                        <FileUpload Label="File"
                                    OnFileChanged="OnUploadFileSelected"
                                    EnableCameraCapture="true"
                                    Error="@_uploadFileError" />

                        <FormField LabelText="Category *">
                            <Select @bind-Value="_uploadCategory" Placeholder="Select category">
                                @if (_categories is not null)
                                {
                                    @foreach (var cat in _categories)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                }
                            </Select>
                        </FormField>

                        <FormField LabelText="Description (Optional)">
                            <Textarea Value="@_uploadDescription"
                                      ValueChanged="@(v => _uploadDescription = v ?? "")"
                                      Rows="2"
                                      Placeholder="Brief description of this file..."
                                      Class="resize-none" />
                        </FormField>

                        @if (!string.IsNullOrEmpty(_uploadError))
                        {
                            <p class="text-sm text-red-600 dark:text-red-400">@_uploadError</p>
                        }
                    </div>
                </ChildContent>
                <FooterContent>
                    <Button Variant="ghost" OnClick="HideUploadModal">Cancel</Button>
                    <Button OnClick="UploadFile" Loading="@_uploading" Disabled="@(_uploadFile is null || string.IsNullOrEmpty(_uploadCategory))">Upload</Button>
                </FooterContent>
            </Modal>

            <!-- Delete Attachment Confirmation Modal -->
            <Modal IsOpen="@_showDeleteAttachmentModal" Title="Delete Attachment" OnClose="() => _showDeleteAttachmentModal = false" Size="sm">
                <ChildContent>
                    <p class="text-muted-foreground">
                        Are you sure you want to delete <strong>@_attachmentToDelete?.FileName</strong>? This action cannot be undone.
                    </p>
                </ChildContent>
                <FooterContent>
                    <Button Variant="ghost" OnClick="() => _showDeleteAttachmentModal = false">Cancel</Button>
                    <Button Variant="destructive" OnClick="DeleteAttachment" Loading="@_deletingAttachment">Delete</Button>
                </FooterContent>
            </Modal>
        }

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 animate-slide-up">
                <p class="text-sm text-red-600 dark:text-red-400">@_error</p>
            </div>
        }

        <!-- Action Buttons -->
        <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-3 pt-2">
            <a href="@(IsNew ? "/assets" : $"/assets/{Id}")" class="w-full sm:w-auto px-6 py-2.5 rounded-xl font-medium text-muted-foreground hover:bg-muted transition-all duration-200 text-center">
                Cancel
            </a>
            <Button Type="submit" form="asset-form" Loading="@_saving" Class="w-full sm:w-auto">
                @(IsNew ? "Create Asset" : "Save Changes")
            </Button>
        </div>
    }
</div>
</PermissionView>

@code {
    private async Task OnSerialNumberChanged(string value)
    {
        _model.SerialNumber = value;
        await OnSerialNumberChangedAsync();
    }

    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private AssetModel _model = new();
    private string[]? _deviceTypes;
    private string[]? _statuses;
    private List<UserListItem>? _users;

    // Mirrors the active Currency lookup rows. Hardcoded rather than fetched because the
    // Currency lookup is locked - the set only changes when a migration activates a row.
    private static readonly string[] _currencies = [CurrencyFormat.Php, CurrencyFormat.Usd];

    // Apple auto-fill state
    private AppleDeviceInfo? _appleDeviceInfo;
    private bool _showAutoFillSuggestion;
    private string? _lastCheckedSerial;
    private System.Timers.Timer? _debounceTimer;

    // Attachment state
    private List<AttachmentDto>? _attachments;
    private bool _attachmentsLoading;
    private string[]? _categories;
    private Dictionary<int, string> _attachmentThumbnails = new();

    // Upload modal state
    private bool _showUploadModal;
    private bool _uploading;
    private IBrowserFile? _uploadFile;
    private string _uploadCategory = "";
    private string _uploadDescription = "";
    private string _uploadError = "";
    private string _uploadFileError = "";

    // Delete modal state
    private bool _showDeleteAttachmentModal;
    private bool _deletingAttachment;
    private AttachmentDto? _attachmentToDelete;

    protected override async Task OnInitializedAsync()
    {
        _deviceTypes = await Api.GetDeviceTypesAsync();
        _statuses = await Api.GetStatusesAsync();
        // GetUserListAsync hits an endpoint gated on iams:users:read, a different permission from
        // this page's create/edit gate. A role holding only asset create/edit would otherwise 403
        // here; fail soft and leave the "Assigned To" list empty rather than throwing an
        // unhandled error over an otherwise-usable form.
        try
        {
            _users = await Api.GetUserListAsync();
        }
        catch
        {
            _users = null;
        }

        if (!IsNew)
        {
            var asset = await Api.GetAssetAsync(Id!.Value);
            if (asset is not null)
            {
                _model = new AssetModel
                {
                    DeviceType = asset.DeviceType,
                    Manufacturer = asset.Manufacturer ?? "",
                    Model = asset.Model ?? "",
                    ModelYear = asset.ModelYear?.ToString() ?? "",
                    SerialNumber = asset.SerialNumber ?? "",
                    Name = asset.Name ?? "",
                    Location = asset.Location ?? "",
                    Status = asset.Status,
                    AssignedToUserId = asset.AssignedToUserId ?? "",
                    // InvariantCulture, not the ambient one: these two feed an
                    // <input type="number">, whose DOM value is always invariant-formatted.
                    // Under de-DE, 58.20m formats as "58,20" and the input renders empty.
                    PurchasePrice = asset.PurchasePrice?.ToString(CultureInfo.InvariantCulture) ?? "",
                    Currency = asset.Currency,
                    ExchangeRate = asset.ExchangeRate.ToString(CultureInfo.InvariantCulture),
                    PurchaseDate = asset.PurchaseDate?.ToString("yyyy-MM-dd") ?? "",
                    WarrantyProvider = asset.WarrantyProvider ?? "",
                    WarrantyStartDate = asset.WarrantyStartDate?.ToString("yyyy-MM-dd") ?? "",
                    WarrantyEndDate = asset.WarrantyEndDate?.ToString("yyyy-MM-dd") ?? "",
                    Notes = asset.Notes ?? ""
                };
            }
        }
        else
        {
            _model.Status = "Available";
        }

        _loading = false;

        // Load attachments for edit mode
        if (!IsNew)
        {
            _ = LoadAttachments();
        }
    }

    private async Task LoadAttachments()
    {
        _attachmentsLoading = true;
        _categories ??= await Api.GetAttachmentCategoriesAsync();
        _attachments = await Api.GetAttachmentsAsync(Id!.Value);
        _attachmentsLoading = false;
        StateHasChanged();

        // Load thumbnails for images in background
        if (_attachments is not null)
        {
            foreach (var attachment in _attachments.Where(a => a.IsImage))
            {
                _ = LoadAttachmentThumbnail(attachment);
            }
        }
    }

    private async Task LoadAttachmentThumbnail(AttachmentDto attachment)
    {
        var dataUrl = await Api.GetAttachmentBase64Async(Id!.Value, attachment.Id, attachment.ContentType);
        if (dataUrl is not null)
        {
            _attachmentThumbnails[attachment.Id] = dataUrl;
            StateHasChanged();
        }
    }

    private async Task DownloadAttachment(AttachmentDto attachment)
    {
        // Use cached version if available, otherwise fetch
        if (!_attachmentThumbnails.TryGetValue(attachment.Id, out var dataUrl))
        {
            dataUrl = await Api.GetAttachmentBase64Async(Id!.Value, attachment.Id, attachment.ContentType);
        }

        if (dataUrl is not null)
        {
            await JS.InvokeVoidAsync("downloadFile", dataUrl, attachment.FileName);
        }
    }

    private void ShowUploadModal()
    {
        _uploadFile = null;
        _uploadCategory = "";
        _uploadDescription = "";
        _uploadError = "";
        _uploadFileError = "";
        _showUploadModal = true;
    }

    private void HideUploadModal() => _showUploadModal = false;

    private void OnUploadFileSelected(IBrowserFile? file)
    {
        _uploadFile = file;
        _uploadFileError = "";

        if (file is not null && file.Size > 5 * 1024 * 1024)
        {
            _uploadFileError = "File size exceeds 5 MB limit";
            _uploadFile = null;
        }
    }

    private async Task UploadFile()
    {
        if (_uploadFile is null || string.IsNullOrEmpty(_uploadCategory))
            return;

        _uploading = true;
        _uploadError = "";

        try
        {
            await using var stream = _uploadFile.OpenReadStream(5 * 1024 * 1024);
            var (success, _, error) = await Api.UploadAttachmentAsync(
                Id!.Value,
                stream,
                _uploadFile.Name,
                _uploadFile.ContentType,
                _uploadCategory,
                string.IsNullOrWhiteSpace(_uploadDescription) ? null : _uploadDescription);

            if (success)
            {
                _showUploadModal = false;
                Snackbar.Success("File uploaded successfully");
                await LoadAttachments();
            }
            else
            {
                _uploadError = error ?? "Failed to upload file";
                Snackbar.Error(_uploadError);
            }
        }
        catch (Exception ex)
        {
            _uploadError = ex.Message;
            Snackbar.Error(_uploadError);
        }

        _uploading = false;
    }

    private void ConfirmDeleteAttachment(AttachmentDto attachment)
    {
        _attachmentToDelete = attachment;
        _showDeleteAttachmentModal = true;
    }

    private async Task DeleteAttachment()
    {
        if (_attachmentToDelete is null)
            return;

        _deletingAttachment = true;

        var success = await Api.DeleteAttachmentAsync(Id!.Value, _attachmentToDelete.Id);

        if (success)
        {
            _showDeleteAttachmentModal = false;
            Snackbar.Success("Attachment deleted");
            await LoadAttachments();
        }
        else
        {
            Snackbar.Error("Failed to delete attachment");
        }

        _deletingAttachment = false;
    }

    private async Task HandleSubmit()
    {
        _error = null;
        _saving = true;

        if (string.IsNullOrWhiteSpace(_model.DeviceType) || string.IsNullOrWhiteSpace(_model.Status))
        {
            _error = "Please fill in all required fields (Device Type and Status).";
            _saving = false;
            return;
        }

        bool success;
        string? error;

        if (IsNew)
        {
            var dto = new CreateAssetDto
            {
                DeviceType = _model.DeviceType,
                Manufacturer = NullIfEmpty(_model.Manufacturer),
                Model = NullIfEmpty(_model.Model),
                ModelYear = int.TryParse(_model.ModelYear, out var year) ? year : null,
                SerialNumber = NullIfEmpty(_model.SerialNumber),
                Name = NullIfEmpty(_model.Name),
                Location = NullIfEmpty(_model.Location),
                Status = _model.Status,
                AssignedToUserId = NullIfEmpty(_model.AssignedToUserId),
                PurchasePrice = ParseDecimal(_model.PurchasePrice),
                Currency = _model.Currency,
                ExchangeRate = ParseDecimal(_model.ExchangeRate) ?? 1m,
                PurchaseDate = DateTime.TryParse(_model.PurchaseDate, out var pdate) ? pdate : null,
                WarrantyProvider = NullIfEmpty(_model.WarrantyProvider),
                WarrantyStartDate = DateTime.TryParse(_model.WarrantyStartDate, out var wsdate) ? wsdate : null,
                WarrantyEndDate = DateTime.TryParse(_model.WarrantyEndDate, out var wedate) ? wedate : null,
                Notes = NullIfEmpty(_model.Notes)
            };
            (success, error) = await Api.CreateAssetAsync(dto);
        }
        else
        {
            var dto = new UpdateAssetDto
            {
                DeviceType = _model.DeviceType,
                Manufacturer = NullIfEmpty(_model.Manufacturer),
                Model = NullIfEmpty(_model.Model),
                ModelYear = int.TryParse(_model.ModelYear, out var year) ? year : null,
                SerialNumber = NullIfEmpty(_model.SerialNumber),
                Name = NullIfEmpty(_model.Name),
                Location = NullIfEmpty(_model.Location),
                Status = _model.Status,
                AssignedToUserId = _model.AssignedToUserId ?? "",
                PurchasePrice = ParseDecimal(_model.PurchasePrice),
                Currency = _model.Currency,
                ExchangeRate = ParseDecimal(_model.ExchangeRate),
                PurchaseDate = DateTime.TryParse(_model.PurchaseDate, out var pdate) ? pdate : null,
                WarrantyProvider = NullIfEmpty(_model.WarrantyProvider),
                WarrantyStartDate = DateTime.TryParse(_model.WarrantyStartDate, out var wsdate) ? wsdate : null,
                WarrantyEndDate = DateTime.TryParse(_model.WarrantyEndDate, out var wedate) ? wedate : null,
                Notes = NullIfEmpty(_model.Notes)
            };
            (success, error) = await Api.UpdateAssetAsync(Id!.Value, dto);
        }

        _saving = false;

        if (success)
        {
            Snackbar.Success(IsNew ? "Asset created successfully" : "Asset updated successfully");
            Navigation.NavigateTo("/assets");
        }
        else
        {
            _error = error;
            Snackbar.Error(error ?? "Failed to save asset");
        }
    }

    /// <summary>
    /// Reads a value that came out of an &lt;input type="number"&gt;. Such a DOM value is ALWAYS
    /// invariant-formatted whatever the browser locale, so parsing it under CurrentCulture is
    /// wrong in both directions: a de-DE reader takes the "." in "58.2" for a group separator
    /// and returns 582 - ten times the rate, which CurrencyRules.Validate happily accepts
    /// because it is not 1, silently inflating every peso total for that asset tenfold.
    /// </summary>
    private static decimal? ParseDecimal(string? value) =>
        decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private void OnCurrencyChanged()
    {
        if (_model.Currency == CurrencyFormat.Php)
            _model.ExchangeRate = "1";
    }

    private async Task OnSerialNumberChangedAsync()
    {
        var serial = _model.SerialNumber;

        // Debounce the lookup to avoid excessive calls while typing
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Timers.Timer(300);
        _debounceTimer.Elapsed += async (s, args) =>
        {
            _debounceTimer?.Stop();
            await InvokeAsync(() => CheckAppleSerial(serial));
        };
        _debounceTimer.AutoReset = false;
        _debounceTimer.Start();

        await Task.CompletedTask;
    }

    private void CheckAppleSerial(string? serial)
    {
        if (serial == _lastCheckedSerial)
            return;

        _lastCheckedSerial = serial;

        // Clear previous suggestion if serial is too short
        if (string.IsNullOrWhiteSpace(serial) || serial.Length < 11)
        {
            _appleDeviceInfo = null;
            _showAutoFillSuggestion = false;
            StateHasChanged();
            return;
        }

        // Look up device
        var deviceInfo = AppleLookup.LookupDevice(serial);

        if (deviceInfo?.IsAppleDevice == true)
        {
            _appleDeviceInfo = deviceInfo;
            // Only show suggestion if we have useful info to fill
            _showAutoFillSuggestion = deviceInfo.Model is not null || deviceInfo.Year.HasValue || deviceInfo.DeviceType is not null;
        }
        else
        {
            _appleDeviceInfo = null;
            _showAutoFillSuggestion = false;
        }

        StateHasChanged();
    }

    private void ApplyAutoFill()
    {
        if (_appleDeviceInfo is null)
            return;

        // Apply manufacturer (always Apple for Apple devices)
        _model.Manufacturer = _appleDeviceInfo.Manufacturer;

        // Apply model if available
        if (!string.IsNullOrEmpty(_appleDeviceInfo.Model))
            _model.Model = _appleDeviceInfo.Model;

        // Apply year if available
        if (_appleDeviceInfo.Year.HasValue)
            _model.ModelYear = _appleDeviceInfo.Year.Value.ToString();

        // Apply device type if available and currently empty
        if (!string.IsNullOrEmpty(_appleDeviceInfo.DeviceType) && string.IsNullOrEmpty(_model.DeviceType))
            _model.DeviceType = _appleDeviceInfo.DeviceType;

        // Hide the suggestion after applying
        _showAutoFillSuggestion = false;
    }

    private void DismissAutoFill()
    {
        _showAutoFillSuggestion = false;
    }

    public void Dispose()
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();
    }

