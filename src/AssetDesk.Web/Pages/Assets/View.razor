@page "/assets/{Id:int}"
@using AssetDesk.Shared
@using AssetDesk.Web.Components.UI
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SnackbarService Snackbar
@inject PermissionChecker PermissionChecker

<PageTitle>@(_asset?.DisplayName ?? "Asset") - AssetDesk</PageTitle>

<PermissionView Permission="iams:assets:view" ShowDeniedMessage="true">
@if (_loading)
{
    <div class="space-y-6 animate-pulse">
        <div class="flex items-center gap-4">
            <div class="w-8 h-8 rounded-lg skeleton"></div>
            <div class="h-8 w-48 rounded skeleton"></div>
        </div>
        <div class="bg-card rounded-2xl border border-border p-6">
            <div class="space-y-4">
                <div class="h-6 w-1/3 rounded skeleton"></div>
                <div class="h-4 w-1/2 rounded skeleton"></div>
                <div class="h-4 w-2/3 rounded skeleton"></div>
            </div>
        </div>
    </div>
}
else if (_asset is null)
{
    <Card Class="p-6">
        <EmptyState Title="Asset not found" Description="The asset you're looking for doesn't exist or has been deleted.">
            <a href="/assets" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-xl font-medium hover:bg-primary/90 transition-all duration-200">
                Back to Assets
            </a>
        </EmptyState>
    </Card>
}
else
{
    <div class="space-y-4 sm:space-y-6">
        <!-- Header -->
        <div class="flex flex-col gap-4">
            <div class="flex items-center gap-2 sm:gap-4">
                <a href="/assets" class="p-2 rounded-lg text-muted-foreground hover:text-muted-foreground hover:bg-muted transition-all duration-200">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3 flex-wrap">
                        <h1 class="text-xl sm:text-2xl font-bold text-foreground truncate">@_asset.DisplayName</h1>
                        <Badge Variant="@_asset.Status" Pulse="@(_asset.Status == "InUse")">@_asset.Status</Badge>
                    </div>
                    <p class="text-sm text-muted-foreground mt-1 font-mono">@_asset.AssetTag</p>
                </div>
            </div>
            <div class="flex items-center gap-2 sm:gap-3">
                <PermissionView Permission="iams:assets:edit">
                    <a href="/assets/@Id/edit" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-card border border-border rounded-xl font-medium text-foreground hover:bg-muted transition-all duration-200 text-sm">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        Edit
                    </a>
                </PermissionView>
                <PermissionView Permission="iams:assets:delete">
                    <Button Variant="outline"
                            Class="flex-1 sm:flex-none border-destructive/30 text-destructive hover:bg-destructive/10 hover:text-destructive"
                            OnClick="() => _showDeleteModal = true">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Delete
                    </Button>
                </PermissionView>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
            <!-- Main Info -->
            <div class="lg:col-span-2 space-y-4 sm:space-y-6">
                <!-- Device Info -->
                <Card>
                    <CardHeader>
                        <CardTitle>Device Information</CardTitle>
                    </CardHeader>
                    <CardContent>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                            <DetailItem Label="Device Type" Value="@_asset.DeviceType" />
                            <DetailItem Label="Manufacturer" Value="@(_asset.Manufacturer ?? "—")" />
                            <DetailItem Label="Model" Value="@(_asset.Model ?? "—")" />
                            <DetailItem Label="Model Year" Value="@(_asset.ModelYear?.ToString() ?? "—")" />
                            <DetailItem Label="Serial Number" Value="@(_asset.SerialNumber ?? "—")" />
                            <DetailItem Label="Location" Value="@(_asset.Location ?? "—")" />
                        </div>
                    </CardContent>
                </Card>

                <!-- Assignment -->
                <Card>
                    <div class="flex flex-row items-center justify-between space-y-0 p-6 pb-2">
                        <CardTitle>Assignment</CardTitle>
                        @if (string.IsNullOrEmpty(_asset.AssignedToUserId))
                        {
                            <PermissionView Permission="iams:assignments:assign">
                                <Button Variant="link" Size="none" Class="text-sm" OnClick="ShowAssignModal">
                                    Assign
                                </Button>
                            </PermissionView>
                        }
                        else
                        {
                            <PermissionView Permission="iams:assignments:return">
                                <Button Variant="link" Size="none" Class="text-sm text-amber-600 dark:text-amber-400" OnClick="ShowReturnModal">
                                    Return
                                </Button>
                            </PermissionView>
                        }
                    </div>
                    <CardContent>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                            <DetailItem Label="Status" Value="@_asset.Status" />
                            @if (!string.IsNullOrEmpty(_asset.AssignedToUserName))
                            {
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-1">Assigned To</p>
                                    <a href="/users/@_asset.AssignedToUserId/assets" class="text-primary hover:text-primary/90 font-medium transition-colors">
                                        @_asset.AssignedToUserName
                                    </a>
                                </div>
                            }
                            else
                            {
                                <DetailItem Label="Assigned To" Value="Unassigned" />
                            }
                        </div>
                    </CardContent>
                </Card>

                <!-- Assignment History -->
                @if (_canViewAssignmentHistory)
                {
                    <Card>
                        <div class="flex flex-row items-center justify-between space-y-0 p-6 pb-2">
                            <CardTitle>Assignment History</CardTitle>
                            @if (_assignmentHistory?.Count > 3)
                            {
                                <Button Variant="link" Size="none" Class="text-sm" OnClick="() => _showAllHistory = !_showAllHistory">
                                    @(_showAllHistory ? "Show Less" : "Show All")
                                </Button>
                            }
                        </div>
                        <CardContent>
                            @if (_assignmentHistory is null)
                            {
                                <div class="space-y-3">
                                    @for (int i = 0; i < 3; i++)
                                    {
                                        <div class="flex items-center gap-3 p-3">
                                            <div class="w-8 h-8 rounded-full skeleton"></div>
                                            <div class="flex-1 space-y-1">
                                                <div class="h-3 w-1/2 rounded skeleton"></div>
                                                <div class="h-2 w-1/3 rounded skeleton"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (_assignmentHistory.Count == 0)
                            {
                                <p class="text-sm text-muted-foreground text-center py-4">No assignment history</p>
                            }
                            else
                            {
                                <div class="space-y-0 -mx-6 -mb-6 divide-y divide-border">
                                    @foreach (var assignment in (_showAllHistory ? _assignmentHistory : _assignmentHistory.Take(3)))
                                    {
                                        <div class="px-6 py-4">
                                            <div class="flex items-start gap-3">
                                                <div class="w-8 h-8 rounded-full @(assignment.IsActive ? "bg-emerald-100 dark:bg-emerald-900/30" : "bg-muted") flex items-center justify-center shrink-0">
                                                    @if (assignment.IsActive)
                                                    {
                                                        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="w-4 h-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                        </svg>
                                                    }
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center gap-2">
                                                        <p class="text-sm font-medium text-foreground">@assignment.UserName</p>
                                                        @if (assignment.IsActive)
                                                        {
                                                            <span class="px-1.5 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 rounded">Current</span>
                                                        }
                                                    </div>
                                                    <p class="text-xs text-muted-foreground mt-0.5">
                                                        @assignment.AssignedAt.ToString("MMM dd, yyyy")
                                                        @if (assignment.ReturnedAt.HasValue)
                                                        {
                                                            <span> — @assignment.ReturnedAt.Value.ToString("MMM dd, yyyy")</span>
                                                            <span class="text-muted-foreground"> (@assignment.DurationDays days)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted-foreground"> (@assignment.DurationDays days)</span>
                                                        }
                                                    </p>
                                                    @if (assignment.ReturnCondition is not null && assignment.ReturnCondition != "Good")
                                                    {
                                                        <p class="text-xs text-amber-600 dark:text-amber-400 mt-1">Returned: @assignment.ReturnCondition</p>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </CardContent>
                    </Card>
                }

                <!-- Purchase & Warranty -->
                <Card>
                    <div class="flex flex-row items-center justify-between space-y-0 p-6 pb-2">
                        <CardTitle>Purchase & Warranty</CardTitle>
                        @if (_asset.WarrantyStatus != WarrantyStatus.None)
                        {
                            <Badge Variant="@GetWarrantyBadgeVariant()" Pulse="@(_asset.WarrantyStatus == WarrantyStatus.Expiring)">@GetWarrantyBadgeText()</Badge>
                        }
                    </div>
                    <CardContent>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                            <DetailItem Label="Purchase Price" Value="@FormatPrice(_asset.PurchasePrice, _asset.Currency)" />
                            <DetailItem Label="Purchase Date" Value="@(_asset.PurchaseDate?.ToString("MMM dd, yyyy") ?? "—")" />
                            @* Shown as soon as the report has answered, row or no row: an asset the
                               report excludes still deserves to be told why, rather than having the
                               line silently vanish. Omitted only while loading, or for a user
                               without the reports permission, where no call is made at all. *@
                            @if (_depreciationLoaded)
                            {
                                <DetailItem Label="Book Value" Value="@BookValueDisplay()" />
                            }
                            <DetailItem Label="Warranty Provider" Value="@(_asset.WarrantyProvider ?? "—")" />
                            <div>
                                <p class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-1">Warranty Period</p>
                                <p class="text-foreground">@GetWarrantyPeriod()</p>
                                @if (_asset.WarrantyDaysRemaining.HasValue)
                                {
                                    <p class="text-xs mt-1 @GetWarrantyDaysClass()">
                                        @if (_asset.WarrantyDaysRemaining.Value < 0)
                                        {
                                            <span>Expired @Math.Abs(_asset.WarrantyDaysRemaining.Value) days ago</span>
                                        }
                                        else if (_asset.WarrantyDaysRemaining.Value == 0)
                                        {
                                            <span>Expires today</span>
                                        }
                                        else
                                        {
                                            <span>@_asset.WarrantyDaysRemaining.Value days remaining</span>
                                        }
                                    </p>
                                }
                            </div>
                        </div>
                    </CardContent>
                </Card>

                @if (!string.IsNullOrEmpty(_asset.PurchaseOrderReference))
                {
                    <Card>
                        <CardHeader>
                            <CardTitle>Procurement</CardTitle>
                        </CardHeader>
                        <CardContent>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                                <DetailItem Label="Supplier" Value="@(_asset.SupplierName ?? "—")" />
                                @* Not a link to /purchase-orders/{id}: AssetDto carries only the
                                   formatted reference (e.g. "PO-0042"), not the order's numeric
                                   id the route needs, and adding that id was not part of this
                                   change - see the task report. *@
                                <DetailItem Label="Purchase Order" Value="@_asset.PurchaseOrderReference" />
                            </div>
                        </CardContent>
                    </Card>
                }

                @if (_deviceLicences.Count > 0)
                {
                    <Card>
                        <CardHeader>
                            <CardTitle>Licences on this device</CardTitle>
                        </CardHeader>
                        <CardContent>
                            <div class="space-y-2">
                                @foreach (var licence in _deviceLicences)
                                {
                                    <div class="flex items-center justify-between gap-3 text-sm" @key="licence.LicenceId">
                                        <a href="/licences/@licence.LicenceId" class="font-medium text-foreground hover:underline">@licence.Name</a>
                                        <Badge Variant="@LicenceDisplay.RenewalVariant(licence.RenewalStatus)">@licence.RenewalStatus</Badge>
                                    </div>
                                }
                            </div>
                        </CardContent>
                    </Card>
                }

                @if (!string.IsNullOrEmpty(_asset.Notes))
                {
                    <Card>
                        <CardHeader>
                            <CardTitle>Notes</CardTitle>
                        </CardHeader>
                        <CardContent>
                            <p class="text-muted-foreground whitespace-pre-wrap text-sm">@_asset.Notes</p>
                        </CardContent>
                    </Card>
                }

                <!-- Attachments -->
                <Card>
                    <div class="flex flex-row items-center justify-between space-y-0 p-6 pb-2">
                        <CardTitle>Attachments</CardTitle>
                        <PermissionView Permission="iams:assets:edit">
                            <a href="/assets/@Id/edit" class="text-sm text-primary hover:text-primary/90 font-medium transition-colors">
                                Manage
                            </a>
                        </PermissionView>
                    </div>
                    <CardContent>
                        @if (_attachmentsLoading)
                        {
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                                @for (int i = 0; i < 3; i++)
                                {
                                    <div class="aspect-square rounded-xl skeleton"></div>
                                }
                            </div>
                        }
                        else if (_attachments is null || _attachments.Count == 0)
                        {
                            <p class="text-sm text-muted-foreground text-center py-4">No attachments</p>
                        }
                        else
                        {
                            <!-- Group by category -->
                            @foreach (var group in _attachments.GroupBy(a => a.Category))
                            {
                                <div class="mb-4 last:mb-0">
                                    <h4 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">@group.Key</h4>
                                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                                        @foreach (var attachment in group)
                                        {
                                            <a @onclick="() => ViewAttachment(attachment)" @onclick:preventDefault
                                               class="group relative aspect-square rounded-xl bg-muted overflow-hidden cursor-pointer">
                                                @if (attachment.IsImage && _attachmentThumbnails.TryGetValue(attachment.Id, out var thumbnailUrl))
                                                {
                                                    <img src="@thumbnailUrl"
                                                         alt="@attachment.FileName"
                                                         class="w-full h-full object-cover" />
                                                }
                                                else if (attachment.IsImage)
                                                {
                                                    <div class="w-full h-full flex items-center justify-center">
                                                        <div class="w-6 h-6 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full flex flex-col items-center justify-center p-2">
                                                        <svg class="w-10 h-10 text-muted-foreground mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                                        </svg>
                                                        <p class="text-xs text-muted-foreground truncate w-full text-center">@attachment.FileName</p>
                                                    </div>
                                                }
                                                <!-- Overlay on hover -->
                                                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                                    <span class="text-white text-sm font-medium">View</span>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </CardContent>
                </Card>
            </div>

            <!-- Sidebar -->
            <div class="space-y-4 sm:space-y-6">
                <Card>
                    <CardHeader>
                        <CardTitle>Quick Actions</CardTitle>
                    </CardHeader>
                    <CardContent>
                        <div class="space-y-2">
                            <!-- TransferAsset() calls Return then Assign in sequence, so the button needs both
                                 permissions - nested PermissionViews, same as elsewhere in this file, so it only
                                 renders when the user holds both. -->
                            <PermissionView Permission="iams:assignments:assign">
                                <PermissionView Permission="iams:assignments:return">
                                    <Button Variant="ghost" Size="none" Class="@QuickActionClasses" OnClick="ShowTransferModal">
                                        <svg class="w-5 h-5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                                        </svg>
                                        Transfer Asset
                                    </Button>
                                </PermissionView>
                            </PermissionView>
                            <Button Variant="ghost" Size="none" Class="@QuickActionClasses" OnClick="ShowReportModal">
                                <svg class="w-5 h-5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                Generate Report
                            </Button>
                            <Button Variant="ghost" Size="none" Class="@QuickActionClasses" OnClick="PrintLabel">
                                <svg class="w-5 h-5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                                </svg>
                                Print Label
                            </Button>
                        </div>
                    </CardContent>
                </Card>

                <Card>
                    <CardHeader>
                        <CardTitle>Metadata</CardTitle>
                    </CardHeader>
                    <CardContent>
                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Created</span>
                            <span class="text-foreground">@_asset.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        @if (_asset.UpdatedAt.HasValue)
                        {
                            <div class="flex justify-between">
                                <span class="text-muted-foreground">Updated</span>
                                <span class="text-foreground">@_asset.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                            </div>
                        }
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">Asset ID</span>
                            <span class="text-foreground font-mono text-xs">@_asset.Id</span>
                        </div>
                    </div>
                    </CardContent>
                </Card>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <Modal IsOpen="@_showDeleteModal" Title="Delete Asset" OnClose="() => _showDeleteModal = false">
        <ChildContent>
            <p class="text-muted-foreground">
                Are you sure you want to delete <strong>@_asset.DisplayName</strong>? This action cannot be undone.
            </p>
        </ChildContent>
        <FooterContent>
            <Button Variant="ghost" OnClick="() => _showDeleteModal = false">Cancel</Button>
            <Button Variant="destructive" OnClick="DeleteAsset" Loading="@_deleting">Delete</Button>
        </FooterContent>
    </Modal>

    <!-- Assign Modal -->
    <Modal IsOpen="@_showAssignModal" Title="Assign Asset" OnClose="HideAssignModal">
        <ChildContent>
            <div class="space-y-4">
                <FormField LabelText="Assign to">
                    <Select Value="@_assignUserId" ValueChanged="@(v => _assignUserId = v ?? "")">
                        <option value="">Select a user...</option>
                        @if (_users is not null)
                        {
                            @foreach (var user in _users)
                            {
                                <option value="@user.Id">@user.FullName @(user.Department is not null ? $"({user.Department})" : "")</option>
                            }
                        }
                    </Select>
                </FormField>
                <FormField LabelText="Notes (Optional)">
                    <Textarea Value="@_assignNotes"
                              ValueChanged="@(v => _assignNotes = v ?? "")"
                              Rows="2"
                              Placeholder="Assignment notes..."
                              Class="resize-none" />
                </FormField>
                @if (!string.IsNullOrEmpty(_assignError))
                {
                    <Alert Variant="destructive">@_assignError</Alert>
                }
            </div>
        </ChildContent>
        <FooterContent>
            <Button Variant="ghost" OnClick="HideAssignModal">Cancel</Button>
            <Button OnClick="AssignAsset" Loading="@_assigning" Disabled="@string.IsNullOrEmpty(_assignUserId)">Assign</Button>
        </FooterContent>
    </Modal>

    <!-- Return Modal -->
    <Modal IsOpen="@_showReturnModal" Title="Return Asset" OnClose="HideReturnModal">
        <ChildContent>
            <div class="space-y-4">
                <p class="text-muted-foreground">
                    Return <strong>@_asset.DisplayName</strong> from <strong>@_asset.AssignedToUserName</strong>?
                </p>
                <FormField LabelText="Condition">
                    <Select Value="@_returnCondition" ValueChanged="@(v => _returnCondition = v ?? "Good")">
                        <option value="Good">Good - Ready for reuse</option>
                        <option value="NeedsRepair">Needs Repair</option>
                        <option value="Damaged">Damaged</option>
                        <option value="Lost">Lost</option>
                    </Select>
                </FormField>
                <FormField LabelText="Notes (Optional)">
                    <Textarea Value="@_returnNotes"
                              ValueChanged="@(v => _returnNotes = v ?? "")"
                              Rows="2"
                              Placeholder="Return notes..."
                              Class="resize-none" />
                </FormField>
                @if (!string.IsNullOrEmpty(_returnError))
                {
                    <Alert Variant="destructive">@_returnError</Alert>
                }
            </div>
        </ChildContent>
        <FooterContent>
            <Button Variant="ghost" OnClick="HideReturnModal">Cancel</Button>
            <Button OnClick="ReturnAsset" Loading="@_returning">Return</Button>
        </FooterContent>
    </Modal>

    <!-- Transfer Modal -->
    <Modal IsOpen="@_showTransferModal" Title="Transfer Asset" OnClose="HideTransferModal">
        <ChildContent>
            <div class="space-y-4">
                @if (!string.IsNullOrEmpty(_asset.AssignedToUserName))
                {
                    <p class="text-muted-foreground">
                        Transfer <strong>@_asset.DisplayName</strong> from <strong>@_asset.AssignedToUserName</strong> to another user.
                    </p>
                }
                else
                {
                    <p class="text-muted-foreground">
                        Assign <strong>@_asset.DisplayName</strong> to a user.
                    </p>
                }
                <FormField LabelText="Transfer to">
                    <Select Value="@_transferUserId" ValueChanged="@(v => _transferUserId = v ?? "")">
                        <option value="">Select a user...</option>
                        @if (_users is not null)
                        {
                            @foreach (var user in _users.Where(u => u.Id != _asset.AssignedToUserId))
                            {
                                <option value="@user.Id">@user.FullName @(user.Department is not null ? $"({user.Department})" : "")</option>
                            }
                        }
                    </Select>
                </FormField>
                <FormField LabelText="Transfer Notes (Optional)">
                    <Textarea Value="@_transferNotes"
                              ValueChanged="@(v => _transferNotes = v ?? "")"
                              Rows="2"
                              Placeholder="Reason for transfer..."
                              Class="resize-none" />
                </FormField>
                @if (!string.IsNullOrEmpty(_transferError))
                {
                    <Alert Variant="destructive">@_transferError</Alert>
                }
            </div>
        </ChildContent>
        <FooterContent>
            <Button Variant="ghost" OnClick="HideTransferModal">Cancel</Button>
            <Button OnClick="TransferAsset" Loading="@_transferring" Disabled="@string.IsNullOrEmpty(_transferUserId)">Transfer</Button>
        </FooterContent>
    </Modal>

    <!-- Report Modal -->
    <Modal IsOpen="@_showReportModal" Title="Asset Report" OnClose="() => _showReportModal = false" Size="lg">
        <ChildContent>
            <div id="asset-report" class="bg-card p-6 space-y-6">
                <!-- Report Header -->
                <div class="border-b border-border pb-4">
                    <div class="flex justify-between items-start">
                        <div>
                            <h2 class="text-xl font-bold text-foreground">Asset Report</h2>
                            <p class="text-sm text-muted-foreground mt-1">Generated on @DateTime.Now.ToString("MMMM dd, yyyy HH:mm")</p>
                        </div>
                        <div class="text-right">
                            <p class="text-lg font-mono font-semibold text-foreground">@_asset.AssetTag</p>
                            <Badge Variant="@_asset.Status">@_asset.Status</Badge>
                        </div>
                    </div>
                </div>

                <!-- Device Information -->
                <div>
                    <h3 class="text-sm font-semibold text-foreground uppercase tracking-wider mb-3">Device Information</h3>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <span class="text-muted-foreground">Device Type:</span>
                            <span class="ml-2 text-foreground">@_asset.DeviceType</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Manufacturer:</span>
                            <span class="ml-2 text-foreground">@(_asset.Manufacturer ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Model:</span>
                            <span class="ml-2 text-foreground">@(_asset.Model ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Serial Number:</span>
                            <span class="ml-2 text-foreground font-mono">@(_asset.SerialNumber ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Location:</span>
                            <span class="ml-2 text-foreground">@(_asset.Location ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Model Year:</span>
                            <span class="ml-2 text-foreground">@(_asset.ModelYear?.ToString() ?? "—")</span>
                        </div>
                    </div>
                </div>

                <!-- Assignment Information -->
                <div>
                    <h3 class="text-sm font-semibold text-foreground uppercase tracking-wider mb-3">Assignment</h3>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <span class="text-muted-foreground">Assigned To:</span>
                            <span class="ml-2 text-foreground">@(_asset.AssignedToUserName ?? "Unassigned")</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Status:</span>
                            <span class="ml-2 text-foreground">@_asset.Status</span>
                        </div>
                    </div>
                </div>

                <!-- Purchase & Warranty -->
                <div>
                    <h3 class="text-sm font-semibold text-foreground uppercase tracking-wider mb-3">Purchase & Warranty</h3>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                            <span class="text-muted-foreground">Purchase Price:</span>
                            <span class="ml-2 text-foreground">@FormatPrice(_asset.PurchasePrice, _asset.Currency)</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Purchase Date:</span>
                            <span class="ml-2 text-foreground">@(_asset.PurchaseDate?.ToString("MMM dd, yyyy") ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Warranty Provider:</span>
                            <span class="ml-2 text-foreground">@(_asset.WarrantyProvider ?? "—")</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Warranty Period:</span>
                            <span class="ml-2 text-foreground">@GetWarrantyPeriod()</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_asset.Notes))
                {
                    <div>
                        <h3 class="text-sm font-semibold text-foreground uppercase tracking-wider mb-3">Notes</h3>
                        <p class="text-sm text-muted-foreground whitespace-pre-wrap">@_asset.Notes</p>
                    </div>
                }
            </div>
        </ChildContent>
        <FooterContent>
            <Button Variant="ghost" OnClick="() => _showReportModal = false">Close</Button>
            <Button OnClick="PrintReport">
                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Print Report
            </Button>
        </FooterContent>
    </Modal>

    <!-- Print Label Modal -->
    <Modal IsOpen="@_showLabelModal" Title="Print Asset Label" OnClose="() => _showLabelModal = false">
        <ChildContent>
            <div id="asset-label" class="bg-white p-6 flex flex-col items-center space-y-4">
                <!-- QR Code -->
                <div class="border-2 border-border rounded-lg p-4">
                    @if (_loadingQrCode)
                    {
                        <div class="w-40 h-40 flex items-center justify-center">
                            <div class="w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_qrCodeDataUrl))
                    {
                        <img src="@_qrCodeDataUrl" alt="QR Code" class="w-40 h-40" />
                    }
                    else
                    {
                        <div class="w-40 h-40 flex items-center justify-center text-muted-foreground">
                            <span class="text-sm">Failed to load QR code</span>
                        </div>
                    }
                </div>
                <!-- Asset Info -->
                <div class="text-center">
                    <p class="text-2xl font-mono font-bold text-foreground">@_asset.AssetTag</p>
                    <p class="text-sm text-muted-foreground mt-1">@_asset.DisplayName</p>
                    @if (!string.IsNullOrEmpty(_asset.SerialNumber))
                    {
                        <p class="text-xs text-muted-foreground mt-1 font-mono">S/N: @_asset.SerialNumber</p>
                    }
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <Button Variant="ghost" OnClick="() => _showLabelModal = false">Close</Button>
            <Button OnClick="PrintLabelContent" Disabled="@(_loadingQrCode || string.IsNullOrEmpty(_qrCodeDataUrl))">
                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Print Label
            </Button>
        </FooterContent>
    </Modal>

    <!-- Attachment Viewer Modal -->
    <Modal IsOpen="@_showAttachmentModal" Title="@(_viewingAttachment?.FileName ?? "Attachment")" OnClose="() => _showAttachmentModal = false" Size="lg">
        <ChildContent>
            <div class="flex flex-col items-center">
                @if (_viewingAttachmentUrl is null)
                {
                    <div class="w-full h-64 flex items-center justify-center">
                        <div class="w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                    </div>
                }
                else if (_viewingAttachment?.IsImage == true)
                {
                    <img src="@_viewingAttachmentUrl" alt="@_viewingAttachment.FileName" class="max-w-full max-h-[60vh] object-contain rounded-lg" />
                }
                else
                {
                    <div class="text-center py-8">
                        <svg class="w-16 h-16 text-muted-foreground mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                        <p class="text-muted-foreground">@_viewingAttachment?.FileName</p>
                        <p class="text-sm text-muted-foreground mt-1">@_viewingAttachment?.FileSizeDisplay</p>
                    </div>
                }
                @if (_viewingAttachment is not null)
                {
                    <div class="mt-4 text-sm text-muted-foreground text-center">
                        <p>@_viewingAttachment.Category &bull; Uploaded @_viewingAttachment.CreatedAt.ToString("MMM dd, yyyy") by @_viewingAttachment.UploadedByUserName</p>
                        @if (!string.IsNullOrEmpty(_viewingAttachment.Description))
                        {
                            <p class="mt-1 text-muted-foreground">@_viewingAttachment.Description</p>
                        }
                    </div>
                }
            </div>
        </ChildContent>
        <FooterContent>
            <Button Variant="ghost" OnClick="() => _showAttachmentModal = false">Close</Button>
            <Button OnClick="DownloadAttachment" Disabled="@(_viewingAttachmentUrl is null)">
                <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download
            </Button>
        </FooterContent>
    </Modal>
}
</PermissionView>

@code {
    // The sidebar quick actions are full-width rows, not standard buttons, so they take
    // Size="none" and bring their own box.
    private const string QuickActionClasses =
        "w-full justify-start gap-3 px-4 py-3 rounded-xl text-left text-sm";

    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private bool _deleting;
    private bool _showDeleteModal;
    private AssetDto? _asset;
    private DepreciationReportRow? _depreciation;
    private bool _depreciationLoaded;
    private List<DeviceLicenceDto> _deviceLicences = [];

    // Assignment state
    private List<AssetAssignmentDto>? _assignmentHistory;
    private bool _canViewAssignmentHistory;
    private List<UserListItem>? _users;
    private bool _showAllHistory;
    private bool _showAssignModal;
    private bool _showReturnModal;
    private bool _assigning;
    private bool _returning;
    private string _assignUserId = "";
    private string _assignNotes = "";
    private string _assignError = "";
    private string _returnCondition = "Good";
    private string _returnNotes = "";
    private string _returnError = "";

    // Transfer state
    private bool _showTransferModal;
    private bool _transferring;
    private string _transferUserId = "";
    private string _transferNotes = "";
    private string _transferError = "";

    // Report/Label state
    private bool _showReportModal;
    private bool _showLabelModal;
    private string? _qrCodeDataUrl;
    private bool _loadingQrCode;

    // Attachments state
    private List<AttachmentDto>? _attachments;
    private bool _attachmentsLoading;
    private Dictionary<int, string> _attachmentThumbnails = new();
    private bool _showAttachmentModal;
    private AttachmentDto? _viewingAttachment;
    private string? _viewingAttachmentUrl;

    private int? _loadedId;

    protected override async Task OnParametersSetAsync()
    {
        // Blazor reuses this page when only the asset id in the address changes - following a
        // link from one asset to another, or the Back button - and does not run
        // OnInitializedAsync again. Loading per id here is what stops one asset's details,
        // history and attachments being shown under another asset's address.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        var id = Id;

        _asset = null;
        _depreciation = null;
        _depreciationLoaded = false;
        _deviceLicences = [];
        _assignmentHistory = null;
        _showAllHistory = false;
        _attachments = null;
        _attachmentsLoading = false;
        _attachmentThumbnails = new();
        _deleting = false;
        _assigning = false;
        _returning = false;
        _transferring = false;
        _showDeleteModal = false;
        _showAssignModal = false;
        _showReturnModal = false;
        _showTransferModal = false;
        _showReportModal = false;
        _showLabelModal = false;
        _showAttachmentModal = false;
        _qrCodeDataUrl = null;
        _loadingQrCode = false;
        _viewingAttachment = null;
        _viewingAttachmentUrl = null;
        _loading = true;

        // Matches the page's PermissionView gate above. This runs regardless of what
        // PermissionView renders, so without this check a denied user's browser would still
        // fire GetAssetAsync (which throws on the resulting 403) behind a blank/denied page.
        if (!await PermissionChecker.HasPermissionAsync("iams:assets:view"))
        {
            if (IsCurrent(id)) _loading = false;
            return;
        }

        // Assignment history is gated on iams:assignments:view, which a role is free to hold apart
        // from iams:assets:view. Checked before the first render, so a user without it never sees
        // the card appear and never makes a request guaranteed to 403.
        var canViewAssignmentHistory = await PermissionChecker.HasPermissionAsync("iams:assignments:view");
        if (!IsCurrent(id)) return;
        _canViewAssignmentHistory = canViewAssignmentHistory;

        var asset = await Api.GetAssetAsync(id);
        if (!IsCurrent(id)) return;
        _asset = asset;
        _loading = false;

        // Load assignment history, attachments, and depreciation in background
        _ = LoadAssignmentHistory();
        _ = LoadAttachments();

        // Unlike its two neighbours, the depreciation report is gated on iams:reports:view -
        // a key Staff's default bundle does not carry. Checking first means a Staff user opening
        // an asset makes no request at all, rather than a guaranteed 403.
        if (await PermissionChecker.HasPermissionAsync("iams:reports:view") && IsCurrent(id))
            _ = LoadDepreciationAsync();

        // Gated for the same reason as the depreciation load above: Auditor-shaped roles can open an
        // asset without licence access, and should make no request rather than a guaranteed 403.
        if (await PermissionChecker.HasPermissionAsync("iams:licences:view") && IsCurrent(id))
            _ = LoadDeviceLicencesAsync();
    }

    // Every await on this page that ends in a write to its state checks this first. The id can
    // change while a request is in flight (see OnParametersSetAsync), and a response for the
    // asset the user has left must not land on the one they are now looking at.
    private bool IsCurrent(int id) => id == Id;

    private async Task LoadDepreciationAsync()
    {
        if (_asset is null) return;

        var id = Id;
        var assetTag = _asset.AssetTag;

        try
        {
            // The report returns every asset; we want one row. Wasteful for a large estate, and
            // deliberately accepted rather than adding a second calculation path that could drift
            // from DepreciationCalculator. If it becomes a problem, the fix is an assetTag filter
            // on the existing endpoint, not a client-side formula.
            var summary = await Api.GetDepreciationReportAsync();
            if (!IsCurrent(id)) return;
            _depreciation = summary?.Rows.FirstOrDefault(r => r.AssetTag == assetTag);
            _depreciationLoaded = summary is not null;
        }
        catch (HttpRequestException)
        {
            // Fired and forgotten with `_ =`, so an escaping exception would be an unobserved
            // task exception on the app's busiest page. Book value is supplementary: drop the
            // line rather than take the rest of the asset down with it.
            if (!IsCurrent(id)) return;
            _depreciationLoaded = false;
        }

        StateHasChanged();
    }

    private async Task LoadDeviceLicencesAsync()
    {
        var id = Id;
        var deviceLicences = await Api.GetDeviceLicencesAsync(id);
        if (!IsCurrent(id)) return;

        _deviceLicences = deviceLicences;
        StateHasChanged();
    }

    private async Task LoadAssignmentHistory()
    {
        // Also reached after assign, return and transfer, which are gated on keys of their own.
        if (!_canViewAssignmentHistory) return;

        var id = Id;
        var history = await Api.GetAssetHistoryAsync(id);
        if (!IsCurrent(id)) return;

        _assignmentHistory = history;
        StateHasChanged();
    }

    private async Task LoadAttachments()
    {
        var id = Id;
        _attachmentsLoading = true;
        StateHasChanged();

        var attachments = await Api.GetAttachmentsAsync(id);
        if (!IsCurrent(id)) return;

        _attachments = attachments;
        _attachmentsLoading = false;
        StateHasChanged();

        // Load thumbnails for images in background
        if (_attachments is not null)
        {
            foreach (var attachment in _attachments.Where(a => a.IsImage))
            {
                _ = LoadAttachmentThumbnail(id, attachment);
            }
        }
    }

    private async Task LoadAttachmentThumbnail(int id, AttachmentDto attachment)
    {
        var dataUrl = await Api.GetAttachmentBase64Async(id, attachment.Id, attachment.ContentType);
        if (dataUrl is not null && IsCurrent(id))
        {
            _attachmentThumbnails[attachment.Id] = dataUrl;
            StateHasChanged();
        }
    }

    private async Task ViewAttachment(AttachmentDto attachment)
    {
        var id = Id;
        _viewingAttachment = attachment;
        _viewingAttachmentUrl = null;
        _showAttachmentModal = true;

        // Load the full image/file
        if (_attachmentThumbnails.TryGetValue(attachment.Id, out var cachedUrl))
        {
            _viewingAttachmentUrl = cachedUrl;
        }
        else
        {
            var url = await Api.GetAttachmentBase64Async(id, attachment.Id, attachment.ContentType);
            if (!IsCurrent(id)) return;
            _viewingAttachmentUrl = url;
        }
        StateHasChanged();
    }

    private async Task DownloadAttachment()
    {
        if (_viewingAttachment is null || _viewingAttachmentUrl is null) return;
        await JS.InvokeVoidAsync("downloadFile", _viewingAttachmentUrl, _viewingAttachment.FileName);
    }

    private async Task DeleteAsset()
    {
        _deleting = true;
        var success = await Api.DeleteAssetAsync(Id);
        if (success)
        {
            Snackbar.Success("Asset deleted successfully");
            Navigation.NavigateTo("/assets");
        }
        else
        {
            Snackbar.Error("Failed to delete asset");
        }
        _deleting = false;
    }

    private async Task ShowAssignModal()
    {
        _assignUserId = "";
        _assignNotes = "";
        _assignError = "";
        var id = Id;
        _users ??= await Api.GetUserListAsync();
        if (IsCurrent(id)) _showAssignModal = true;
    }

    private void HideAssignModal() => _showAssignModal = false;

    private async Task AssignAsset()
    {
        var id = Id;
        _assigning = true;
        _assignError = "";

        var (success, error) = await Api.AssignAssetAsync(id, _assignUserId, string.IsNullOrWhiteSpace(_assignNotes) ? null : _assignNotes);

        if (success)
        {
            _showAssignModal = false;
            Snackbar.Success("Asset assigned successfully");
            await ReloadAfterChangeAsync(id);
        }
        else
        {
            _assignError = error ?? "Failed to assign asset";
            Snackbar.Error(_assignError);
        }

        _assigning = false;
    }

    private void ShowReturnModal()
    {
        _returnCondition = "Good";
        _returnNotes = "";
        _returnError = "";
        _showReturnModal = true;
    }

    private void HideReturnModal() => _showReturnModal = false;

    // Reloads after an assign, return or transfer. Skipped once the user has moved to another
    // asset: the change still happened, but the fresh copy belongs to a page no longer shown.
    private async Task ReloadAfterChangeAsync(int id)
    {
        if (!IsCurrent(id)) return;

        var asset = await Api.GetAssetAsync(id);
        if (!IsCurrent(id)) return;

        _asset = asset;
        await LoadAssignmentHistory();
    }

    private async Task ReturnAsset()
    {
        var id = Id;
        _returning = true;
        _returnError = "";

        var (success, error) = await Api.ReturnAssetAsync(id, string.IsNullOrWhiteSpace(_returnNotes) ? null : _returnNotes, _returnCondition);

        if (success)
        {
            _showReturnModal = false;
            Snackbar.Success("Asset returned successfully");
            await ReloadAfterChangeAsync(id);
        }
        else
        {
            _returnError = error ?? "Failed to return asset";
            Snackbar.Error(_returnError);
        }

        _returning = false;
    }

    // A row shows the amount in the currency it was booked in.
    private static string FormatPrice(decimal? price, string? currency) =>
        CurrencyFormat.Format(price, currency);

    // Net book value is always PHP - every asset's depreciation is computed and reported in
    // pesos regardless of the currency it was purchased in.
    private string BookValueDisplay()
    {
        // Still reachable, and no longer a placeholder: the report excludes Retired and Lost
        // assets outright, so those come back with no row of their own. Name the reason, the
        // same contract every undepreciable row on the report honours.
        if (_depreciation is null)
            return _asset?.Status is "Retired" or "Lost"
                ? $"Not depreciated — {_asset.Status.ToLowerInvariant()} assets are excluded"
                : "—";

        if (!_depreciation.IsDepreciable) return _depreciation.NotDepreciableReason ?? "—";

        var formatted = CurrencyFormat.Format(_depreciation.NetBookValue, CurrencyFormat.Php);
        return _depreciation.IsFullyDepreciated ? $"{formatted} (fully depreciated)" : formatted;
    }

    private string GetWarrantyPeriod()
    {
        if (!_asset!.WarrantyStartDate.HasValue && !_asset.WarrantyEndDate.HasValue)
            return "—";

        var start = _asset.WarrantyStartDate?.ToString("MMM dd, yyyy") ?? "—";
        var end = _asset.WarrantyEndDate?.ToString("MMM dd, yyyy") ?? "—";
        return $"{start} — {end}";
    }

    private string GetWarrantyBadgeVariant() => _asset!.WarrantyStatus switch
    {
        WarrantyStatus.Active => "warranty-active",
        WarrantyStatus.Expiring => "warranty-expiring",
        WarrantyStatus.Expired => "warranty-expired",
        _ => "default"
    };

    private string GetWarrantyBadgeText()
    {
        var days = _asset!.WarrantyDaysRemaining ?? 0;
        return _asset.WarrantyStatus switch
        {
            WarrantyStatus.Active => "Active",
            WarrantyStatus.Expiring => days <= 30 ? $"Expiring ({days}d)" : $"Expiring ({days / 30}mo)",
            WarrantyStatus.Expired => "Expired",
            _ => ""
        };
    }

    private string GetWarrantyDaysClass() => _asset!.WarrantyStatus switch
    {
        WarrantyStatus.Active => "text-emerald-600 dark:text-emerald-400",
        WarrantyStatus.Expiring => "text-amber-600 dark:text-amber-400",
        WarrantyStatus.Expired => "text-red-600 dark:text-red-400",
        _ => "text-muted-foreground"
    };

    // Transfer functionality
    private async Task ShowTransferModal()
    {
        _transferUserId = "";
        _transferNotes = "";
        _transferError = "";
        var id = Id;
        _users ??= await Api.GetUserListAsync();
        if (IsCurrent(id)) _showTransferModal = true;
    }

    private void HideTransferModal() => _showTransferModal = false;

    private async Task TransferAsset()
    {
        // Captured once: the return and the assign below must both act on the asset the user
        // confirmed the transfer for, even if they navigate to another one in between.
        var id = Id;
        _transferring = true;
        _transferError = "";

        // If asset is currently assigned, return it first
        if (!string.IsNullOrEmpty(_asset!.AssignedToUserId))
        {
            var (returnSuccess, returnError) = await Api.ReturnAssetAsync(id, $"Transferred to another user. {_transferNotes}".Trim(), "Good");
            if (!returnSuccess)
            {
                _transferError = returnError ?? "Failed to return asset before transfer";
                Snackbar.Error(_transferError);
                _transferring = false;
                return;
            }
        }

        // Assign to new user
        var (success, error) = await Api.AssignAssetAsync(id, _transferUserId, string.IsNullOrWhiteSpace(_transferNotes) ? "Asset transferred" : _transferNotes);

        if (success)
        {
            _showTransferModal = false;
            Snackbar.Success("Asset transferred successfully");
            await ReloadAfterChangeAsync(id);
        }
        else
        {
            _transferError = error ?? "Failed to transfer asset";
            Snackbar.Error(_transferError);
        }

        _transferring = false;
    }

    // Report functionality
    private void ShowReportModal() => _showReportModal = true;

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("printElement", "asset-report");
    }

    // Print Label functionality
    private async Task PrintLabel()
    {
        _showLabelModal = true;
        _loadingQrCode = true;
        _qrCodeDataUrl = null;
        StateHasChanged();

        var id = Id;
        var qrCodeDataUrl = await Api.GetAssetQrCodeBase64Async(id);
        if (!IsCurrent(id)) return;

        _qrCodeDataUrl = qrCodeDataUrl;
        _loadingQrCode = false;
        StateHasChanged();
    }

    private async Task PrintLabelContent()
    {
        await JS.InvokeVoidAsync("printElement", "asset-label");
    }

}
