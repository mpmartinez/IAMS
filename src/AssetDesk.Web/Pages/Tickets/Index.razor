@page "/tickets"
@using AssetDesk.Web.Components.UI
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Navigation
@inject SnackbarService Snackbar

<PageTitle>Tickets - AssetDesk</PageTitle>

<PermissionView Permission="iams:tickets:queue" ShowDeniedMessage="true">
<div class="space-y-4 sm:space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-foreground">Tickets</h1>
            <p class="text-sm text-muted-foreground mt-1">Service desk queue</p>
        </div>
        <Button Class="shadow-lg shadow-primary/25" OnClick="ShowCreateModal">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New Ticket
        </Button>
    </div>

    <!-- Summary Cards -->
    @if (_summary is not null)
    {
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-card rounded-2xl border border-amber-200 dark:border-amber-900/50 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-amber-600 dark:text-amber-400">@_summary.Open</p>
                        <p class="text-xs text-muted-foreground">Open</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-2xl border border-border p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-muted flex items-center justify-center">
                        <svg class="w-5 h-5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">@_summary.Unassigned</p>
                        <p class="text-xs text-muted-foreground">Unassigned</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-2xl border border-blue-200 dark:border-blue-900/50 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">@_summary.InProgress</p>
                        <p class="text-xs text-muted-foreground">In Progress</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-2xl border border-red-200 dark:border-red-900/50 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-red-600 dark:text-red-400">@_summary.Overdue</p>
                        <p class="text-xs text-muted-foreground">Overdue</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filters -->
    <div class="flex flex-col gap-3">
        <!-- Search -->
        <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <Input Value="@_search"
                   ValueChanged="OnSearchChanged"
                   Placeholder="Search by title, reference, requester..."
                   Class="pl-9" />
        </div>
        <!-- Filter Dropdowns -->
        <div class="flex flex-col sm:flex-row gap-3">
            <Select Value="@_type" ValueChanged="@(v => OnFilterChanged(() => _type = v))" Class="flex-1">
                <option value="">All Types</option>
                <option value="Incident">Incident</option>
                <option value="Request">Request</option>
                <option value="SecurityEvent">Security Event</option>
            </Select>
            <Select Value="@_status" ValueChanged="@(v => OnFilterChanged(() => _status = v))" Class="flex-1">
                <option value="">All Statuses</option>
                <option value="New">New</option>
                <option value="Assigned">Assigned</option>
                <option value="InProgress">In Progress</option>
                <option value="OnHold">On Hold</option>
                <option value="Resolved">Resolved</option>
                <option value="Closed">Closed</option>
                <option value="Cancelled">Cancelled</option>
            </Select>
            <Select Value="@_priority" ValueChanged="@(v => OnFilterChanged(() => _priority = v))" Class="flex-1">
                <option value="">All Priorities</option>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>
            </Select>
            @* Options come from the lookups API rather than a fixed list: categories are
               admin-editable, so a hardcoded set would drift the moment one is added on the
               Reference Data screen. *@
            <Select Value="@_category" ValueChanged="@(v => OnFilterChanged(() => _category = v))" Class="flex-1">
                <option value="">All Categories</option>
                @if (_categories is not null)
                {
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </Select>
        </div>
    </div>

    <!-- Results Summary -->
    @if (_tickets is not null && !_loading)
    {
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div class="text-sm text-muted-foreground">
                Showing @_tickets.Items.Count of @_tickets.TotalCount tickets
                @if (_hasFilters)
                {
                    <Button Variant="link" Size="none" Class="ml-2 text-sm" OnClick="ClearFilters">
                        Clear filters
                    </Button>
                }
            </div>
        </div>
    }

    <!-- Queue Table -->
    @if (_loading)
    {
        <Card Class="p-4 space-y-4">
            @for (int i = 0; i < 6; i++)
            {
                <div class="flex items-center gap-4">
                    <div class="flex-1 space-y-2">
                        <Skeleton Class="h-4 w-1/3" />
                        <Skeleton Class="h-3 w-1/5" />
                    </div>
                    <Skeleton Class="h-4 w-16 hidden sm:block" />
                    <Skeleton Class="h-4 w-20 hidden md:block" />
                    <Skeleton Class="h-4 w-20" />
                </div>
            }
        </Card>
    }
    else if (_tickets?.Items.Any() == true)
    {
        <Card NoPadding="true" Class="overflow-hidden">
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Class="px-4">Ticket</TableHead>
                        <TableHead Class="px-4 hidden sm:table-cell">Type</TableHead>
                        <TableHead Class="px-4 hidden lg:table-cell">Category</TableHead>
                        <TableHead Class="px-4 hidden lg:table-cell">Asset</TableHead>
                        <TableHead Class="px-4 hidden md:table-cell">Requester</TableHead>
                        <TableHead Class="px-4">Priority</TableHead>
                        <TableHead Class="px-4">Status</TableHead>
                        <TableHead Class="px-4 hidden md:table-cell">Assignee</TableHead>
                        <TableHead Class="px-4 hidden lg:table-cell">Age</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var ticket in _tickets.Items)
                    {
                        <TableRow @key="ticket.Id" @onclick="() => NavigateToTicket(ticket.Id)" Class="cursor-pointer">
                            <TableCell Class="px-4 py-3">
                                <div class="min-w-0">
                                    <div class="font-medium text-foreground truncate text-sm">@ticket.Title</div>
                                    <div class="text-xs text-muted-foreground font-mono">@ticket.Reference</div>
                                </div>
                            </TableCell>
                            <TableCell Class="px-4 py-3 hidden sm:table-cell">
                                <Badge Variant="@ticket.Type">@GetTypeLabel(ticket.Type)</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3 text-sm hidden lg:table-cell">@(string.IsNullOrEmpty(ticket.Category) ? "-" : ticket.Category)</TableCell>
                            <TableCell Class="px-4 py-3 text-sm font-mono hidden lg:table-cell">@(ticket.AssetTag ?? "-")</TableCell>
                            <TableCell Class="px-4 py-3 text-sm hidden md:table-cell">@(ticket.RequesterName ?? "-")</TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@ticket.Priority">@ticket.Priority</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3">
                                <Badge Variant="@ticket.Status">@GetStatusLabel(ticket.Status)</Badge>
                            </TableCell>
                            <TableCell Class="px-4 py-3 text-sm hidden md:table-cell">@(ticket.AssignedToName ?? "Unassigned")</TableCell>
                            <TableCell Class="px-4 py-3 text-sm text-muted-foreground hidden lg:table-cell">@GetAge(ticket.CreatedAt)</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </Card>

        <!-- Pagination -->
        @if (_tickets.TotalPages > 1)
        {
            <div class="flex items-center justify-center pt-4">
                <Pagination CurrentPage="@_page"
                            TotalPages="@_tickets.TotalPages"
                            OnPageChange="ChangePage"
                            MaxVisiblePages="5" />
            </div>
        }
    }
    else
    {
        <Card Class="p-6">
            <EmptyState Title="No tickets found" Description="@(_hasFilters ? "Try adjusting your filters." : "No tickets have been raised yet.")">
                @if (_hasFilters)
                {
                    <Button Variant="secondary" OnClick="ClearFilters">
                        Clear Filters
                    </Button>
                }
            </EmptyState>
        </Card>
    }
</div>

<!-- New Ticket Modal -->
<Modal IsOpen="@_showCreateModal" Title="New Ticket" Size="lg" OnClose="HideCreateModal">
    <ChildContent>
        <div class="space-y-4">
            <FormField LabelText="Type">
                <Select Value="@_newType" ValueChanged="OnNewTypeChanged">
                    <option value="Incident">Incident</option>
                    <option value="Request">Request</option>
                    <option value="SecurityEvent">Security Event</option>
                </Select>
            </FormField>

            <FormField LabelText="Title">
                <Input Value="@_newTitle" ValueChanged="v => _newTitle = v" Placeholder="Short summary of the issue" />
            </FormField>

            <FormField LabelText="Category">
                <Select Value="@_newCategory" ValueChanged="v => _newCategory = v">
                    @if (_categories is not null)
                    {
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                    else
                    {
                        <option value="Other">Other</option>
                    }
                </Select>
            </FormField>

            <div class="space-y-1.5">
                <AssetDesk.Web.Components.UI.Label Class="block">
                    Description <span class="text-muted-foreground font-normal">(optional)</span>
                </AssetDesk.Web.Components.UI.Label>
                <Textarea Value="@_newDescription"
                          ValueChanged="@(v => _newDescription = v ?? "")"
                          Rows="3"
                          Placeholder="Details for whoever picks this up..."
                          Class="resize-none" />
            </div>

            <FormField LabelText="Priority">
                <Select Value="@_newPriority" ValueChanged="v => _newPriority = v">
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                    <option value="Critical">Critical</option>
                </Select>
            </FormField>

            @if (_newType != "Request")
            {
                <div class="space-y-1.5">
                    <AssetDesk.Web.Components.UI.Label Class="block">
                        Asset <span class="text-muted-foreground font-normal">(optional)</span>
                    </AssetDesk.Web.Components.UI.Label>

                    @if (_newLinkedAsset is not null)
                    {
                        <div class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-muted/40 border">
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-foreground truncate">@_newLinkedAsset.DisplayName</p>
                                <p class="text-xs text-muted-foreground font-mono">@_newLinkedAsset.AssetTag</p>
                            </div>
                            <Button Variant="link" Size="none" Class="shrink-0 text-xs" OnClick="ClearNewAsset">
                                Change
                            </Button>
                        </div>
                    }
                    else
                    {
                        <Input Value="@_assetSearch" ValueChanged="OnAssetSearchChanged" Placeholder="Search by tag or name..." />

                        @if (_assetResults.Count > 0)
                        {
                            <div class="mt-2 rounded-xl border overflow-hidden divide-y">
                                @foreach (var asset in _assetResults)
                                {
                                    <Button @key="asset.Id"
                                            Variant="ghost"
                                            Size="none"
                                            Class="w-full justify-start gap-3 rounded-none px-4 py-2.5 text-left"
                                            OnClick="() => PickNewAsset(asset)">
                                        <div class="min-w-0">
                                            <p class="text-sm text-foreground truncate">@asset.DisplayName</p>
                                            <p class="text-xs text-muted-foreground font-mono">@asset.AssetTag</p>
                                        </div>
                                    </Button>
                                }
                            </div>
                        }
                    }
                </div>
            }

            <TicketAttachmentPicker @bind-Files="_pendingFiles" Disabled="@_creating" />

            @if (!string.IsNullOrEmpty(_createError))
            {
                <Alert Variant="destructive">
                    <Icon>
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </Icon>
                    <ChildContent>
                        @_createError
                    </ChildContent>
                </Alert>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <Button Variant="ghost" OnClick="HideCreateModal">Cancel</Button>
        <Button OnClick="SubmitCreate" Loading="@_creating" Disabled="@string.IsNullOrWhiteSpace(_newTitle)">Create Ticket</Button>
    </FooterContent>
</Modal>
</PermissionView>

@code {
    private bool _loading = true;
    private PagedResponse<TicketListItemDto>? _tickets;
    private TicketSummaryDto? _summary;
    private string _search = "";
    private string _type = "";
    private string _status = "";
    private string _priority = "";
    private int _page = 1;
    private System.Timers.Timer? _searchTimer;

    private bool _hasFilters => !string.IsNullOrEmpty(_search) || !string.IsNullOrEmpty(_type) || !string.IsNullOrEmpty(_status) || !string.IsNullOrEmpty(_priority);

    // New Ticket modal
    private bool _showCreateModal;
    private bool _creating;
    private string? _createError;
    private string _newType = "Incident";
    private string _newTitle = "";
    private string _newCategory = "Other";
    private string _newDescription = "";
    private string _newPriority = "Medium";
    private string[]? _categories;
    private string _category = "";
    private int? _newLinkedAssetId;
    private AssetDto? _newLinkedAsset;
    private string _assetSearch = "";
    private List<AssetDto> _assetResults = new();
    private System.Timers.Timer? _assetSearchTimer;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadTickets(), LoadSummary(), LoadCategories());
    }

    private async Task LoadCategories()
    {
        try
        {
            _categories ??= await Api.GetTicketCategoriesAsync();
        }
        catch
        {
            // The filter just shows "All Categories" if this fails; the queue still works.
        }
    }

    private async Task LoadTickets()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _tickets = await Api.GetTicketsAsync(_type, _category, _status, _priority, null, null, _search, _page);
        }
        catch
        {
            _tickets = null;
        }

        _loading = false;
    }

    private async Task LoadSummary()
    {
        try
        {
            _summary = await Api.GetTicketSummaryAsync();
        }
        catch
        {
            _summary = null;
        }
    }

    private async Task OnFilterChanged(Action apply)
    {
        apply();
        _page = 1;
        await LoadTickets();
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        _searchTimer?.Stop();
        _searchTimer?.Dispose();
        _searchTimer = new System.Timers.Timer(300);
        _searchTimer.Elapsed += async (s, ev) =>
        {
            _searchTimer?.Stop();
            _page = 1;
            await InvokeAsync(async () =>
            {
                await LoadTickets();
                StateHasChanged();
            });
        };
        _searchTimer.Start();
    }

    private async Task ChangePage(int newPage)
    {
        _page = newPage;
        await LoadTickets();
    }

    private async Task ClearFilters()
    {
        _search = "";
        _type = "";
        _status = "";
        _priority = "";
        _page = 1;
        await LoadTickets();
    }

    public void Dispose()
    {
        _searchTimer?.Dispose();
        _assetSearchTimer?.Dispose();
    }

    private async Task ShowCreateModal()
    {
        _newType = "Incident";
        _newTitle = "";
        _newCategory = "Other";
        _newDescription = "";
        _newPriority = "Medium";
        _createError = null;
        ClearNewAsset();
        _showCreateModal = true;

        // Fetched once and cached for the session by ApiClient, not on every modal open.
        _categories ??= await Api.GetTicketCategoriesAsync();
    }

    private List<PendingAttachment> _pendingFiles = new();

    /// Uploads the staged files against a ticket that now exists. Returns how many failed.
    private async Task<int> UploadPendingAttachments(int ticketId)
    {
        var failed = 0;

        // Sequential, not parallel: same reason as Report.razor - these offices are on poor
        // connections and a batch of photos uploaded at once saturates the link.
        foreach (var f in _pendingFiles)
        {
            using var stream = new MemoryStream(f.Data);
            var (ok, _, _) = await Api.UploadTicketAttachmentAsync(
                ticketId, stream, f.Name, f.ContentType, TicketAttachmentDefaults.Category);

            if (!ok) failed++;
        }

        return failed;
    }

    private void HideCreateModal()
    {
        _showCreateModal = false;
        // Drop anything staged but never uploaded, so cancelling does not carry files into the
        // next ticket.
        _pendingFiles = new();
    }

    private void OnNewTypeChanged(string value)
    {
        _newType = value;
        if (_newType == "Request")
        {
            ClearNewAsset();
        }
    }

    private void ClearNewAsset()
    {
        _newLinkedAssetId = null;
        _newLinkedAsset = null;
        _assetSearch = "";
        _assetResults.Clear();
    }

    private void PickNewAsset(AssetDto asset)
    {
        _newLinkedAssetId = asset.Id;
        _newLinkedAsset = asset;
        _assetSearch = "";
        _assetResults.Clear();
    }

    private void OnAssetSearchChanged(string value)
    {
        _assetSearch = value;
        _assetSearchTimer?.Stop();
        _assetSearchTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(_assetSearch) || _assetSearch.Length < 2)
        {
            _assetResults.Clear();
            return;
        }

        _assetSearchTimer = new System.Timers.Timer(300);
        _assetSearchTimer.Elapsed += async (s, ev) =>
        {
            _assetSearchTimer?.Stop();
            await InvokeAsync(async () =>
            {
                var results = await Api.GetAssetsAsync(search: _assetSearch, page: 1, pageSize: 6);
                _assetResults = results?.Items.ToList() ?? new();
                StateHasChanged();
            });
        };
        _assetSearchTimer.Start();
    }

    private async Task SubmitCreate()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;

        _creating = true;
        _createError = null;

        var request = new CreateTicketRequest
        {
            Type = _newType,
            Category = _newCategory,
            Title = _newTitle.Trim(),
            Description = string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription.Trim(),
            Priority = _newPriority,
            AssetId = _newType == "Request" ? null : _newLinkedAssetId
        };

        // CreateAsync can fail with a 409 after exhausting its own retries against a
        // ticket-number collision, or a 400 once the tenant's monthly quota is hit;
        // CreateTicketAsync surfaces either as a readable Error rather than throwing, so
        // both land here instead of failing silently.
        var (success, created, error) = await Api.CreateTicketAsync(request);

        if (success)
        {
            _showCreateModal = false;

            // Attachments are keyed by ticket id, so they can only go up once the ticket exists.
            // A failure here never undoes the ticket - one that was created but whose photos
            // failed is still a filed ticket - so the two outcomes are reported separately.
            var total = _pendingFiles.Count;
            var failed = created is not null && total > 0
                ? await UploadPendingAttachments(created.Id)
                : 0;
            _pendingFiles = new();

            var attached = total - failed;
            if (failed == 0)
                Snackbar.Success("Ticket created");
            else if (attached == 0)
                Snackbar.Warning("Ticket created, but the attachment(s) couldn't be uploaded.");
            else
                Snackbar.Warning($"Ticket created. {attached} of {total} attachments uploaded.");

            await Task.WhenAll(LoadTickets(), LoadSummary(), LoadCategories());
        }
        else
        {
            _createError = error ?? "Could not create the ticket. Please try again.";
        }

        _creating = false;
    }

    private void NavigateToTicket(int id)
    {
        Navigation.NavigateTo($"/tickets/{id}");
    }

    private string GetAge(DateTime createdAt)
    {
        var span = DateTime.UtcNow - createdAt;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays}d";
        return $"{(int)(span.TotalDays / 30)}mo";
    }

    private string GetTypeLabel(string type) => type switch
    {
        "SecurityEvent" => "Security Event",
        _ => type
    };

    private string GetStatusLabel(string status) => status switch
    {
        "InProgress" => "In Progress",
        "OnHold" => "On Hold",
        _ => status
    };
}
