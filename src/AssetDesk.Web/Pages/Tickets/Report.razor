@page "/report"
@using AssetDesk.Web.Components.UI
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject SnackbarService Snackbar

<PageTitle>Report a Problem - AssetDesk</PageTitle>

<div class="max-w-lg mx-auto space-y-4 sm:space-y-6">
    @if (_created is not null)
    {
        <!-- Success -->
        <div class="text-center px-4 py-8 animate-scale-in">
            <div class="w-20 h-20 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mx-auto mb-4 success-pulse">
                <svg class="w-10 h-10 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-foreground mb-2">Report sent</h2>
            <p class="text-muted-foreground mb-1">IT has been notified.</p>
            <p class="text-sm text-muted-foreground font-mono mb-6">@_created.Reference</p>
            <div class="flex flex-col gap-3">
                <a href="/my-tickets" class="@UiClasses.PrimaryButtonLarge">
                    View My Reports
                </a>
                <Button Variant="link" Class="text-muted-foreground" OnClick="StartOver">
                    Report another problem
                </Button>
            </div>
        </div>
    }
    else if (_type is null)
    {
        <!-- Step 1: type picker -->
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-foreground">Report a Problem</h1>
            <p class="text-sm text-muted-foreground mt-1">What's going on?</p>
        </div>

        @if (_linkedAsset is not null)
        {
            <Alert Class="items-center">
                <Icon>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 01-2-2V5a1 1 0 011-1h16a1 1 0 011 1v1a2 2 0 01-2 2M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                    </svg>
                </Icon>
                <ChildContent>
                    <p class="font-medium text-foreground truncate">@_linkedAsset.DisplayName</p>
                    <p class="text-xs text-muted-foreground font-mono">@_linkedAsset.AssetTag</p>
                </ChildContent>
            </Alert>
        }

        @* Size="none" because these are card-sized: the button owns its own box. *@
        <div class="space-y-3">
            <Button Variant="outline" Size="none" Class="@ChoiceClasses" OnClick='() => SelectChoice(Incident, CategoryHardware)'>
                <div class="w-14 h-14 rounded-2xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-7 h-7 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-base font-semibold text-foreground">Equipment issue</p>
                    <p class="text-sm text-muted-foreground">Something's broken or not working</p>
                </div>
                <svg class="w-5 h-5 text-muted-foreground shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </Button>

            <Button Variant="outline" Size="none" Class="@ChoiceClasses" OnClick='() => SelectChoice(Incident, CategorySoftware)'>
                <div class="w-14 h-14 rounded-2xl bg-violet-100 dark:bg-violet-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-7 h-7 text-violet-600 dark:text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-base font-semibold text-foreground">Software or system problem</p>
                    <p class="text-sm text-muted-foreground">An app or system isn't working</p>
                </div>
                <svg class="w-5 h-5 text-muted-foreground shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </Button>

            <Button Variant="outline" Size="none" Class="@ChoiceClasses" OnClick='() => SelectChoice(Request, CategoryHardware)'>
                <div class="w-14 h-14 rounded-2xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-7 h-7 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-base font-semibold text-foreground">Request equipment</p>
                    <p class="text-sm text-muted-foreground">Ask IT for something you need</p>
                </div>
                <svg class="w-5 h-5 text-muted-foreground shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </Button>

            <Button Variant="outline" Size="none" Class="@ChoiceClasses" OnClick='() => SelectChoice(Request, CategoryAccess)'>
                <div class="w-14 h-14 rounded-2xl bg-teal-100 dark:bg-teal-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-7 h-7 text-teal-600 dark:text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-base font-semibold text-foreground">Request access or account</p>
                    <p class="text-sm text-muted-foreground">Password reset, or access to a system</p>
                </div>
                <svg class="w-5 h-5 text-muted-foreground shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </Button>

            <Button Variant="outline" Size="none" Class="@ChoiceClasses" OnClick='() => SelectChoice(SecurityEvent, CategorySecurity)'>
                <div class="w-14 h-14 rounded-2xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-7 h-7 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01" />
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-base font-semibold text-foreground">Security concern</p>
                    <p class="text-sm text-muted-foreground">Lost device, phishing, suspicious activity</p>
                </div>
                <svg class="w-5 h-5 text-muted-foreground shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </Button>
        </div>
    }
    else
    {
        <!-- Step 2: short form -->
        <div class="flex items-center gap-2">
            <Button Variant="ghost" Size="icon" Class="-ml-2 text-muted-foreground" OnClick="() => _type = null" aria-label="Back">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </Button>
            <div>
                <h1 class="text-lg sm:text-xl font-bold text-foreground">@TypeHeading</h1>
                <p class="text-sm text-muted-foreground">@TypeSubheading</p>
            </div>
        </div>

        <Card Class="p-4 sm:p-5 space-y-4">
            <FormField LabelText="@TitleLabel">
                <Input Value="@_title"
                       ValueChanged="@(v => _title = v ?? "")"
                       Placeholder="@TitlePlaceholder"
                       MaxLength="200"
                       Class="h-11 text-base" />
            </FormField>

            @if (_type != SecurityEvent)
            {
                <div class="space-y-1.5">
                    <AssetDesk.Web.Components.UI.Label Class="block">
                        Details <span class="text-muted-foreground font-normal">(optional)</span>
                    </AssetDesk.Web.Components.UI.Label>
                    <Textarea Value="@_description"
                              ValueChanged="@(v => _description = v ?? "")"
                              Rows="3"
                              Placeholder="Anything that will help IT understand the problem..."
                              Class="resize-none text-base" />
                </div>
            }

            @if (AssetPickerApplies)
            {
                <div class="space-y-1.5">
                    <AssetDesk.Web.Components.UI.Label Class="block">
                        Device <span class="text-muted-foreground font-normal">(optional)</span>
                    </AssetDesk.Web.Components.UI.Label>

                    @if (_linkedAsset is not null)
                    {
                        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-muted/40 border">
                            <svg class="w-5 h-5 text-muted-foreground shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 01-2-2V5a1 1 0 011-1h16a1 1 0 011 1v1a2 2 0 01-2 2M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                            </svg>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-foreground truncate">@_linkedAsset.DisplayName</p>
                                <p class="text-xs text-muted-foreground font-mono">@_linkedAsset.AssetTag</p>
                            </div>
                            <Button Variant="link" Size="sm" Class="shrink-0 px-0 text-xs" OnClick="ClearAsset">
                                Change
                            </Button>
                        </div>
                    }
                    else
                    {
                        <div class="relative">
                            <Input Value="@_assetSearch"
                                   ValueChanged="OnAssetSearchChanged"
                                   Placeholder="Search by tag or name..."
                                   Class="h-11 text-base" />

                            @if (_assetResults.Count > 0)
                            {
                                <div class="mt-2 rounded-xl border overflow-hidden divide-y">
                                    @foreach (var asset in _assetResults)
                                    {
                                        <Button @key="asset.Id"
                                                Variant="ghost"
                                                Size="none"
                                                Class="w-full justify-start gap-3 rounded-none px-4 py-2.5 text-left"
                                                OnClick="() => PickAsset(asset)">
                                            <div class="min-w-0">
                                                <p class="text-sm text-foreground truncate">@asset.DisplayName</p>
                                                <p class="text-xs text-muted-foreground font-mono">@asset.AssetTag</p>
                                            </div>
                                        </Button>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_assetSearch) && _assetSearch.Length >= 2 && !_searchingAssets)
                            {
                                <p class="text-xs text-muted-foreground mt-1.5">No matching devices</p>
                            }
                        </div>
                    }
                </div>
            }

            <TicketAttachmentPicker @bind-Files="_pendingFiles" Disabled="@_submitting" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <Alert Variant="destructive">
                    <Icon>
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </Icon>
                    <ChildContent>
                        @_error
                    </ChildContent>
                </Alert>
            }

            <Button Size="lg"
                    Class="w-full text-base font-semibold shadow-lg shadow-primary/25"
                    Loading="@_submitting"
                    Disabled="@string.IsNullOrWhiteSpace(_title)"
                    OnClick="Submit">
                @SubmitLabel
            </Button>
        </Card>
    }
</div>

<style>
    .success-pulse {
        animation: successPulse 0.6s ease-out;
    }
    @@keyframes successPulse {
        0% { transform: scale(0.8); opacity: 0; }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    // Mirrors AssetDesk.Api.Entities.TicketTypes, which the Web project (Shared DTOs only)
    // cannot reference directly.
    private const string Incident = "Incident";
    private const string Request = "Request";
    private const string SecurityEvent = "SecurityEvent";

    private const string CategoryHardware = "Hardware";
    private const string CategorySoftware = "Software";
    private const string CategoryAccess = "Access";
    private const string CategorySecurity = "Security";

    private string? _category;

    [SupplyParameterFromQuery] public int? AssetId { get; set; }

    private string? _type;
    // The five type cards are card-sized buttons; Size="none" hands the whole box to this.
    private const string ChoiceClasses =
        "w-full justify-start gap-4 p-5 rounded-2xl text-left hover:shadow-lg";

    private string _title = "";
    private string _description = "";
    private int? _linkedAssetId;
    private AssetDto? _linkedAsset;
    private string _assetSearch = "";
    private List<AssetDto> _assetResults = new();
    private bool _searchingAssets;
    private bool _submitting;
    private string? _error;
    private TicketDto? _created;
    private System.Timers.Timer? _searchTimer;

    private List<PendingAttachment> _pendingFiles = new();
    private int _uploadedCount;
    private int _uploadTotal;

    private string SubmitLabel => _submitting && _uploadTotal > 0
        ? $"Uploading {_uploadedCount} of {_uploadTotal}..."
        : _submitting ? "Sending..." : "Send Report";

    private string TypeHeading => _type switch
    {
        Incident => "Equipment Issue",
        Request => "Request Equipment",
        SecurityEvent => "Security Concern",
        _ => "Report a Problem"
    };

    private string TypeSubheading => _type switch
    {
        Incident => "Tell us what's wrong",
        Request => "Tell us what you need",
        SecurityEvent => "The fewer details the faster - just get it to us",
        _ => ""
    };

    private string TitleLabel => _type switch
    {
        Incident => "What's wrong?",
        Request => "What do you need?",
        SecurityEvent => "What happened?",
        _ => "Title"
    };

    private string TitlePlaceholder => _type switch
    {
        Incident => "e.g. Laptop won't turn on",
        Request => "e.g. Second monitor for my desk",
        SecurityEvent => "e.g. Lost my laptop on the way home",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        if (AssetId.HasValue)
        {
            _linkedAssetId = AssetId;
            _linkedAsset = await Api.GetAssetAsync(AssetId.Value);
        }
    }

    /// <summary>
    /// Each choice carries both a type and a category. Type drives behaviour - Request is what
    /// fulfilment acts on, SecurityEvent forces the priority floor - while category is what an
    /// IT officer reports on, and is the reason software and access requests are visible at all.
    /// </summary>
    private void SelectChoice(string type, string category)
    {
        _type = type;
        _category = category;
        _error = null;
    }

    /// <summary>
    /// Anything but a Request can name an asset. A software fault still happens on a
    /// particular machine, and a lost-device report is entirely about which device - only a
    /// request for equipment has nothing to point at yet, because the thing does not exist.
    /// </summary>
    private bool AssetPickerApplies => _type != Request;

    private void ClearAsset()
    {
        _linkedAssetId = null;
        _linkedAsset = null;
        _assetSearch = "";
        _assetResults.Clear();
    }

    private void PickAsset(AssetDto asset)
    {
        _linkedAssetId = asset.Id;
        _linkedAsset = asset;
        _assetSearch = "";
        _assetResults.Clear();
    }

    private void OnAssetSearchChanged(string value)
    {
        _assetSearch = value;
        _searchTimer?.Stop();
        _searchTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(_assetSearch) || _assetSearch.Length < 2)
        {
            _assetResults.Clear();
            return;
        }

        _searchTimer = new System.Timers.Timer(300);
        _searchTimer.Elapsed += async (s, ev) =>
        {
            _searchTimer?.Stop();
            await InvokeAsync(async () =>
            {
                _searchingAssets = true;
                StateHasChanged();
                var results = await Api.GetAssetsAsync(search: _assetSearch, page: 1, pageSize: 6);
                _assetResults = results?.Items.ToList() ?? new();
                _searchingAssets = false;
                StateHasChanged();
            });
        };
        _searchTimer.Start();
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_title)) return;

        _submitting = true;
        _error = null;

        var request = new CreateTicketRequest
        {
            Type = _type!,
            Category = _category!,
            Title = _title.Trim(),
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            AssetId = AssetPickerApplies ? _linkedAssetId : null
        };

        var (success, ticket, error) = await Api.CreateTicketAsync(request);

        if (success && ticket is not null)
        {
            // The ticket is filed at this point - that's what the employee cares about.
            // Attachment upload failures are reported separately and never undo this.
            if (_pendingFiles.Count > 0)
            {
                await UploadAttachments(ticket.Id);
            }
            else
            {
                Snackbar.Success("Report sent to IT");
            }

            _created = ticket;
        }
        else
        {
            _error = error ?? "Something went wrong sending your report. Please try again.";
        }

        _submitting = false;
    }

    private async Task UploadAttachments(int ticketId)
    {
        _uploadTotal = _pendingFiles.Count;
        _uploadedCount = 0;
        var failed = 0;

        // Sequential, not parallel: these offices are on poor connections, and a batch of
        // 5-10MB photos uploaded at once is far more likely to time out or saturate the link.
        foreach (var f in _pendingFiles)
        {
            _uploadedCount++;
            StateHasChanged();

            using var stream = new MemoryStream(f.Data);
            var (ok, _, _) = await Api.UploadTicketAttachmentAsync(
                ticketId, stream, f.Name, f.ContentType, TicketAttachmentDefaults.Category);

            if (!ok) failed++;
        }

        var attached = _uploadTotal - failed;
        if (failed == 0)
        {
            Snackbar.Success(attached == 1 ? "Report sent with 1 attachment" : $"Report sent with {attached} attachments");
        }
        else if (attached == 0)
        {
            Snackbar.Warning("Report sent to IT, but the attachment(s) couldn't be uploaded.");
        }
        else
        {
            Snackbar.Warning($"Report sent to IT. {attached} of {_uploadTotal} attachments uploaded.");
        }
    }

    private void StartOver()
    {
        _created = null;
        _type = null;
        _category = null;
        _title = "";
        _description = "";
        _error = null;
        _pendingFiles = new();
        _uploadedCount = 0;
        _uploadTotal = 0;
        if (!AssetId.HasValue)
        {
            ClearAsset();
        }
    }

    public void Dispose()
    {
        _searchTimer?.Dispose();
    }
}
