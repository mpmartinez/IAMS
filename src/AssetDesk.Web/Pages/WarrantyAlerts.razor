@page "/warranty-alerts"
@using AssetDesk.Web.Components.UI
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject SnackbarService Snackbar

<PageTitle>Warranty Alerts - AssetDesk</PageTitle>

<div class="space-y-4 sm:space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-foreground">Warranty Alerts</h1>
            <p class="text-sm text-muted-foreground mt-1">Track expiring and expired warranties</p>
        </div>
    </div>

    <!-- Summary Cards -->
    @if (_summary is not null)
    {
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-card rounded-2xl border border-border p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-muted flex items-center justify-center">
                        <svg class="w-5 h-5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-foreground">@_summary.TotalAlerts</p>
                        <p class="text-xs text-muted-foreground">Total Alerts</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-2xl border border-amber-200 dark:border-amber-900/50 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-amber-600 dark:text-amber-400">@_summary.ExpiringCount</p>
                        <p class="text-xs text-muted-foreground">Expiring Soon</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-2xl border border-red-200 dark:border-red-900/50 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-red-600 dark:text-red-400">@_summary.ExpiredCount</p>
                        <p class="text-xs text-muted-foreground">Expired</p>
                    </div>
                </div>
            </div>
            <div class="bg-card rounded-2xl border border-primary/30 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                        <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-primary">@_summary.UnacknowledgedCount</p>
                        <p class="text-xs text-muted-foreground">Unacknowledged</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filters -->
    <div class="flex flex-col sm:flex-row gap-3">
        <Select Value="@_alertType" ValueChanged="OnAlertTypeChanged" Class="flex-1 sm:flex-none sm:w-48">
            <option value="">All Alert Types</option>
            <option value="Expiring">Expiring</option>
            <option value="Expired">Expired</option>
        </Select>
        <Select Value="@_acknowledged" ValueChanged="OnAcknowledgedChanged" Class="flex-1 sm:flex-none sm:w-48">
            <option value="">All Statuses</option>
            <option value="false">Unacknowledged</option>
            <option value="true">Acknowledged</option>
        </Select>
        @if (_selectedAlertIds.Count > 0)
        {
            <PermissionView Permission="iams:warranty:manage">
                <Button Loading="@_acknowledging" OnClick="AcknowledgeSelected">
                    @if (_acknowledging)
                    {
                        <span>Acknowledging...</span>
                    }
                    else
                    {
                        <span>Acknowledge (@_selectedAlertIds.Count)</span>
                    }
                </Button>
            </PermissionView>
        }
    </div>

    <!-- Alerts List -->
    @if (_loading)
    {
        <div class="space-y-4">
            @for (int i = 0; i < 5; i++)
            {
                <div class="bg-card rounded-2xl border border-border p-4">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl skeleton"></div>
                        <div class="flex-1 space-y-2">
                            <div class="h-5 w-1/3 rounded skeleton"></div>
                            <div class="h-4 w-1/2 rounded skeleton"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_alerts?.Items.Any() == true)
    {
        <div class="space-y-3">
            @foreach (var alert in _alerts.Items)
            {
                <div class="bg-card rounded-2xl border @(alert.IsAcknowledged ? "border-border opacity-75" : GetAlertBorderClass(alert.AlertType)) p-4 transition-all duration-200">
                    <div class="flex items-start gap-4">
                        <!-- Checkbox for bulk actions -->
                        <PermissionView Permission="iams:warranty:manage">
                            @if (!alert.IsAcknowledged)
                            {
                                <Checkbox Align="start"
                                          Class="mt-1"
                                          Value="@_selectedAlertIds.Contains(alert.Id)"
                                          ValueChanged="v => ToggleAlertSelection(alert.Id, v)" />
                            }
                        </PermissionView>

                        <!-- Alert Icon -->
                        <div class="w-10 h-10 rounded-xl @GetAlertBgClass(alert.AlertType) flex items-center justify-center shrink-0">
                            @if (alert.AlertType == WarrantyAlertType.Expired)
                            {
                                <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            }
                            else
                            {
                                <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            }
                        </div>

                        <!-- Alert Content -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <a href="/assets/@alert.AssetId" class="font-semibold text-foreground hover:text-primary dark:hover:text-primary transition-colors">
                                            @alert.AssetDisplayName
                                        </a>
                                        <Badge Variant="@(alert.AlertType == WarrantyAlertType.Expired ? "warranty-expired" : "warranty-expiring")" Pulse="@(alert.AlertType == WarrantyAlertType.Expiring && !alert.IsAcknowledged)">@(alert.AlertType == WarrantyAlertType.Expired ? "Expired" : "Expiring")</Badge>
                                    </div>
                                    <p class="text-sm text-muted-foreground mt-0.5 font-mono">@alert.AssetTag</p>
                                </div>
                                @if (!alert.IsAcknowledged)
                                {
                                    <PermissionView Permission="iams:warranty:manage">
                                        <Button Variant="link" Size="none" Class="text-sm whitespace-nowrap" OnClick="() => AcknowledgeAlert(alert.Id)">
                                            Acknowledge
                                        </Button>
                                    </PermissionView>
                                }
                            </div>

                            <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
                                <div>
                                    <p class="text-xs text-muted-foreground">Warranty End</p>
                                    <p class="text-foreground">@alert.WarrantyEndDate.ToString("MMM dd, yyyy")</p>
                                </div>
                                <div>
                                    <p class="text-xs text-muted-foreground">Days</p>
                                    <p class="@GetDaysClass(alert.DaysRemaining)">
                                        @if (alert.DaysRemaining < 0)
                                        {
                                            <span>@Math.Abs(alert.DaysRemaining) overdue</span>
                                        }
                                        else
                                        {
                                            <span>@alert.DaysRemaining remaining</span>
                                        }
                                    </p>
                                </div>
                                @if (!string.IsNullOrEmpty(alert.WarrantyProvider))
                                {
                                    <div>
                                        <p class="text-xs text-muted-foreground">Provider</p>
                                        <p class="text-foreground truncate">@alert.WarrantyProvider</p>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(alert.AssignedToUserName))
                                {
                                    <div>
                                        <p class="text-xs text-muted-foreground">Assigned To</p>
                                        <p class="text-foreground truncate">@alert.AssignedToUserName</p>
                                    </div>
                                }
                            </div>

                            @if (alert.IsAcknowledged)
                            {
                                <p class="text-xs text-muted-foreground mt-2">
                                    Acknowledged by @alert.AcknowledgedByUserName on @alert.AcknowledgedAt?.ToString("MMM dd, yyyy")
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (_alerts.TotalPages > 1)
        {
            <div class="flex items-center justify-center gap-2 pt-4">
                <Pagination CurrentPage="@_page"
                            TotalPages="@_alerts.TotalPages"
                            OnPageChange="ChangePage"
                            MaxVisiblePages="5" />
            </div>
        }
    }
    else
    {
        <Card Class="p-6">
            <EmptyState Title="No warranty alerts" Description="All warranties are in good standing.">
                <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="font-medium">All clear!</span>
                </div>
            </EmptyState>
        </Card>
    }
</div>

@code {
    private bool _loading = true;
    private bool _acknowledging;
    private PagedResponse<WarrantyAlertDto>? _alerts;
    private WarrantyAlertSummaryDto? _summary;
    private async Task OnAlertTypeChanged(string value)
    {
        _alertType = value;
        await LoadAlerts();
    }

    private async Task OnAcknowledgedChanged(string value)
    {
        _acknowledged = value;
        await LoadAlerts();
    }

    private string _alertType = "";
    private string _acknowledged = "";
    private int _page = 1;
    private HashSet<int> _selectedAlertIds = new();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAlerts(), LoadSummary());
    }

    private async Task LoadAlerts()
    {
        _loading = true;
        StateHasChanged();

        bool? acknowledged = string.IsNullOrEmpty(_acknowledged) ? null : bool.Parse(_acknowledged);
        _alerts = await Api.GetWarrantyAlertsAsync(_alertType, acknowledged, _page);
        _selectedAlertIds.Clear();
        _loading = false;
    }

    private async Task LoadSummary()
    {
        _summary = await Api.GetWarrantyAlertSummaryAsync();
    }

    private async Task ChangePage(int newPage)
    {
        _page = newPage;
        await LoadAlerts();
    }

    private void ToggleAlertSelection(int alertId, bool selected)
    {
        if (selected)
            _selectedAlertIds.Add(alertId);
        else
            _selectedAlertIds.Remove(alertId);
    }

    private async Task AcknowledgeAlert(int alertId)
    {
        await Api.AcknowledgeWarrantyAlertAsync(alertId);
        Snackbar.Success("Alert acknowledged");
        await Task.WhenAll(LoadAlerts(), LoadSummary());
    }

    private async Task AcknowledgeSelected()
    {
        if (_selectedAlertIds.Count == 0) return;

        _acknowledging = true;
        var count = _selectedAlertIds.Count;
        await Api.AcknowledgeWarrantyAlertsBulkAsync(_selectedAlertIds.ToList());
        _acknowledging = false;
        Snackbar.Success($"{count} alerts acknowledged");
        await Task.WhenAll(LoadAlerts(), LoadSummary());
    }

    private string GetAlertBorderClass(WarrantyAlertType type) => type switch
    {
        WarrantyAlertType.Expired => "border-red-200 dark:border-red-900/50",
        WarrantyAlertType.Expiring => "border-amber-200 dark:border-amber-900/50",
        _ => "border-border"
    };

    private string GetAlertBgClass(WarrantyAlertType type) => type switch
    {
        WarrantyAlertType.Expired => "bg-red-100 dark:bg-red-900/30",
        WarrantyAlertType.Expiring => "bg-amber-100 dark:bg-amber-900/30",
        _ => "bg-muted"
    };

    private string GetDaysClass(int days)
    {
        if (days < 0) return "text-red-600 dark:text-red-400 font-medium";
        if (days <= 30) return "text-amber-600 dark:text-amber-400 font-medium";
        return "text-foreground";
    }
}
