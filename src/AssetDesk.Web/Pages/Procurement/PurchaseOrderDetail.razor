@page "/purchase-orders/{Id:int}"
@using System.Globalization
@using AssetDesk.Shared
@attribute [Authorize]
@inject ApiClient Api
@inject AuthService AuthService
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject SnackbarService Snackbar
@inject PermissionChecker PermissionChecker

<PageTitle>@(_order?.Reference ?? "Purchase Order") - AssetDesk</PageTitle>

<PermissionView Permission="iams:procurement:view" ShowDeniedMessage="true">
@if (_loading)
{
    <div class="space-y-6 animate-pulse">
        <div class="flex items-center gap-4">
            <div class="w-8 h-8 rounded-lg skeleton"></div>
            <div class="h-8 w-48 rounded skeleton"></div>
        </div>
        <div class="bg-card rounded-2xl border border-border p-6">
            <div class="space-y-4">
                <div class="h-6 w-1/3 rounded skeleton"></div>
                <div class="h-4 w-1/2 rounded skeleton"></div>
            </div>
        </div>
    </div>
}
else if (_order is null)
{
    <Card Class="p-6">
        <EmptyState Title="Purchase order not found" Description="It may have been removed, or belongs to another organisation.">
            <a href="/purchase-orders" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-xl font-medium hover:bg-primary/90 transition-all duration-200">
                Back to Purchase Orders
            </a>
        </EmptyState>
    </Card>
}
else
{
    <div class="space-y-4 sm:space-y-6">
        <!-- Header -->
        <div class="flex flex-col gap-4">
            <div class="flex items-center gap-2 sm:gap-4">
                <a href="/purchase-orders" class="p-2 rounded-lg text-muted-foreground hover:text-muted-foreground hover:bg-muted transition-all duration-200">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3 flex-wrap">
                        <h1 class="text-xl sm:text-2xl font-bold text-foreground truncate">@_order.Reference</h1>
                        <Badge Variant="@PurchaseOrderStatusDisplay.Variant(_order.Status)">@PurchaseOrderStatusDisplay.Label(_order.Status)</Badge>
                    </div>
                    <p class="text-sm text-muted-foreground mt-1">@(_order.SupplierName ?? "—")</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                <Button Variant="outline" OnClick="DownloadPdf">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    PDF
                </Button>
                <PermissionView Permission="iams:procurement:manage">
                    @if (CanSend(_order.Status))
                    {
                        @* A draft raised before the supplier was retired is still sendable as far
                           as the workflow is concerned; the server refuses it. Saying so here, next
                           to the disabled control, is the difference between a rule and a surprise.
                           Cancel stays available - that is the way out of this order. *@
                        <Button OnClick="SendOrder" Loading="@_transitioning" Disabled="@(!_order.SupplierIsActive)">Send to Supplier</Button>
                        @if (!_order.SupplierIsActive)
                        {
                            <span class="text-xs text-muted-foreground">@(_order.SupplierName ?? "This supplier") has been deactivated.</span>
                        }
                    }
                    @if (CanReceive(_order.Status))
                    {
                        <Button OnClick="OpenReceiveModal">Receive Goods</Button>
                    }
                    @if (CanCancel(_order.Status))
                    {
                        <Button Variant="outline" Class="border-destructive/30 text-destructive hover:bg-destructive/10 hover:text-destructive" OnClick="() => _showCancelModal = true">
                            Cancel
                        </Button>
                    }
                </PermissionView>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
            <div class="lg:col-span-2 space-y-4 sm:space-y-6">
                <Card>
                    <CardHeader>
                        <CardTitle>Order Details</CardTitle>
                    </CardHeader>
                    <CardContent>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                            <DetailItem Label="Order Date" Value="@_order.OrderDate.ToString("MMM dd, yyyy")" />
                            <DetailItem Label="Expected Date" Value="@(_order.ExpectedDate?.ToString("MMM dd, yyyy") ?? "—")" />
                            <DetailItem Label="Currency" Value="@_order.Currency" />
                            <DetailItem Label="Order Total" Value="@CurrencyFormat.Format(_order.OrderTotal, _order.Currency)" />
                        </div>
                        @if (!string.IsNullOrEmpty(_order.Notes))
                        {
                            <div class="mt-4">
                                <p class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-1">Notes</p>
                                <p class="text-sm text-foreground whitespace-pre-wrap">@_order.Notes</p>
                            </div>
                        }
                    </CardContent>
                </Card>

                <Card Class="overflow-hidden">
                    <div class="p-4 sm:p-5 pb-2">
                        <h3 class="text-lg font-semibold leading-none tracking-tight text-foreground">Lines</h3>
                    </div>
                    <Table>
                        <TableHeader>
                            <TableRow>
                                <TableHead>Device Type</TableHead>
                                <TableHead>Description</TableHead>
                                <TableHead Class="text-right">Ordered</TableHead>
                                <TableHead Class="text-right">Received</TableHead>
                                <TableHead Class="text-right">Outstanding</TableHead>
                                <TableHead Class="text-right">Unit Price</TableHead>
                                <TableHead Class="text-right">Line Total</TableHead>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var line in _order.Lines)
                            {
                                <TableRow @key="line.Id">
                                    <TableCell>@line.DeviceType</TableCell>
                                    <TableCell>@(line.Description ?? "—")</TableCell>
                                    <TableCell Class="text-right">@line.Quantity</TableCell>
                                    <TableCell Class="text-right">@line.ReceivedQuantity</TableCell>
                                    <TableCell Class="text-right">
                                        @if (line.OutstandingQuantity > 0)
                                        {
                                            <span class="text-amber-600 dark:text-amber-400">@line.OutstandingQuantity</span>
                                        }
                                        else
                                        {
                                            <span>0</span>
                                        }
                                    </TableCell>
                                    @* Always the order's own currency - a USD order showing peso
                                       signs here is the exact bug the multi-currency review caught. *@
                                    <TableCell Class="text-right">@CurrencyFormat.Format(line.UnitPrice, _order.Currency)</TableCell>
                                    <TableCell Class="text-right">@CurrencyFormat.Format(line.LineTotal, _order.Currency)</TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                </Card>
            </div>

            <div class="space-y-4 sm:space-y-6">
                <Card>
                    <CardHeader>
                        <CardTitle>Delivery Progress</CardTitle>
                    </CardHeader>
                    <CardContent>
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between">
                                <span class="text-muted-foreground">Units ordered</span>
                                <span class="text-foreground font-medium">@_order.Lines.Sum(l => l.Quantity)</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-muted-foreground">Units received</span>
                                <span class="text-foreground font-medium">@_order.Lines.Sum(l => l.ReceivedQuantity)</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-muted-foreground">Units outstanding</span>
                                <span class="text-foreground font-medium">@_order.Lines.Sum(l => l.OutstandingQuantity)</span>
                            </div>
                        </div>
                    </CardContent>
                </Card>

                <Card>
                    <CardHeader>
                        <CardTitle>Deliveries</CardTitle>
                    </CardHeader>
                    <CardContent>
                        @if (_order.Receipts.Count == 0)
                        {
                            <p class="text-sm text-muted-foreground">No deliveries recorded yet.</p>
                        }
                        else
                        {
                            <div class="space-y-2">
                                @foreach (var receipt in _order.Receipts)
                                {
                                    <div class="rounded-xl border border-border p-3" @key="receipt.Id">
                                        <div class="flex justify-between gap-3">
                                            <span class="text-sm font-medium text-foreground whitespace-nowrap">@receipt.ReceiptDate.ToString("MMM dd, yyyy")</span>
                                            <span class="text-sm font-medium text-foreground text-right">@ReceiptSummary(receipt)</span>
                                        </div>
                                        @if (_order.Currency != CurrencyFormat.Php)
                                        {
                                            @* Only for a foreign-currency order: a peso order is always booked at 1,
                                               so showing it would be noise. Same wording as the receive modal's
                                               label - this is the rate that batch was actually booked at, and it is
                                               what reconciles the delivery against its invoice. *@
                                            <p class="text-xs text-muted-foreground mt-1">
                                                @CurrencyFormat.Format(receipt.ExchangeRate, CurrencyFormat.Php) per 1 @_order.Currency
                                            </p>
                                        }
                                        <p class="text-xs text-muted-foreground mt-1">
                                            @* The description, where there is one, because two lines of the same device
                                               type - two laptop models - would otherwise read identically here. A software
                                               line names the licence it went to, since it produced no assets to find. *@
                                            @string.Join(", ", receipt.Lines.Select(LineSummary))
                                        </p>
                                        @if (!string.IsNullOrEmpty(receipt.Notes))
                                        {
                                            <p class="text-xs text-muted-foreground mt-1 whitespace-pre-wrap">@receipt.Notes</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </CardContent>
                </Card>
            </div>
        </div>
    </div>

    <!-- Receive Modal -->
    <Modal IsOpen="@_showReceiveModal" Title="Receive Goods" OnClose="CloseReceiveModal" Size="lg">
        <ChildContent>
            <div class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <FormField LabelText="Receipt Date">
                        <Input Type="date" @bind-Value="_receiptDate" />
                    </FormField>
                    @if (_order.Currency != CurrencyFormat.Php)
                    {
                        <FormField LabelText="@($"Exchange Rate ({CurrencyFormat.SymbolFor(CurrencyFormat.Php)} per 1 {_order.Currency})")" Required="true">
                            <Input Type="number" @bind-Value="_exchangeRate" Placeholder="58.20" Required="true" />
                        </FormField>
                    }
                </div>

                <FormField LabelText="Notes">
                    <Textarea Value="@_receiveNotes" ValueChanged="v => _receiveNotes = v" Rows="2" Placeholder="Invoice number, delivery notes..." Class="resize-none" />
                </FormField>

                <div class="space-y-2">
                    <label class="block text-sm font-medium text-foreground">Lines received</label>
                    <div class="space-y-2">
                        @foreach (var line in _receiveLines)
                        {
                            <div class="rounded-xl border border-border p-3 space-y-3">
                                <div class="flex items-end gap-3">
                                    <div class="flex-1">
                                        <p class="text-sm font-medium text-foreground">@(line.Line.Description ?? line.Line.DeviceType)</p>
                                        <p class="text-xs text-muted-foreground">
                                            @line.Line.DeviceType - outstanding: @line.Line.OutstandingQuantity of @line.Line.Quantity
                                        </p>
                                    </div>
                                    <div class="w-24">
                                        <FormField LabelText="Qty">
                                            <Input Type="number" Value="@line.QuantityReceived" ValueChanged="v => line.QuantityReceived = v ?? string.Empty" Min="0" Max="@line.Line.OutstandingQuantity.ToString()" />
                                        </FormField>
                                    </div>
                                </div>

                                @if (line.IsSoftware)
                                {
                                    @if (!_canSeeLicences)
                                    {
                                        <p class="text-xs text-muted-foreground">
                                            Software is received onto a licence rather than as assets, which needs permission to view licences.
                                        </p>
                                    }
                                    else
                                    {
                                        var chosenLicence = ChosenLicence(line);
                                        var renewing = line.Mode == LicenceReceiptModes.Renew;

                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                            <FormField LabelText="Licence" Required="true">
                                                <Select Value="@line.LicenceChoice" ValueChanged="v => OnLicenceChosen(line, v)" Placeholder="Choose a licence">
                                                    @foreach (var licence in _licences)
                                                    {
                                                        <option value="@licence.Id">@licence.Name</option>
                                                    }
                                                    @if (_canCreateLicences)
                                                    {
                                                        <option value="@NewLicenceChoice">New licence…</option>
                                                    }
                                                </Select>
                                            </FormField>
                                            <FormField LabelText="This delivery">
                                                <Select Value="@line.Mode" ValueChanged="v => line.Mode = v ?? LicenceReceiptModes.AddSeats" Disabled="@(line.LicenceChoice == NewLicenceChoice)">
                                                    <option value="@LicenceReceiptModes.AddSeats">Adds seats</option>
                                                    <option value="@LicenceReceiptModes.Renew">Renews existing seats</option>
                                                </Select>
                                            </FormField>
                                        </div>

                                        @if (line.LicenceChoice == NewLicenceChoice)
                                        {
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                <FormField LabelText="New licence name" Required="true">
                                                    <Input Value="@line.NewName" ValueChanged="v => line.NewName = v" MaxLength="200" />
                                                </FormField>
                                                <FormField LabelText="Publisher">
                                                    <Input Value="@line.NewPublisher" ValueChanged="v => line.NewPublisher = v" MaxLength="200" />
                                                </FormField>
                                                <FormField LabelText="Counted">
                                                    <Select Value="@line.NewModel" ValueChanged="v => line.NewModel = v ?? LicenceModels.PerUser">
                                                        @foreach (var model in LicenceModels.All)
                                                        {
                                                            <option value="@model">@LicenceModels.Label(model)</option>
                                                        }
                                                    </Select>
                                                </FormField>
                                            </div>
                                        }

                                        @* Only a renewal moves an existing expiry, and only forward - the API refuses
                                           anything else, so the field offered here never asks for a choice the server
                                           would reject. Adding seats to a licence that already has a term takes that
                                           term outright: no field, just the fact stated plainly. *@
                                        @if (renewing)
                                        {
                                            <div class="space-y-1">
                                                @if (chosenLicence?.ExpiresAt is { } currentExpiry)
                                                {
                                                    <p class="text-xs text-muted-foreground">Currently runs until @currentExpiry.ToString("MMM dd, yyyy")</p>
                                                }
                                                <FormField LabelText="Renewed until" Required="true">
                                                    <Input Type="date" Value="@line.ExpiresAt" ValueChanged="v => line.ExpiresAt = v" />
                                                </FormField>
                                            </div>
                                        }
                                        else if (line.LicenceChoice == NewLicenceChoice || chosenLicence?.ExpiresAt is null)
                                        {
                                            <FormField LabelText="Expires (optional)">
                                                <Input Type="date" Value="@line.ExpiresAt" ValueChanged="v => line.ExpiresAt = v" />
                                            </FormField>
                                        }
                                        else
                                        {
                                            <p class="text-xs text-muted-foreground">
                                                Runs until @chosenLicence.ExpiresAt.Value.ToString("MMM dd, yyyy") - added seats take that term.
                                            </p>
                                        }
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_receiveError))
                {
                    <Alert Variant="destructive">@_receiveError</Alert>
                }
            </div>
        </ChildContent>
        <FooterContent>
            <Button Variant="ghost" OnClick="CloseReceiveModal">Cancel</Button>
            <Button OnClick="ReceiveGoods" Loading="@_receiving">Receive</Button>
        </FooterContent>
    </Modal>

    <!-- Cancel Modal -->
    <Modal IsOpen="@_showCancelModal" Title="Cancel Purchase Order" OnClose="() => _showCancelModal = false">
        <ChildContent>
            <p class="text-muted-foreground">
                Cancel <strong>@_order.Reference</strong>? This cannot be undone, and nothing further can be received against it.
            </p>
        </ChildContent>
        <FooterContent>
            <Button Variant="ghost" OnClick="() => _showCancelModal = false">Keep Order</Button>
            <Button Variant="destructive" OnClick="CancelOrder" Loading="@_transitioning">Cancel Order</Button>
        </FooterContent>
    </Modal>
}
</PermissionView>

@code {
    [Parameter] public int Id { get; set; }

    private PurchaseOrderDto? _order;
    private bool _loading = true;
    private bool _transitioning;

    private bool _showCancelModal;

    private bool _showReceiveModal;
    private bool _receiving;
    private string? _receiveError;
    private string _receiptDate = DateTime.Today.ToString("yyyy-MM-dd");
    private string _exchangeRate = "1";
    private string _receiveNotes = "";
    private List<ReceiveLineFormModel> _receiveLines = [];
    private const string NewLicenceChoice = "new";
    private List<SoftwareLicenceDto> _licences = [];
    private bool _canSeeLicences;
    private bool _canCreateLicences;

    protected override async Task OnInitializedAsync()
    {
        // Matches the page's PermissionView gate above - see the identical note on
        // Pages/Procurement/Suppliers.razor.
        if (!await PermissionChecker.HasPermissionAsync("iams:procurement:view"))
        {
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _order = await Api.GetPurchaseOrderAsync(Id);
        _loading = false;
    }

    // These three mirror PurchaseOrderWorkflow.CanTransition/IsOpen on the API side - the server
    // enforces the actual rule regardless, so this is only hiding actions that would otherwise
    // be guaranteed to fail, not reimplementing the workflow.
    private static bool CanSend(string status) => status == "Draft";
    private static bool CanCancel(string status) => status is "Draft" or "Ordered" or "PartiallyReceived";
    private static bool CanReceive(string status) => status is "Ordered" or "PartiallyReceived";

    // The receiver is null when the account that recorded the delivery no longer exists; the
    // count then stands alone rather than naming nobody.
    private static string ReceiptSummary(GoodsReceiptDto receipt) =>
        receipt.ReceivedByName is { } name
            ? $"{Units(receipt.TotalUnits)}, received by {name}"
            : Units(receipt.TotalUnits);

    private static string Units(int count) => count == 1 ? "1 unit" : $"{count} units";

    private async Task SendOrder()
    {
        _transitioning = true;
        var (success, error) = await Api.SendPurchaseOrderAsync(Id);
        _transitioning = false;

        if (success)
        {
            Snackbar.Success("Purchase order sent to supplier");
            await LoadAsync();
        }
        else
        {
            Snackbar.Error(error ?? "Failed to send purchase order");
        }
    }

    private async Task CancelOrder()
    {
        _transitioning = true;
        var (success, error) = await Api.CancelPurchaseOrderAsync(Id);
        _transitioning = false;
        _showCancelModal = false;

        if (success)
        {
            Snackbar.Success("Purchase order cancelled");
            await LoadAsync();
        }
        else
        {
            Snackbar.Error(error ?? "Failed to cancel purchase order");
        }
    }

    private async Task OpenReceiveModal()
    {
        if (_order is null) return;

        _receiptDate = DateTime.Today.ToString("yyyy-MM-dd");
        // A peso order always books at 1 - the field for it is hidden entirely, see the markup.
        // A foreign-currency order starts EMPTY rather than at "1": pre-filling 1 hid the
        // Placeholder="58.20" hint and let a USD delivery get booked at parity with pesos
        // without the user ever having typed a rate. Leaving it blank forces a deliberate entry.
        _exchangeRate = _order.Currency == CurrencyFormat.Php ? "1" : "";
        _receiveNotes = "";
        _receiveError = null;

        // Pre-fill each line with what is still outstanding - the point of this form is
        // receiving what has not arrived yet, not re-entering the whole order.
        _receiveLines = _order.Lines
            .Where(l => l.OutstandingQuantity > 0)
            .Select(l => new ReceiveLineFormModel
            {
                Line = l,
                QuantityReceived = l.OutstandingQuantity.ToString(),
                // The order line's description is usually the product name - a sensible start for a
                // licence created from it.
                NewName = l.Description ?? ""
            })
            .ToList();

        // Software lines go onto a licence, which needs licence access to choose. Asked only when
        // the delivery has a software line, so receiving laptops never touches the licence API.
        if (_receiveLines.Any(l => l.IsSoftware))
        {
            _canSeeLicences = await PermissionChecker.HasPermissionAsync("iams:licences:view");
            _canCreateLicences = await PermissionChecker.HasPermissionAsync("iams:licences:manage");
            _licences = _canSeeLicences
                ? (await Api.GetLicencesAsync()).Where(l => l.IsActive).ToList()
                : [];
        }

        _showReceiveModal = true;
    }

    // Small helper rather than repeating this lookup wherever the dialog needs to know what the
    // chosen licence already carries (its expiry, mainly) - the "new licence" choice has nothing
    // to look up and always resolves to null.
    private SoftwareLicenceDto? ChosenLicence(ReceiveLineFormModel line) =>
        line.LicenceChoice != NewLicenceChoice && int.TryParse(line.LicenceChoice, CultureInfo.InvariantCulture, out var id)
            ? _licences.FirstOrDefault(l => l.Id == id)
            : null;

    private static void OnLicenceChosen(ReceiveLineFormModel line, string? choice)
    {
        line.LicenceChoice = choice ?? "";
        // A date typed for one licence must not silently apply to a different one once the
        // choice changes.
        line.ExpiresAt = "";
        // A renewal needs a licence that already exists; the API refuses the combination, so the
        // dialog does not offer it.
        if (line.LicenceChoice == NewLicenceChoice)
            line.Mode = LicenceReceiptModes.AddSeats;
    }

    private void CloseReceiveModal() => _showReceiveModal = false;

    private async Task ReceiveGoods()
    {
        _receiveError = null;

        var lines = new List<ReceiveLineDto>();
        foreach (var line in _receiveLines)
        {
            if (!int.TryParse(line.QuantityReceived, NumberStyles.Integer, CultureInfo.InvariantCulture, out var quantity) || quantity <= 0)
                continue;

            var receiveLine = new ReceiveLineDto { PurchaseOrderLineId = line.Line.Id, QuantityReceived = quantity };

            if (line.IsSoftware)
            {
                var label = line.Line.Description ?? line.Line.DeviceType;

                if (!_canSeeLicences)
                {
                    _receiveError = $"{label}: receiving software needs permission to view licences.";
                    return;
                }

                if (string.IsNullOrEmpty(line.LicenceChoice))
                {
                    _receiveError = $"{label}: choose the licence these seats belong to.";
                    return;
                }

                var isNew = line.LicenceChoice == NewLicenceChoice;
                var renewing = !isNew && line.Mode == LicenceReceiptModes.Renew;
                DateTime? expiresAt = DateTime.TryParse(line.ExpiresAt, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedExpiry)
                    ? parsedExpiry
                    : null;

                if (renewing && expiresAt is null)
                {
                    _receiveError = $"{label}: enter the date the renewal runs until.";
                    return;
                }

                // Only a renewal moves an existing expiry, and only forward - the same rule the
                // API enforces. Caught here so a bad date never makes the round trip.
                var chosenLicence = ChosenLicence(line);
                if (renewing && chosenLicence?.ExpiresAt is { } current && expiresAt <= current)
                {
                    _receiveError = $"{label}: a renewal must run past {current:MMM dd, yyyy}.";
                    return;
                }

                if (isNew && string.IsNullOrWhiteSpace(line.NewName))
                {
                    _receiveError = $"{label}: name the new licence.";
                    return;
                }

                // Adding seats to a licence that already has a term takes that term outright - the
                // dialog never offers the field in that case, but nothing is sent either way.
                if (!renewing && !isNew && chosenLicence?.ExpiresAt is not null)
                    expiresAt = null;

                receiveLine = receiveLine with
                {
                    SoftwareLicenceId = isNew ? null : int.Parse(line.LicenceChoice, CultureInfo.InvariantCulture),
                    NewLicence = isNew
                        ? new NewLicenceInputDto
                        {
                            Name = line.NewName.Trim(),
                            Publisher = string.IsNullOrWhiteSpace(line.NewPublisher) ? null : line.NewPublisher.Trim(),
                            LicenceModel = line.NewModel
                        }
                        : null,
                    LicenceMode = renewing ? LicenceReceiptModes.Renew : LicenceReceiptModes.AddSeats,
                    LicenceExpiresAt = expiresAt
                };
            }

            lines.Add(receiveLine);
        }

        if (lines.Count == 0)
        {
            _receiveError = "Enter a quantity received for at least one line.";
            return;
        }

        // Always exactly 1 for a peso order - the field is hidden rather than left editable, so
        // there is nothing here for the user to get wrong. For every other currency the field
        // starts empty (see OpenReceiveModal) and there is deliberately no "?? 1m" fallback here:
        // that used to make a blank or unparsable field silently book the delivery at parity with
        // pesos, exactly the mistake the server now refuses outright. A missing or invalid rate
        // is refused here, before the request is even sent.
        decimal exchangeRate;
        if (_order!.Currency == CurrencyFormat.Php)
        {
            exchangeRate = 1m;
        }
        else if (ParseDecimal(_exchangeRate) is { } parsedRate && parsedRate > 0)
        {
            exchangeRate = parsedRate;
        }
        else
        {
            _receiveError = $"Enter the exchange rate ({CurrencyFormat.SymbolFor(CurrencyFormat.Php)} per 1 {_order.Currency}).";
            return;
        }

        _receiving = true;

        var dto = new ReceiveGoodsDto
        {
            ReceiptDate = DateTime.TryParse(_receiptDate, out var receiptDate) ? receiptDate : DateTime.UtcNow,
            ExchangeRate = exchangeRate,
            Notes = string.IsNullOrWhiteSpace(_receiveNotes) ? null : _receiveNotes.Trim(),
            Lines = lines
        };

        // Reuses ApiClient's ReadErrorMessageAsync under the hood - a rejected receipt names
        // which line is over-received and by how much, and that message needs to reach the user
        // verbatim rather than collapse into a generic failure.
        var (success, error) = await Api.ReceiveGoodsAsync(Id, dto);
        _receiving = false;

        if (!success)
        {
            _receiveError = error;
            return;
        }

        Snackbar.Success("Goods received");
        _showReceiveModal = false;
        await LoadAsync();
    }

    private async Task DownloadPdf()
    {
        var url = Api.GetPurchaseOrderPdfUrl(Id);
        var token = await AuthService.GetTokenAsync();
        var baseUrl = (Configuration["ApiBaseUrl"] ?? "https://localhost:5021").TrimEnd('/');
        await JS.InvokeVoidAsync("downloadWithAuth", $"{baseUrl}/{url}", token);
    }

    // Same DOM-value parsing rule as Assets/Edit.razor.ParseDecimal: a number input is always
    // invariant-formatted, so parsing it under CurrentCulture can silently misread the value.
    private static decimal? ParseDecimal(string? value) =>
        decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;

    private static string LineSummary(GoodsReceiptLineDto line)
    {
        var what = $"{line.QuantityReceived} × {(string.IsNullOrWhiteSpace(line.Description) ? line.DeviceType : line.Description)}";
        return line switch
        {
            { RenewedTo: { } until } => $"{what} → renewed to {until:MMM dd, yyyy}",
            { LicenceName: { } name } => $"{what} → added to {name}",
            _ => what
        };
    }

    private sealed class ReceiveLineFormModel
    {
        public required PurchaseOrderLineDto Line { get; set; }
        public string QuantityReceived { get; set; } = "";

        public bool IsSoftware => Line.DeviceType == "Software";

        /// <summary>A licence id, NewLicenceChoice, or empty when nothing is chosen yet.</summary>
        public string LicenceChoice { get; set; } = "";
        public string Mode { get; set; } = LicenceReceiptModes.AddSeats;
        public string ExpiresAt { get; set; } = "";
        public string NewName { get; set; } = "";
        public string NewPublisher { get; set; } = "";
        public string NewModel { get; set; } = LicenceModels.PerUser;
    }
