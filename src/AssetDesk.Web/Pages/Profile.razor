@page "/profile"
@using AssetDesk.Web.Components
@using AssetDesk.Web.Components.UI
@attribute [Authorize]
@inject ApiClient Api
@inject AuthService Auth
@inject SnackbarService Snackbar
@inject NavigationManager Navigation

<PageTitle>My Profile - AssetDesk</PageTitle>

<div class="max-w-3xl space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-foreground">My Profile</h1>
        <p class="text-sm text-muted-foreground">Your account details and security settings</p>
    </div>

    @if (_loading)
    {
        @for (int i = 0; i < 3; i++)
        {
            <Card Class="p-6">
                <div class="flex items-center gap-4">
                    <Skeleton Circle="true" Class="w-14 h-14" />
                    <div class="flex-1 space-y-2">
                        <Skeleton Class="h-4 w-1/3" />
                        <Skeleton Class="h-3 w-1/2" />
                    </div>
                </div>
            </Card>
        }
    }
    else if (_user is null)
    {
        <Card>
            <EmptyState Title="We couldn't load your profile."
                        Description="Something went wrong while fetching your account details.">
                <Icon>
                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </Icon>
                <ChildContent>
                    <Button OnClick="LoadProfile">Try again</Button>
                </ChildContent>
            </EmptyState>
        </Card>
    }
    else
    {
        <!-- Identity -->
        <Card Class="p-6">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                <Avatar Size="xl" Fallback="@_user.FullName" Class="shrink-0" />
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-xl font-semibold text-foreground truncate">@_user.FullName</h2>
                        <RoleBadge Role="@_user.Role" Size="md" />
                    </div>
                    <p class="text-sm text-muted-foreground truncate">@_user.Email</p>
                    @if (!string.IsNullOrEmpty(_user.TenantName))
                    {
                        <p class="text-sm text-muted-foreground truncate">@_user.TenantName</p>
                    }
                </div>
            </div>
        </Card>

        <!-- Personal details -->
        <Card>
            <CardHeader Class="flex-row items-center justify-between space-y-0">
                <CardTitle>Personal details</CardTitle>
                @if (!_editing)
                {
                    <Button Variant="outline" Size="sm" OnClick="StartEditing">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        Edit
                    </Button>
                }
            </CardHeader>
            <CardContent>
                @if (_editing)
                {
                    @if (!string.IsNullOrEmpty(_saveError))
                    {
                        <Alert Variant="destructive" Class="mb-4">@_saveError</Alert>
                    }

                    <div class="space-y-4">
                        <FormField LabelText="Full name" Id="profile-name">
                            <Input Id="profile-name"
                                   Value="@_editName"
                                   ValueChanged="@(v => _editName = v ?? "")"
                                   Disabled="@_saving"
                                   MaxLength="100"
                                   Placeholder="Your full name" />
                        </FormField>
                        <FormField LabelText="Department"
                                   Id="profile-department"
                                   Description="Leave blank if you'd rather not say.">
                            <Input Id="profile-department"
                                   Value="@_editDepartment"
                                   ValueChanged="@(v => _editDepartment = v ?? "")"
                                   Disabled="@_saving"
                                   MaxLength="100"
                                   Placeholder="e.g. Finance" />
                        </FormField>
                        <div class="flex justify-end gap-3 pt-2">
                            <Button Variant="ghost" Disabled="@_saving" OnClick="CancelEditing">Cancel</Button>
                            <Button Loading="@_saving" OnClick="SaveProfile">Save changes</Button>
                        </div>
                    </div>
                }
                else
                {
                    <dl class="divide-y">
                        <div class="flex justify-between gap-4 py-3">
                            <dt class="text-sm text-muted-foreground">Full name</dt>
                            <dd class="text-sm font-medium text-foreground text-right">@_user.FullName</dd>
                        </div>
                        <div class="flex justify-between gap-4 py-3">
                            <dt class="text-sm text-muted-foreground">Department</dt>
                            <dd class="text-sm font-medium text-foreground text-right">
                                @(string.IsNullOrEmpty(_user.Department) ? "Not set" : _user.Department)
                            </dd>
                        </div>
                    </dl>
                }
            </CardContent>
        </Card>

        <!-- Account -->
        <Card>
            <CardHeader>
                <CardTitle>Account</CardTitle>
                <CardDescription>An administrator manages these. Contact your IT team if something looks wrong.</CardDescription>
            </CardHeader>
            <CardContent>
                <dl class="divide-y">
                    <div class="flex justify-between gap-4 py-3">
                        <dt class="text-sm text-muted-foreground">Email</dt>
                        <dd class="text-sm font-medium text-foreground text-right break-all">@_user.Email</dd>
                    </div>
                    <div class="flex justify-between gap-4 py-3">
                        <dt class="text-sm text-muted-foreground">Member since</dt>
                        <dd class="text-sm font-medium text-foreground text-right">@_user.CreatedAt.ToLocalTime().ToString("d MMMM yyyy")</dd>
                    </div>
                    <div class="flex justify-between gap-4 py-3">
                        <dt class="text-sm text-muted-foreground">Status</dt>
                        <dd class="text-right">
                            <Badge Variant="@(_user.IsActive ? "Available" : "Assigned")">
                                @(_user.IsActive ? "Active" : "Inactive")
                            </Badge>
                        </dd>
                    </div>
                </dl>
            </CardContent>
        </Card>

        <!-- Security -->
        <Card>
            <CardHeader>
                <CardTitle>Security</CardTitle>
            </CardHeader>
            <CardContent>
                <div class="divide-y">
                    <div class="flex flex-wrap items-center justify-between gap-3 pb-4">
                        <div>
                            <p class="text-sm font-medium text-foreground">Password</p>
                            <p class="text-sm text-muted-foreground">Change the password you use to sign in.</p>
                        </div>
                        <Button Variant="outline" Size="sm" OnClick="() => _showChangePassword = true">
                            Change password
                        </Button>
                    </div>
                    <div class="flex flex-wrap items-center justify-between gap-3 pt-4">
                        <div>
                            <p class="text-sm font-medium text-foreground">All sessions</p>
                            <p class="text-sm text-muted-foreground">Sign out of every device, including this one. You'll need to sign in again.</p>
                        </div>
                        @if (_confirmingLogoutAll)
                        {
                            <div class="flex items-center gap-2">
                                <Button Variant="ghost" Size="sm" Disabled="@_loggingOutAll" OnClick="() => _confirmingLogoutAll = false">
                                    Cancel
                                </Button>
                                <Button Variant="destructive" Size="sm" Loading="@_loggingOutAll" OnClick="SignOutEverywhere">
                                    @(_loggingOutAll ? "Signing out..." : "Confirm")
                                </Button>
                            </div>
                        }
                        else
                        {
                            <Button Variant="outline"
                                    Size="sm"
                                    Class="border-destructive/30 text-destructive hover:bg-destructive/10 hover:text-destructive"
                                    OnClick="() => _confirmingLogoutAll = true">
                                Sign out everywhere
                            </Button>
                        }
                    </div>
                </div>
            </CardContent>
        </Card>
    }
</div>

<ChangePasswordDialog @bind-IsOpen="_showChangePassword" />

@code {
    private UserDto? _user;
    private bool _loading = true;
    private bool _editing;
    private bool _saving;
    private string? _saveError;
    private string _editName = "";
    private string _editDepartment = "";
    private bool _showChangePassword;
    private bool _confirmingLogoutAll;
    private bool _loggingOutAll;


    protected override async Task OnInitializedAsync() => await LoadProfile();

    private async Task LoadProfile()
    {
        _loading = true;
        _user = await Api.GetMyProfileAsync();
        _loading = false;
    }

    private void StartEditing()
    {
        _editName = _user?.FullName ?? "";
        _editDepartment = _user?.Department ?? "";
        _saveError = null;
        _editing = true;
    }

    private void CancelEditing()
    {
        _editing = false;
        _saveError = null;
    }

    private async Task SaveProfile()
    {
        var name = _editName.Trim();

        // Checked here as well as on the server so the common mistake doesn't cost a round trip.
        if (string.IsNullOrEmpty(name))
        {
            _saveError = "Full name is required";
            return;
        }

        if (name.Length > 100)
        {
            _saveError = "Full name must be 100 characters or fewer";
            return;
        }

        _saving = true;
        _saveError = null;

        try
        {
            var (success, updated, error) = await Api.UpdateProfileAsync(new UpdateProfileDto
            {
                FullName = name,
                Department = _editDepartment.Trim()
            });

            if (!success || updated is null)
            {
                // Stay in edit mode so what they typed isn't thrown away.
                _saveError = error ?? "Failed to update profile";
                return;
            }

            _user = updated;
            await Auth.UpdateCachedUserAsync(updated);
            _editing = false;
            Snackbar.Success("Profile updated");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SignOutEverywhere()
    {
        _loggingOutAll = true;
        try
        {
            var (success, error) = await Api.LogoutAllAsync();
            if (success)
            {
                // RevokeAllUserTokensAsync revokes every refresh token for the user with no
                // exclusion for the caller, so this session is dead too - its access token just
                // hasn't expired yet. Signing out here and now beats leaving the user in a
                // session that works for up to Jwt:ExpireMinutes and then drops them at login
                // with no explanation.
                await Auth.LogoutAsync();
                Navigation.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                Snackbar.Error(error ?? "Failed to sign out");
            }
        }
        finally
        {
            _loggingOutAll = false;
        }
    }
}
