@page "/reports"
@using AssetDesk.Shared
@using AssetDesk.Web.Components.UI
@attribute [Authorize]
@inject ApiClient Api
@inject AuthService AuthService
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject PermissionChecker PermissionChecker

<PageTitle>Reports - AssetDesk</PageTitle>

<PermissionView Permission="iams:reports:view" ShowDeniedMessage="true">
<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-foreground">Asset Reports</h1>
            <p class="text-muted-foreground mt-1">Generate and export asset data reports</p>
        </div>
    </div>

    @* Every report card runs the same three actions, so they share the same button hierarchy:
       Preview is outline, CSV is the primary action, PDF is secondary. The coloured icon tile
       is what tells the four cards apart. *@
    <!-- Report Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
        <!-- Asset Inventory Report -->
        <Card Class="p-5 lg:p-6">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <CardTitle Class="text-lg">Asset Inventory</CardTitle>
                    <CardDescription Class="mt-1">Complete list of all assets with details</CardDescription>

                    <!-- Filters -->
                    <div class="mt-4 grid grid-cols-2 gap-3">
                        <Select Value="@_inventoryDeviceType" ValueChanged="@(v => _inventoryDeviceType = v ?? "")">
                            <option value="">All Device Types</option>
                            @if (_deviceTypes != null)
                            {
                                @foreach (var type in _deviceTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            }
                        </Select>
                        <Select Value="@_inventoryStatus" ValueChanged="@(v => _inventoryStatus = v ?? "")">
                            <option value="">All Statuses</option>
                            @if (_statuses != null)
                            {
                                @foreach (var status in _statuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </Select>
                    </div>

                    <div class="mt-4 grid grid-cols-3 gap-2">
                        <Button Variant="outline" Size="sm" OnClick="ViewInventoryReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            Preview
                        </Button>
                        <Button Size="sm" OnClick="ExportInventoryReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                            CSV
                        </Button>
                        <Button Variant="secondary" Size="sm" OnClick="ExportInventoryPdf">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            PDF
                        </Button>
                    </div>
                </div>
            </div>
        </Card>

        <!-- Assigned Assets by User Report -->
        <Card Class="p-5 lg:p-6">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <CardTitle Class="text-lg">Assigned Assets by User</CardTitle>
                    <CardDescription Class="mt-1">Assets grouped by assigned user</CardDescription>

                    <!-- Filters -->
                    <div class="mt-4">
                        <Select Value="@_assignedUserId" ValueChanged="@(v => _assignedUserId = v ?? "")">
                            <option value="">All Users</option>
                            @if (_users != null)
                            {
                                @foreach (var user in _users)
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            }
                        </Select>
                    </div>

                    <div class="mt-4 grid grid-cols-3 gap-2">
                        <Button Variant="outline" Size="sm" OnClick="ViewAssignedByUserReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            Preview
                        </Button>
                        <Button Size="sm" OnClick="ExportAssignedByUserReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                            CSV
                        </Button>
                        <Button Variant="secondary" Size="sm" OnClick="ExportAssignedByUserPdf">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            PDF
                        </Button>
                    </div>
                </div>
            </div>
        </Card>

        <!-- Warranty Expiry Report -->
        <Card Class="p-5 lg:p-6">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <CardTitle Class="text-lg">Warranty Expiry</CardTitle>
                    <CardDescription Class="mt-1">Assets with warranty information</CardDescription>

                    <!-- Filters -->
                    <div class="mt-4 grid grid-cols-2 gap-3">
                        <Select Value="@_warrantyStatus" ValueChanged="@(v => _warrantyStatus = v ?? "")">
                            <option value="">All Statuses</option>
                            <option value="expired">Expired</option>
                            <option value="expiring">Expiring</option>
                            <option value="active">Active</option>
                        </Select>
                        <Select Value="@_warrantyDaysThreshold" ValueChanged="@(v => _warrantyDaysThreshold = v ?? "")">
                            <option value="">No Threshold</option>
                            <option value="30">Next 30 days</option>
                            <option value="60">Next 60 days</option>
                            <option value="90">Next 90 days</option>
                        </Select>
                    </div>

                    <div class="mt-4 grid grid-cols-3 gap-2">
                        <Button Variant="outline" Size="sm" OnClick="ViewWarrantyExpiryReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            Preview
                        </Button>
                        <Button Size="sm" OnClick="ExportWarrantyExpiryReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                            CSV
                        </Button>
                        <Button Variant="secondary" Size="sm" OnClick="ExportWarrantyExpiryPdf">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            PDF
                        </Button>
                    </div>
                </div>
            </div>
        </Card>

        <!-- Asset Value Report -->
        <Card Class="p-5 lg:p-6">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <CardTitle Class="text-lg">Total Asset Value</CardTitle>
                    <CardDescription Class="mt-1">Asset values by device type and status</CardDescription>

                    @if (_assetValueSummary != null)
                    {
                        <div class="mt-4 p-3 bg-purple-50 dark:bg-purple-900/20 rounded-xl">
                            <div class="text-2xl font-bold text-purple-600 dark:text-purple-400">
                                @FormatCurrency(_assetValueSummary.GrandTotalValue)
                            </div>
                            <div class="text-xs text-purple-600/70 dark:text-purple-400/70">
                                @_assetValueSummary.TotalAssetCount assets
                            </div>
                        </div>
                    }

                    <div class="mt-4 grid grid-cols-3 gap-2">
                        <Button Variant="outline" Size="sm" OnClick="ViewAssetValueReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            Preview
                        </Button>
                        <Button Size="sm" OnClick="ExportAssetValueReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                            CSV
                        </Button>
                        <Button Variant="secondary" Size="sm" OnClick="ExportAssetValuePdf">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            PDF
                        </Button>
                    </div>
                </div>
            </div>
        </Card>

        <!-- Depreciation / Book Value Report -->
        <Card Class="p-5 lg:p-6">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-teal-100 dark:bg-teal-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 text-teal-600 dark:text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <CardTitle Class="text-lg">Book Value (Depreciation)</CardTitle>
                    <CardDescription Class="mt-1">Net book value across the estate, as of today</CardDescription>

                    @if (_depreciationSummary != null)
                    {
                        <div class="mt-4 p-3 bg-teal-100 dark:bg-teal-900/30 rounded-xl">
                            <div class="text-2xl font-bold text-teal-600 dark:text-teal-400">
                                @FormatCurrency(_depreciationSummary.TotalNetBookValue, _depreciationSummary.PrimaryCurrency)
                            </div>
                            <div class="text-xs text-muted-foreground">
                                @_depreciationSummary.DepreciableCount depreciable assets
                            </div>
                        </div>

                        @if (_depreciationSummary.NotDepreciableCount > 0)
                        {
                            <p class="mt-2 text-xs text-muted-foreground">
                                @_depreciationSummary.NotDepreciableCount of @(_depreciationSummary.DepreciableCount + _depreciationSummary.NotDepreciableCount) assets not depreciable
                                — @FormatNotDepreciableReasons(_depreciationSummary.NotDepreciableByReason)
                            </p>
                        }
                    }

                    <div class="mt-4 grid grid-cols-3 gap-2">
                        <Button Variant="outline" Size="sm" OnClick="ViewDepreciationReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            Preview
                        </Button>
                        <Button Size="sm" OnClick="ExportDepreciationReport">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                            CSV
                        </Button>
                        <Button Variant="secondary" Size="sm" OnClick="ExportDepreciationPdf">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            PDF
                        </Button>
                    </div>
                </div>
            </div>
        </Card>
    </div>

    <!-- Report Preview Modal -->
    <Dialog IsOpen="@_showPreview" Title="@_previewTitle" Size="xl" OnClose="ClosePreview">
        <ChildContent>
            @if (_isLoadingPreview)
            {
                <div class="flex items-center justify-center py-12">
                    <Spinner Size="lg" Class="text-primary" />
                </div>
            }
            else
            {
                @_previewContent
            }
        </ChildContent>
        <FooterContent>
            <div class="mt-4 flex justify-end gap-3 border-t pt-4">
                <Button Variant="outline" OnClick="ClosePreview">Close</Button>
            </div>
        </FooterContent>
    </Dialog>
</div>
</PermissionView>

@code {
    private string[]? _deviceTypes;
    private string[]? _statuses;
    private List<UserListItem>? _users;
    private AssetValueSummaryDto? _assetValueSummary;
    private DepreciationSummaryDto? _depreciationSummary;

    private string _inventoryDeviceType = "";
    private string _inventoryStatus = "";
    private string _assignedUserId = "";
    private string _warrantyStatus = "";
    private string _warrantyDaysThreshold = "";

    private bool _showPreview;
    private bool _isLoadingPreview;
    private string _previewTitle = "";
    private RenderFragment? _previewContent;

    protected override async Task OnInitializedAsync()
    {
        // Blazor runs a component's lifecycle regardless of what the wrapping PermissionView
        // decides to render, so a denied user would otherwise still fire every load below.
        if (!await PermissionChecker.HasPermissionAsync("iams:reports:view"))
            return;

        await LoadFilters();
        await LoadAssetValueSummary();
        await LoadDepreciationSummary();
    }

    private async Task LoadFilters()
    {
        try
        {
            _deviceTypes = await Api.GetDeviceTypesAsync();
            _statuses = await Api.GetStatusesAsync();
            _users = await Api.GetUserListAsync();
        }
        catch { }
    }

    private async Task LoadAssetValueSummary()
    {
        try
        {
            _assetValueSummary = await Api.GetAssetValueReportAsync();
        }
        catch { }
    }

    private async Task LoadDepreciationSummary()
    {
        try
        {
            _depreciationSummary = await Api.GetDepreciationReportAsync();
        }
        catch { }
    }

    private async Task ViewInventoryReport()
    {
        _previewTitle = "Asset Inventory Report";
        _showPreview = true;
        _isLoadingPreview = true;
        StateHasChanged();

        try
        {
            var data = await Api.GetInventoryReportAsync(
                string.IsNullOrEmpty(_inventoryDeviceType) ? null : _inventoryDeviceType,
                string.IsNullOrEmpty(_inventoryStatus) ? null : _inventoryStatus);

            _previewContent = BuildTablePreview(data ?? new(), new[] { "Asset Tag", "Type", "Manufacturer", "Model", "Status", "Assigned To", "Value" },
                row => new object[] { row.AssetTag, row.DeviceType, row.Manufacturer ?? "—", row.Model ?? "—", row.Status, row.AssignedTo ?? "—", FormatCurrency(row.PurchasePrice, row.Currency) });
        }
        catch (Exception ex)
        {
            _previewContent = @<div class="text-destructive">Error: @ex.Message</div>;
        }
        _isLoadingPreview = false;
    }

    private async Task ExportInventoryReport()
    {
        await DownloadReport("inventory", BuildInventoryFilters(), pdf: false);
    }

    private async Task ExportInventoryPdf()
    {
        await DownloadReport("inventory", BuildInventoryFilters(), pdf: true);
    }

    private Dictionary<string, string> BuildInventoryFilters()
    {
        var filters = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(_inventoryDeviceType)) filters["deviceType"] = _inventoryDeviceType;
        if (!string.IsNullOrEmpty(_inventoryStatus)) filters["status"] = _inventoryStatus;
        return filters;
    }

    private async Task ViewAssignedByUserReport()
    {
        _previewTitle = "Assigned Assets by User";
        _showPreview = true;
        _isLoadingPreview = true;
        StateHasChanged();

        try
        {
            var data = await Api.GetAssignedByUserReportAsync(string.IsNullOrEmpty(_assignedUserId) ? null : _assignedUserId);
            _previewContent = BuildTablePreview(data ?? new(), new[] { "User", "Department", "Asset Tag", "Type", "Device", "Value" },
                row => new object[] { row.UserName, row.Department ?? "—", row.AssetTag, row.DeviceType, $"{row.Manufacturer ?? ""} {row.Model ?? ""}".Trim(), FormatCurrency(row.PurchasePrice, row.Currency) });
        }
        catch (Exception ex)
        {
            _previewContent = @<div class="text-destructive">Error: @ex.Message</div>;
        }
        _isLoadingPreview = false;
    }

    private async Task ExportAssignedByUserReport()
    {
        await DownloadReport("assigned-by-user", BuildAssignedByUserFilters(), pdf: false);
    }

    private async Task ExportAssignedByUserPdf()
    {
        await DownloadReport("assigned-by-user", BuildAssignedByUserFilters(), pdf: true);
    }

    private Dictionary<string, string> BuildAssignedByUserFilters()
    {
        var filters = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(_assignedUserId)) filters["userId"] = _assignedUserId;
        return filters;
    }

    private async Task ViewWarrantyExpiryReport()
    {
        _previewTitle = "Warranty Expiry Report";
        _showPreview = true;
        _isLoadingPreview = true;
        StateHasChanged();

        try
        {
            int? threshold = string.IsNullOrEmpty(_warrantyDaysThreshold) ? null : int.Parse(_warrantyDaysThreshold);
            var data = await Api.GetWarrantyExpiryReportAsync(string.IsNullOrEmpty(_warrantyStatus) ? null : _warrantyStatus, threshold);
            _previewContent = BuildTablePreview(data ?? new(), new[] { "Asset Tag", "Type", "Device", "Provider", "Expires", "Days", "Status" },
                row => new object[] { row.AssetTag, row.DeviceType, $"{row.Manufacturer ?? ""} {row.Model ?? ""}".Trim(), row.WarrantyProvider ?? "—", row.WarrantyEndDate.ToString("MMM dd, yyyy"), row.DaysRemaining, row.WarrantyStatus });
        }
        catch (Exception ex)
        {
            _previewContent = @<div class="text-destructive">Error: @ex.Message</div>;
        }
        _isLoadingPreview = false;
    }

    private async Task ExportWarrantyExpiryReport()
    {
        await DownloadReport("warranty-expiry", BuildWarrantyFilters(), pdf: false);
    }

    private async Task ExportWarrantyExpiryPdf()
    {
        await DownloadReport("warranty-expiry", BuildWarrantyFilters(), pdf: true);
    }

    private Dictionary<string, string> BuildWarrantyFilters()
    {
        var filters = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(_warrantyStatus)) filters["warrantyStatus"] = _warrantyStatus;
        if (!string.IsNullOrEmpty(_warrantyDaysThreshold)) filters["daysThreshold"] = _warrantyDaysThreshold;
        return filters;
    }

    private async Task ViewAssetValueReport()
