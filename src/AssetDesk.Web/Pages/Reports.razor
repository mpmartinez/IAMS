    private async Task ViewDepreciationReport()
    {
        _previewTitle = "Depreciation Report";
        _showPreview = true;
        _isLoadingPreview = true;
        StateHasChanged();

        try
        {
            var data = await Api.GetDepreciationReportAsync();
            if (data != null)
            {
                _previewContent = @<div>
                    <div class="grid grid-cols-3 gap-4 mb-4">
                        <div class="p-4 bg-muted/50 rounded-xl">
                            <div class="text-sm text-muted-foreground">Cost Basis</div>
                            <div class="text-2xl font-bold text-foreground">@FormatCurrency(data.TotalCostBasis, data.PrimaryCurrency)</div>
                        </div>
                        <div class="p-4 bg-muted/50 rounded-xl">
                            <div class="text-sm text-muted-foreground">Accumulated Depreciation</div>
                            <div class="text-2xl font-bold text-foreground">@FormatCurrency(data.TotalAccumulatedDepreciation, data.PrimaryCurrency)</div>
                        </div>
                        <div class="p-4 bg-teal-100 dark:bg-teal-900/30 rounded-xl">
                            <div class="text-sm text-teal-600 dark:text-teal-400">Net Book Value</div>
                            <div class="text-2xl font-bold text-teal-600 dark:text-teal-400">@FormatCurrency(data.TotalNetBookValue, data.PrimaryCurrency)</div>
                        </div>
                    </div>

                    @* The point of this report: a total that silently dropped the assets it could not
                       compute would look authoritative and would not be. Show the gap and why. *@
                    @if (data.NotDepreciableCount > 0)
                    {
                        <p class="mb-4 text-sm text-muted-foreground">
                            @data.NotDepreciableCount of @(data.DepreciableCount + data.NotDepreciableCount) assets not depreciable
                            — @FormatNotDepreciableReasons(data.NotDepreciableByReason)
                        </p>
                    }

                    <Table>
                        <TableHeader>
                            <TableRow>
                                <TableHead>Asset Tag</TableHead>
                                <TableHead>Type</TableHead>
                                <TableHead Class="text-right">Cost Basis</TableHead>
                                <TableHead Class="text-right">Accumulated</TableHead>
                                <TableHead Class="text-right">Net Book Value</TableHead>
                                <TableHead>State</TableHead>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var row in data.Rows.Take(50))
                            {
                                <TableRow>
                                    <TableCell Class="text-foreground">@row.AssetTag</TableCell>
                                    <TableCell Class="text-muted-foreground">@row.DeviceType</TableCell>
                                    <TableCell Class="text-right">@FormatCurrency(row.CostBasis, data.PrimaryCurrency)</TableCell>
                                    <TableCell Class="text-right text-muted-foreground">@FormatCurrency(row.AccumulatedDepreciation, data.PrimaryCurrency)</TableCell>
                                    <TableCell Class="text-right font-medium">@FormatCurrency(row.NetBookValue, data.PrimaryCurrency)</TableCell>
                                    <TableCell Class="text-muted-foreground">
                                        @if (row.IsDepreciable)
                                        {
                                            @(row.IsFullyDepreciated ? "Fully depreciated" : "Depreciating")
                                        }
                                        else
                                        {
                                            @row.NotDepreciableReason
                                        }
                                    </TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                    @if (data.Rows.Count > 50)
                    {
                        <div class="mt-4 text-center text-sm text-muted-foreground">Showing first 50 of @data.Rows.Count rows</div>
                    }
                </div>;
            }
        }
        catch (Exception ex)
        {
            _previewContent = @<div class="text-destructive">Error: @ex.Message</div>;
        }
        _isLoadingPreview = false;
    }

    private async Task ExportDepreciationReport()
    {
        await DownloadReport("depreciation", null, pdf: false);
    }

    private async Task ExportDepreciationPdf()
    {
        await DownloadReport("depreciation", null, pdf: true);
    }

    private RenderFragment BuildTablePreview<T>(List<T> data, string[] headers, Func<T, object[]> rowMapper) => @<div>
        <div class="mb-4 text-sm text-muted-foreground">@data.Count rows</div>
        <Table>
            <TableHeader>
                <TableRow>
                    @foreach (var h in headers)
                    {
                        <TableHead Class="px-3">@h</TableHead>
                    }
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var row in data.Take(50))
                {
                    var cells = rowMapper(row);
                    <TableRow>
                        @foreach (var cell in cells)
                        {
                            <TableCell Class="px-3 text-muted-foreground">@cell</TableCell>
                        }
                    </TableRow>
                }
            </TableBody>
        </Table>
        @if (data.Count > 50)
        {
            <div class="mt-4 text-center text-sm text-muted-foreground">Showing first 50 of @data.Count rows</div>
        }
    </div>;

    private void ClosePreview()
    {
        _showPreview = false;
        _previewContent = null;
    }

    private async Task DownloadReport(string reportType, Dictionary<string, string>? filters, bool pdf)
    {
        var url = pdf
            ? Api.GetReportPdfUrl(reportType, filters)
            : Api.GetReportExportUrl(reportType, filters);
        var token = await AuthService.GetTokenAsync();
        var baseUrl = (Configuration["ApiBaseUrl"] ?? "https://localhost:5021").TrimEnd('/');
        await JS.InvokeVoidAsync("downloadWithAuth", $"{baseUrl}/{url}", token);
    }

    // Totals are pesos; a row renders in whatever it was booked in. Callers passing a row
    // amount supply that row's currency, callers passing a total supply PrimaryCurrency.
    private static string FormatCurrency(decimal? value, string? currency = CurrencyFormat.Php) =>
        CurrencyFormat.Format(value, currency);

    // Reasons read as full sentences elsewhere (CSV/PDF), e.g. "No purchase date". Lead with the
    // count instead - "9 no purchase date" - so it reads as a clause, not two sentences mashed together.
    private static string FormatNotDepreciableReasons(IEnumerable<NotDepreciableReasonCount> reasons) =>
        string.Join(", ", reasons.Select(r => $"{r.Count} {LowercaseFirst(r.Reason)}"));

    private static string LowercaseFirst(string s) =>
        s.Length == 0 ? s : char.ToLowerInvariant(s[0]) + s[1..];
}
