                        </div>
                        <div class="p-4 bg-muted/50 rounded-xl">
                            <div class="text-sm text-muted-foreground">Total Assets</div>
                            <div class="text-2xl font-bold text-foreground">@data.TotalAssetCount</div>
                        </div>
                        <div class="p-4 bg-muted/50 rounded-xl">
                            <div class="text-sm text-muted-foreground">Average</div>
