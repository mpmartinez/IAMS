@page "/"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionChecker PermissionChecker

<PageTitle>Dashboard - AssetDesk</PageTitle>

<div class="space-y-4 sm:space-y-6">
    <!-- Header -->
    <div class="flex flex-col gap-3">
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">Dashboard</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Welcome back, @_userName</p>
        </div>
    </div>

    @* Which dashboard you get follows iams:assets:view, not your role name, so Management and any
       custom ticket-only role land on the self-service view alongside Employee. The two components
       call different endpoints - GET /api/dashboard is gated on this same permission and 403s for
       anyone without it - so this must be resolved before either renders, not after. *@
    @if (_canViewEstate is true)
    {
        <EstateDashboard />
    }
    else if (_canViewEstate is false)
    {
        <MyDashboard />
    }
</div>

@code {
    private string _userName = "";
    private bool? _canViewEstate;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Try to get name from various claim types
        _userName = user.FindFirst("name")?.Value
            ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
            ?? user.FindFirst("given_name")?.Value
            ?? user.Identity?.Name?.Split('@').FirstOrDefault()
            ?? "User";

        // Get first name only
        _userName = _userName.Split(' ').FirstOrDefault() ?? "User";

        // Reads claims already in memory, so this resolves without a round trip - the null state
        // above is a single frame, not a visible flash.
        _canViewEstate = await PermissionChecker.HasPermissionAsync("iams:assets:view");
    }
}
