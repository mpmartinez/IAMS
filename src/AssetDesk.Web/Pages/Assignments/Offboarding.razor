@page "/users/{UserId}/offboarding"
@using AssetDesk.Shared
@using AssetDesk.Web.Components.UI
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject SnackbarService Snackbar
@inject PermissionChecker PermissionChecker

<PageTitle>Offboarding - AssetDesk</PageTitle>

<PermissionView Permission="iams:assignments:return" ShowDeniedMessage="true">
<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-4">
        <Button Variant="ghost" Size="icon" Class="text-muted-foreground" OnClick="GoBack" aria-label="Back">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </Button>
        <div class="flex-1">
            <h1 class="text-2xl font-bold text-foreground">Offboarding</h1>
            <p class="text-sm text-muted-foreground">Return assets from departing employee</p>
        </div>
    </div>

    @if (_loading)
    {
        <Card Class="p-6">
            <div class="space-y-4">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="flex items-center gap-4 p-4">
                        <div class="w-5 h-5 rounded skeleton"></div>
                        <div class="w-12 h-12 rounded-xl skeleton"></div>
                        <div class="flex-1 space-y-2">
                            <div class="h-4 w-1/3 rounded skeleton"></div>
                            <div class="h-3 w-1/4 rounded skeleton"></div>
                        </div>
                    </div>
                }
            </div>
        </Card>
    }
    else if (_offboarding is null)
    {
        <Card Class="p-6">
            <EmptyState Title="User not found" Description="The user you're looking for doesn't exist." />
        </Card>
    }
    else
    {
        <!-- User Info & Status -->
        <div class="bg-card rounded-2xl border border-border p-6">
            <div class="flex items-center gap-4">
                <Avatar Size="xl" Fallback="@_offboarding.UserName" />
                <div class="flex-1">
                    <h2 class="text-xl font-bold text-foreground">@_offboarding.UserName</h2>
                    <div class="flex items-center gap-3 text-sm text-muted-foreground">
                        @if (_offboarding.Department is not null)
                        {
                            <span>@_offboarding.Department</span>
                            <span class="text-muted-foreground">|</span>
                        }
                        @if (_offboarding.Email is not null)
                        {
                            <span>@_offboarding.Email</span>
                        }
                    </div>
                </div>
                <div class="text-right">
                    @if (_offboarding.IsReadyForOffboarding)
                    {
                        <div class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 rounded-xl">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="font-medium">Ready for Offboarding</span>
                        </div>
                    }
                    else
                    {
                        <div class="inline-flex items-center gap-2 px-4 py-2 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 rounded-xl">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <span class="font-medium">@_offboarding.TotalUnreturnedAssets Unreturned</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (_offboarding.UnreturnedAssets.Count > 0)
        {
            <!-- Summary Stats -->
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-card rounded-2xl border border-border p-5">
                    <p class="text-3xl font-bold text-foreground">@_offboarding.TotalUnreturnedAssets</p>
                    <p class="text-sm text-muted-foreground">Assets to Return</p>
                </div>
                <div class="bg-card rounded-2xl border border-border p-5">
                    <p class="text-3xl font-bold text-foreground">@CurrencyFormat.Format(_offboarding.TotalUnreturnedValue, CurrencyFormat.Php)</p>
                    <p class="text-sm text-muted-foreground">Total Value</p>
                </div>
            </div>

            <!-- Unreturned Assets -->
            <Card Class="p-6">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-3">
                        <Checkbox Value="@_selectAll" ValueChanged="OnSelectAllChanged" />
                        <span class="text-sm text-muted-foreground">
                            @if (_selectedAssets.Count > 0)
                            {
                                <span>@_selectedAssets.Count selected</span>
                            }
                            else
                            {
                                <span>Select all</span>
                            }
                        </span>
                    </div>
                    @if (_selectedAssets.Count > 0)
                    {
                        <Button OnClick="ShowReturnModal">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Return Selected (@_selectedAssets.Count)
                        </Button>
                    }
                </div>

                <div class="divide-y divide-border -mx-6 -mb-6 border-t border-border">
                    @foreach (var asset in _offboarding.UnreturnedAssets)
                    {
                        <div class="flex items-center gap-4 px-6 py-4 hover:bg-muted/50 transition-colors">
                            <Checkbox Value="@_selectedAssets.Contains(asset.AssetId)"
                                      ValueChanged="_ => ToggleAsset(asset.AssetId)" />

                            <div class="w-12 h-12 rounded-xl @GetDeviceTypeBg(asset.DeviceType) flex items-center justify-center">
                                <svg class="w-6 h-6 @GetDeviceTypeColor(asset.DeviceType)" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>

                            <div class="flex-1 min-w-0">
                                <p class="font-medium text-foreground truncate">@asset.DisplayName</p>
                                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                                    <span class="font-mono">@asset.AssetTag</span>
                                    @if (asset.SerialNumber is not null)
                                    {
                                        <span class="text-muted-foreground">|</span>
                                        <span class="font-mono text-xs">@asset.SerialNumber</span>
                                    }
                                </div>
                            </div>

                            <div class="text-right hidden sm:block">
                                @if (asset.PurchasePrice.HasValue)
                                {
                                    <p class="font-medium text-foreground">@CurrencyFormat.Format(asset.PurchasePrice, asset.Currency)</p>
                                }
                                <p class="text-xs text-muted-foreground">@asset.DaysAssigned days assigned</p>
                            </div>

                            <Button Variant="ghost" Size="icon" Title="Return this asset" Class="text-muted-foreground" OnClick="() => ReturnSingleAsset(asset.AssetId)">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </Button>
                        </div>
                    }
                </div>
            </Card>
        }
        else
        {
            <!-- All Clear -->
            <Card Class="p-6">
                <div class="text-center py-12">
                    <div class="w-20 h-20 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mx-auto mb-4">
                        <svg class="w-10 h-10 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-foreground mb-2">All Assets Returned</h3>
                    <p class="text-muted-foreground">This user has no unreturned assets. They're ready for offboarding.</p>
                </div>
            </Card>
        }
    }
</div>

<!-- Return Modal -->
@if (_showReturnModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" @onclick="HideReturnModal"></div>
        <div class="relative w-full max-w-md bg-card rounded-2xl p-6 animate-scale-in">
            <h3 class="text-lg font-semibold text-foreground mb-4">Return Assets</h3>

            <div class="space-y-4">
                <FormField LabelText="Condition">
                    <Select Value="@_returnCondition" ValueChanged="@(v => _returnCondition = v ?? "Good")">
                        <option value="Good">Good - Ready for reuse</option>
                        <option value="NeedsRepair">Needs Repair</option>
                        <option value="Damaged">Damaged</option>
                        <option value="Lost">Lost</option>
                    </Select>
                </FormField>

                <FormField LabelText="Notes (Optional)">
                    <Textarea Value="@_returnNotes"
                              ValueChanged="@(v => _returnNotes = v ?? "")"
                              Rows="3"
                              Placeholder="Any notes about the return..."
                              Class="resize-none" />
                </FormField>

                <div class="bg-muted/50 rounded-xl p-4 text-sm">
                    <p class="text-muted-foreground">
                        <strong>@_selectedAssets.Count assets</strong> will be returned and marked as @(_returnCondition == "Good" ? "Available" : _returnCondition == "Lost" ? "Lost" : "Maintenance").
                    </p>
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <Button Variant="outline" Class="flex-1" OnClick="HideReturnModal">
                    Cancel
                </Button>
                <Button Class="flex-1" Loading="@_processing" OnClick="ConfirmBulkReturn">
                    @if (_processing)
                    {
                        <span>Returning...</span>
                    }
                    else
                    {
                        <span>Confirm Return</span>
                    }
                </Button>
            </div>
        </div>
    </div>
}
</PermissionView>

@code {
    [Parameter] public string UserId { get; set; } = "";

    private bool _loading = true;
    private bool _processing;
    private bool _showReturnModal;
    private bool _selectAll;
    private OffboardingDto? _offboarding;
    private HashSet<int> _selectedAssets = [];
    private string _returnCondition = "Good";
    private string _returnNotes = "";

    protected override async Task OnInitializedAsync()
    {
        // Matches the page's PermissionView gate above. OnInitializedAsync runs regardless of
        // what PermissionView renders, so without this check a denied user's browser would still
        // fire GetOffboardingSummaryAsync (which throws on the resulting 403) behind a
        // blank/denied page.
        if (!await PermissionChecker.HasPermissionAsync("iams:assignments:return"))
        {
            _loading = false;
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            // GetOffboardingSummaryAsync hits an endpoint gated on iams:assignments:view, which
            // is a different permission from this page's iams:assignments:return gate. A role
            // holding return-but-not-view would otherwise 403 here; fail soft into the existing
            // "user not found"-style empty state below rather than throwing an unhandled error.
            _offboarding = await Api.GetOffboardingSummaryAsync(UserId);
        }
        catch
        {
            _offboarding = null;
        }
        _loading = false;
    }

    private void GoBack() => Navigation.NavigateTo($"/users/{UserId}/assets");

    private void OnSelectAllChanged(bool value)
    {
        _selectAll = value;
        ToggleSelectAll();
    }

    private void ToggleSelectAll()
    {
        if (_selectAll && _offboarding is not null)
        {
            _selectedAssets = _offboarding.UnreturnedAssets.Select(a => a.AssetId).ToHashSet();
        }
        else
        {
            _selectedAssets.Clear();
        }
    }

    private void ToggleAsset(int assetId)
    {
        if (_selectedAssets.Contains(assetId))
            _selectedAssets.Remove(assetId);
        else
            _selectedAssets.Add(assetId);

        _selectAll = _offboarding is not null && _selectedAssets.Count == _offboarding.UnreturnedAssets.Count;
    }

    private void ShowReturnModal()
    {
        _returnCondition = "Good";
        _returnNotes = "";
        _showReturnModal = true;
    }

    private void HideReturnModal() => _showReturnModal = false;

    private async Task ConfirmBulkReturn()
    {
        _processing = true;

        var (success, returned, error) = await Api.BulkReturnAssetsAsync(
            UserId,
            _selectedAssets.ToList(),
            string.IsNullOrWhiteSpace(_returnNotes) ? null : _returnNotes,
            _returnCondition);

        _processing = false;
        _showReturnModal = false;

        if (success)
        {
            Snackbar.Success($"Successfully returned {returned} asset{(returned != 1 ? "s" : "")}");
            _selectedAssets.Clear();
            _selectAll = false;
            await LoadData();
        }
        else
        {
            Snackbar.Error(error ?? "Failed to return assets");
        }
    }

    private void ReturnSingleAsset(int assetId)
    {
        _selectedAssets = [assetId];
        ShowReturnModal();
    }

    private string GetDeviceTypeBg(string deviceType) => deviceType switch
    {
        "Laptop" or "Desktop" => "bg-blue-100 dark:bg-blue-900/30",
        "Monitor" => "bg-purple-100 dark:bg-purple-900/30",
        "Phone" or "Tablet" => "bg-green-100 dark:bg-green-900/30",
        "Printer" => "bg-orange-100 dark:bg-orange-900/30",
        _ => "bg-muted"
    };

    private string GetDeviceTypeColor(string deviceType) => deviceType switch
    {
        "Laptop" or "Desktop" => "text-blue-600 dark:text-blue-400",
        "Monitor" => "text-purple-600 dark:text-purple-400",
        "Phone" or "Tablet" => "text-green-600 dark:text-green-400",
        "Printer" => "text-orange-600 dark:text-orange-400",
        _ => "text-muted-foreground"
    };
}
