@page "/users"
@using AssetDesk.Web.Components.UI
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Navigation
@inject SnackbarService Snackbar
@inject PermissionChecker PermissionChecker

<PageTitle>Users - AssetDesk</PageTitle>

<PermissionView Permission="iams:users:view" ShowDeniedMessage="true">
<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-foreground">Users</h1>
            <p class="text-muted-foreground mt-1">Manage system users and roles</p>
        </div>
        <PermissionView Permission="iams:users:manage">
            @if (_assignableRoles is not null)
            {
                <Button OnClick="OpenAddModal">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Add User
                </Button>
            }
        </PermissionView>
    </div>

    <!-- Search -->
    <div class="relative max-w-md">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground pointer-events-none z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <Input Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search users..." Class="pl-9" />
    </div>

    <!-- Users Table -->
    <Card Class="p-6">
        @if (_loading)
        {
            <div class="space-y-4">
                @for (int i = 0; i < 5; i++)
                {
                    <Skeleton Class="h-16 w-full" />
                }
            </div>
        }
        else if (_users is null || _users.Items.Count == 0)
        {
            <EmptyState Title="No users found" Description="@(string.IsNullOrEmpty(_search) ? "Add your first user to get started." : "Try adjusting your search.")">
                <Icon>
                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </Icon>
            </EmptyState>
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>User</TableHead>
                        <TableHead>Department</TableHead>
                        <TableHead>Role</TableHead>
                        <TableHead>Status</TableHead>
                        <TableHead Class="text-right">Actions</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var user in _users.Items)
                    {
                        <TableRow>
                            <TableCell>
                                <div class="flex items-center gap-3">
                                    <Avatar Size="sm" Fallback="@user.FullName" />
                                    <div>
                                        <div class="font-medium text-foreground">@user.FullName</div>
                                        <div class="text-muted-foreground">@user.Email</div>
                                    </div>
                                </div>
                            </TableCell>
                            <TableCell Class="text-muted-foreground">@(user.Department ?? "—")</TableCell>
                            <TableCell>
                                <RoleBadge Role="@user.Role" Size="md" />
                            </TableCell>
                            <TableCell>
                                <Badge Variant="@(user.IsActive ? "Available" : "Assigned")" Pulse="true">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </Badge>
                            </TableCell>
                            <TableCell>
                                <PermissionView Permission="iams:users:manage">
                                    <div class="flex items-center justify-end gap-1">
                                        <Button Variant="ghost" Size="icon-sm" Title="Edit" OnClick="() => OpenEditModal(user)">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </Button>
                                        <Button Variant="ghost" Size="icon-sm" Title="Send password reset" Class="text-muted-foreground hover:text-amber-600" OnClick="() => OpenResetModal(user)">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                                            </svg>
                                        </Button>
                                        <Button Variant="ghost" Size="icon-sm" Title="Deactivate" Class="text-muted-foreground hover:text-destructive" OnClick="() => OpenDeleteModal(user)">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </Button>
                                    </div>
                                </PermissionView>
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>

            <!-- Pagination -->
            @if (_users.TotalCount > _users.PageSize)
            {
                <div class="mt-4 border-t pt-2">
                    <Pagination CurrentPage="@_users.Page"
                                TotalPages="@((int)Math.Ceiling(_users.TotalCount / (double)_users.PageSize))"
                                OnPageChange="GoToPage"
                                MaxVisiblePages="5" />
                </div>
            }
        }
    </Card>
</div>

<!-- Add/Edit User Modal -->
<Modal IsOpen="@_showModal" Title="@(_isEditing ? "Edit User" : "Add User")" OnClose="CloseModal">
    <ChildContent>
        <div class="space-y-4">
            <FormField LabelText="Full Name" Required="true">
                <Input Value="@_modalModel.FullName"
                       ValueChanged="@(v => _modalModel.FullName = v ?? "")"
                       Placeholder="John Doe" />
            </FormField>
            <FormField LabelText="Email" Required="true">
                <Input Type="email"
                       Value="@_modalModel.Email"
                       ValueChanged="@(v => _modalModel.Email = v ?? "")"
                       Placeholder="john@example.com" />
            </FormField>
            @if (!_isEditing)
            {
                <Alert>
                    <Icon>
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </Icon>
                    <ChildContent>
                        <p class="text-muted-foreground">
                            No password needed. They will be emailed a link to set their own, and cannot sign in until they do.
                        </p>
                    </ChildContent>
                </Alert>
            }
            <FormField LabelText="Department">
                <Input Value="@_modalModel.Department"
                       ValueChanged="@(v => _modalModel.Department = v ?? "")"
                       Placeholder="IT, HR, Finance..." />
            </FormField>
            <FormField LabelText="Role" Required="true">
                <Select Value="@_modalModel.Role" ValueChanged="@(v => _modalModel.Role = v ?? "Staff")">
                    @if (_assignableRoles is null)
                    {
                        <option value="@_modalModel.Role">@_modalModel.Role</option>
                    }
                    else
                    {
                        @foreach (var role in _assignableRoles)
                        {
                            <option value="@role.Name">@role.Name</option>
                        }
                    }
                </Select>
            </FormField>
            @if (_isEditing)
            {
                <Switch Value="@_modalModel.IsActive" ValueChanged="@(v => _modalModel.IsActive = v)">Active</Switch>
            }

            @if (!string.IsNullOrEmpty(_modalError))
            {
                <Alert Variant="destructive">@_modalError</Alert>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <Button Variant="ghost" OnClick="CloseModal">Cancel</Button>
        <Button OnClick="SaveUser" Loading="@_saving">
            @(_isEditing ? "Save Changes" : "Create User")
        </Button>
    </FooterContent>
</Modal>

<!-- Password Reset Confirmation Modal -->
<Dialog IsOpen="@(_showResetModal && _userToReset is not null)" Size="sm" OnClose="CloseResetModal">
    <ChildContent>
        @if (_userToReset is not null)
        {
            <div class="text-center">
                <div class="w-16 h-16 mx-auto rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mb-4">
                    <svg class="w-8 h-8 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-foreground mb-2">Send password reset?</h3>
                <p class="text-sm text-muted-foreground mb-6">
                    A reset link will be emailed to <span class="font-medium text-foreground">@_userToReset.Email</span>.
                    Their current password stops working immediately, and they will be signed out everywhere.
                </p>
                <div class="flex gap-3">
                    <Button Variant="outline" Class="flex-1" OnClick="CloseResetModal">Cancel</Button>
                    <Button OnClick="ConfirmReset" Loading="@_sendingReset" Class="flex-1">Send link</Button>
                </div>
            </div>
        }
    </ChildContent>
</Dialog>

<!-- Delete Confirmation Modal -->
<Dialog IsOpen="@(_showDeleteModal && _userToDelete is not null)" Size="sm" OnClose="CloseDeleteModal">
    <ChildContent>
        @if (_userToDelete is not null)
        {
            <div class="text-center">
                <div class="w-16 h-16 mx-auto rounded-full bg-destructive/10 flex items-center justify-center mb-4">
                    <svg class="w-8 h-8 text-destructive" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-foreground mb-2">Deactivate User?</h3>
                <p class="text-sm text-muted-foreground mb-6">
                    Are you sure you want to deactivate <span class="font-medium text-foreground">@_userToDelete.FullName</span>? They will no longer be able to log in.
                </p>
                <div class="flex gap-3">
                    <Button Variant="outline" Class="flex-1" OnClick="CloseDeleteModal">Cancel</Button>
                    <Button Variant="destructive" OnClick="ConfirmDelete" Loading="@_deleting" Class="flex-1">Deactivate</Button>
                </div>
            </div>
        }
    </ChildContent>
</Dialog>
</PermissionView>

@code {
    private bool _loading = true;
    private string _search = "";
    private int _page = 1;
    private PagedResponse<UserDto>? _users;
    private List<AssignableRoleDto>? _assignableRoles;

    // Modal state
    private bool _showModal;
    private bool _isEditing;
    private bool _saving;
    private string? _modalError;
    private string? _editingUserId;
    private UserFormModel _modalModel = new();

    // Delete modal state
    private bool _showResetModal;
    private bool _sendingReset;
    private UserDto? _userToReset;

    private bool _showDeleteModal;
    private bool _deleting;
    private UserDto? _userToDelete;

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionChecker.HasPermissionAsync("iams:users:view"))
        {
            _loading = false;
            return;
        }

        // Load the primary content first. GetAssignableRolesAsync hits an endpoint gated on
        // iams:users:manage - a separate permission from this page's iams:users:view gate - so a
        // view-only role would otherwise 403 here and, because GetFromJsonAsync throws on a
        // non-success status, never reach LoadUsers() at all.
        await LoadUsers();

        try
        {
            _assignableRoles = await Api.GetAssignableRolesAsync();
        }
        catch
        {
            // View-only roles (or a transient failure) leave this null. The Add User control is
            // gated on iams:users:manage and hidden when the list didn't load (see markup below),
            // and the Edit modal's role <select> already falls back to showing the user's current
            // role as its only option when _assignableRoles is null.
            _assignableRoles = null;
        }
    }

    private async Task LoadUsers()
    {
        _loading = true;
        try
        {
            _users = await Api.GetUsersAsync(_search, _page);
        }
        catch { }
        _loading = false;
    }

    private async Task SearchUsers()
    {
        _page = 1;
        await LoadUsers();
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await SearchUsers();
    }

    private async Task GoToPage(int page)
    {
        _page = page;
        await LoadUsers();
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _editingUserId = null;
        _modalModel = new UserFormModel { Role = "Staff", IsActive = true };
        _modalError = null;
        _showModal = true;
    }

    private void OpenEditModal(UserDto user)
    {
        _isEditing = true;
        _editingUserId = user.Id;
        _modalModel = new UserFormModel
        {
            FullName = user.FullName,
            Email = user.Email,
            Department = user.Department ?? "",
            Role = user.Role,
            IsActive = user.IsActive
        };
        _modalError = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _modalError = null;
    }

    private async Task SaveUser()
    {
        _modalError = null;

        if (string.IsNullOrWhiteSpace(_modalModel.FullName) || string.IsNullOrWhiteSpace(_modalModel.Email))
        {
            _modalError = "Full name and email are required.";
            return;
        }

        _saving = true;

        bool success;
        // Carries the failure reason on error, and on create the invite outcome on success.
        string? message;

        if (_isEditing)
        {
            var dto = new UpdateUserDto
            {
                FullName = _modalModel.FullName,
                Email = _modalModel.Email,
                Department = string.IsNullOrWhiteSpace(_modalModel.Department) ? null : _modalModel.Department,
                Role = _modalModel.Role,
                IsActive = _modalModel.IsActive
            };
            (success, message) = await Api.UpdateUserAsync(_editingUserId!, dto);
        }
        else
        {
            var dto = new CreateUserDto
            {
                FullName = _modalModel.FullName,
                Email = _modalModel.Email,
                Department = string.IsNullOrWhiteSpace(_modalModel.Department) ? null : _modalModel.Department,
                Role = _modalModel.Role
            };
            (success, message) = await Api.CreateUserAsync(dto);
        }

        _saving = false;

        if (success)
        {
            // On create the server's message says whether the invite actually went out; a
            // created-but-not-emailed account still needs the admin to act, so it must not be
            // reported as a plain success.
            if (_isEditing)
                Snackbar.Success("User updated successfully");
            else if (message is not null && message.Contains("could not be sent", StringComparison.OrdinalIgnoreCase))
                Snackbar.Error(message);
            else
                Snackbar.Success(message ?? "User created");

            CloseModal();
            await LoadUsers();
        }
        else
        {
            _modalError = message;
        }
    }

    private void OpenResetModal(UserDto user)
    {
        _userToReset = user;
        _showResetModal = true;
    }

    private void CloseResetModal()
    {
        _showResetModal = false;
        _userToReset = null;
    }

    private async Task ConfirmReset()
    {
        if (_userToReset is null) return;

        _sendingReset = true;

        var (success, message) = await Api.SendPasswordResetAsync(_userToReset.Id);

        _sendingReset = false;

        if (success)
        {
            // The user's IsActive is untouched, but their session state changed - reload so the
            // list reflects anything the server adjusted rather than showing a stale row.
            Snackbar.Success(message ?? "Reset link sent");
            CloseResetModal();
            await LoadUsers();
        }
        else
        {
            // Surfaced verbatim: "check this organisation's email settings" is actionable in a
            // way that a generic failure is not.
            Snackbar.Error(message ?? "Failed to send the reset link");
        }
    }

    private void OpenDeleteModal(UserDto user)
    {
        _userToDelete = user;
        _showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        _showDeleteModal = false;
        _userToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (_userToDelete is null) return;

        _deleting = true;
        var success = await Api.DeleteUserAsync(_userToDelete.Id);
        _deleting = false;

        if (success)
        {
            Snackbar.Success("User deactivated successfully");
            CloseDeleteModal();
            await LoadUsers();
        }
        else
        {
            Snackbar.Error("Failed to deactivate user");
        }
    }



    private class UserFormModel
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Department { get; set; } = "";
        public string Role { get; set; } = "Staff";
        public bool IsActive { get; set; } = true;
    }
}
