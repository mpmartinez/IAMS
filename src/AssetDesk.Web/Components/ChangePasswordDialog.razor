@namespace AssetDesk.Web.Components
@using AssetDesk.Web.Components.UI
@inject AuthService Auth
@inject SnackbarService Snackbar

<Dialog IsOpen="@IsOpen" Title="Change Password" OnClose="Close">
    <ChildContent>
        @* The submit control lives inside the form rather than in the dialog footer so the
           EditForm still owns submission. *@
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit" class="space-y-4">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_error))
            {
                <Alert Variant="destructive">@_error</Alert>
            }

            <FormField LabelText="Current Password" Required="true">
                <PasswordInput Value="@_model.CurrentPassword"
                               ValueChanged="@(v => _model.CurrentPassword = v ?? "")"
                               AutoComplete="current-password"
                               Placeholder="Enter current password" />
                <ValidationMessage For="@(() => _model.CurrentPassword)" class="text-sm text-destructive mt-1" />
            </FormField>

            <FormField LabelText="New Password"
                       Required="true"
                       Description="Must be at least 6 characters with uppercase, lowercase, and number">
                <PasswordInput Value="@_model.NewPassword"
                               ValueChanged="@(v => _model.NewPassword = v ?? "")"
                               AutoComplete="new-password"
                               Placeholder="Enter new password" />
                <ValidationMessage For="@(() => _model.NewPassword)" class="text-sm text-destructive mt-1" />
            </FormField>

            <FormField LabelText="Confirm New Password" Required="true">
                <PasswordInput Value="@_model.ConfirmPassword"
                               ValueChanged="@(v => _model.ConfirmPassword = v ?? "")"
                               AutoComplete="new-password"
                               Placeholder="Confirm new password" />
                <ValidationMessage For="@(() => _model.ConfirmPassword)" class="text-sm text-destructive mt-1" />
            </FormField>

            <div class="flex justify-end gap-3 border-t pt-4">
                <Button Variant="ghost" OnClick="Close">Cancel</Button>
                <Button Type="submit" Loading="@_isLoading">Change Password</Button>
            </div>
        </EditForm>
    </ChildContent>
</Dialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private ChangePasswordModel _model = new();
    private bool _isLoading;
    private string? _error;

    private async Task HandleSubmit()
    {
        _error = null;

        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _error = "New passwords do not match";
            return;
        }

        _isLoading = true;
        try
        {
            var (success, error) = await Auth.ChangePasswordAsync(_model.CurrentPassword, _model.NewPassword);

            if (success)
            {
                Snackbar.Show("Password changed successfully", SnackbarType.Success);
                await Close();
            }
            else
            {
                _error = error ?? "Failed to change password";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Close()
    {
        _model = new();
        _error = null;
        await IsOpenChanged.InvokeAsync(false);
    }

    private class ChangePasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Current password is required")]
        public string CurrentPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "New password is required")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your new password")]
        public string ConfirmPassword { get; set; } = "";
    }
}
