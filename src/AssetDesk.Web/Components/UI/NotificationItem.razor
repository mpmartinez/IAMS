@namespace AssetDesk.Web.Components.UI
@using AssetDesk.Shared.DTOs

<div class="@GetClasses()" @onclick="HandleClick">
    <div class="flex items-start gap-3">
        <!-- Icon based on notification type -->
        <div class="@GetIconWrapperClasses()">
            @switch (Notification.Type)
            {
                case "Warning":
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    break;
                case "Error":
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    break;
                case "Success":
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    break;
                default:
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    break;
            }
        </div>

        <!-- Content -->
        <div class="flex-1 min-w-0">
            <p class="@GetTitleClasses()">@Notification.Title</p>
            <p class="text-sm text-muted-foreground line-clamp-2">@Notification.Message</p>
            <p class="text-xs text-muted-foreground mt-1">@Notification.TimeAgo</p>
        </div>

        <!-- Unread indicator -->
        @if (!Notification.IsRead)
        {
            <div class="h-2 w-2 rounded-full bg-primary shrink-0"></div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public NotificationDto Notification { get; set; } = null!;
    [Parameter] public EventCallback<NotificationDto> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(Notification);
        }
    }

    private string GetClasses()
    {
        var baseClasses = "p-3 cursor-pointer transition-colors";
        var readClasses = Notification.IsRead
            ? "bg-background hover:bg-muted/50"
            : "bg-muted/30 hover:bg-muted/50";
        return $"{baseClasses} {readClasses} {Class}".Trim();
    }

    private string GetIconWrapperClasses()
    {
        var baseClasses = "p-2 rounded-full shrink-0";
        return Notification.Type switch
        {
            "Warning" => $"{baseClasses} bg-warning/10 text-warning",
            "Error" => $"{baseClasses} bg-destructive/10 text-destructive",
            "Success" => $"{baseClasses} bg-green-500/10 text-green-500",
            _ => $"{baseClasses} bg-primary/10 text-primary"
        };
    }

    private string GetTitleClasses()
    {
        var baseClasses = "text-sm truncate";
        return Notification.IsRead
            ? $"{baseClasses} text-foreground"
            : $"{baseClasses} font-medium text-foreground";
    }
}
