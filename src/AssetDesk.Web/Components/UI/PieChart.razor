@namespace AssetDesk.Web.Components.UI
@implements IAsyncDisposable
@inject IJSRuntime JS

<ChartContainer Title="@Title" Description="@Description" Class="@Class" HeightClass="@HeightClass">
    <canvas id="@_canvasId"></canvas>
</ChartContainer>

@code {
    private readonly string _canvasId = $"pie-chart-{Guid.NewGuid():N}";
    private bool _isInitialized;
    private DotNetObjectReference<PieChart>? _dotNetRef;

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string HeightClass { get; set; } = "min-h-[250px]";
    [Parameter] public string[] Labels { get; set; } = Array.Empty<string>();
    [Parameter] public double[] Data { get; set; } = Array.Empty<double>();
    [Parameter] public bool Doughnut { get; set; } = false;
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public string[]? Colors { get; set; }

    /// <summary>
    /// Callback when a slice is clicked. Receives the label of the clicked slice.
    /// </summary>
    [Parameter] public EventCallback<string> OnClick { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeChart();
            _isInitialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isInitialized && Labels.Length > 0 && Data.Length > 0)
            await InitializeChart();
    }

    private async Task InitializeChart()
    {
        if (Labels.Length == 0 || Data.Length == 0) return;

        object config;
        if (OnClick.HasDelegate)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            config = new
            {
                labels = Labels, data = Data, doughnut = Doughnut, showLegend = ShowLegend,
                colors = Colors,
                dotnetHelper = _dotNetRef, clickMethod = "HandleChartClick"
            };
        }
        else
        {
            config = new
            {
                labels = Labels, data = Data, doughnut = Doughnut, showLegend = ShowLegend,
                colors = Colors
            };
        }

        await JS.InvokeVoidAsync("chartInterop.createPieChart", _canvasId, config);
    }

    [JSInvokable]
    public async Task HandleChartClick(string clickInfo)
    {
        await OnClick.InvokeAsync(clickInfo);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("chartInterop.destroyChart", _canvasId); } catch { }
        _dotNetRef?.Dispose();
    }
}
