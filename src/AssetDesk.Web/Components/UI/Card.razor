@namespace AssetDesk.Web.Components.UI

<div class="@GetClasses()" @attributes="AdditionalAttributes">
    @if (HasHeader)
    {
        <div class="flex items-center justify-between gap-3 px-6 py-4 border-b">
            @if (!string.IsNullOrEmpty(Title))
            {
                <h3 class="text-lg font-semibold leading-none tracking-tight">@Title</h3>
            }
            @HeaderContent
        </div>
    }

    @if (HasHeader && !NoPadding)
    {
        @* A titled card owns its own body padding, matching what the component this
           replaced did, so existing pages do not each have to add a CardContent. *@
        <div class="p-6">
            @ChildContent
        </div>
    }
    else
    {
        @ChildContent
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Optional header title. Supplying it renders a bordered header, which is the shape the
    /// component this replaced had. Leave it unset to compose with CardHeader/CardTitle/
    /// CardContent in the usual way - that is the preferred form for new code.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Trailing content in the header row, typically an action button.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Suppresses the body padding a titled card would otherwise apply.</summary>
    [Parameter] public bool NoPadding { get; set; }

    [Parameter] public bool Hoverable { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasHeader => !string.IsNullOrEmpty(Title) || HeaderContent is not null;

    private string BaseClasses => "rounded-xl border bg-card text-card-foreground shadow";

    private string GetClasses()
    {
        var hover = Hoverable ? "transition-shadow hover:shadow-md" : "";
        return $"{BaseClasses} {hover} {Class}".Trim();
    }
}
