@namespace AssetDesk.Web.Components

@* Kept as the app-level wrapper its call sites already use; the chrome itself is the shadcn
   Dialog, so every modal in the app picks up the same tokens, sizing and close affordance. *@
<AssetDesk.Web.Components.UI.Dialog IsOpen="@IsOpen"
                                    Title="@(string.IsNullOrEmpty(Title) ? null : Title)"
                                    Size="@Size"
                                    OnClose="OnClose"
                                    BodyClass="max-h-[70vh]">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <FooterContent>
        @if (FooterContent is not null)
        {
            <div class="mt-4 flex items-center justify-end gap-3 border-t pt-4">
                @FooterContent
            </div>
        }
    </FooterContent>
</AssetDesk.Web.Components.UI.Dialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
