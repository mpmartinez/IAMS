@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ApiClient Api
@inject NetworkStatusService NetworkStatus
@inject SyncService Sync
@inject NotificationService Notifications
@inject ThemeService Theme
@inject IJSRuntime JS
@inject PermissionChecker PermissionChecker
@using AssetDesk.Web.Components
@implements IAsyncDisposable

<div class="flex h-screen overflow-hidden bg-background text-foreground">
    <AuthorizeView>
        <Authorized Context="sidebarAuth">
            <!-- Mobile menu overlay -->
            @if (_mobileMenuOpen)
            {
                <div class="fixed inset-0 z-40 lg:hidden menu-overlay animate-fade-in" @onclick="CloseMobileMenu"></div>
            }

            <!-- Sidebar -->
            <aside class="@SidebarClasses">
        <div class="flex flex-col h-full">
            @* shadcn SidebarHeader: a brand "menu button" - square mark plus stacked name and
               caption. On the rail only the square survives. *@
            <div class="@LogoBarClasses">
                <a href="/" @onclick="CloseMobileMenu" class="@BrandClasses">
                    <div class="flex aspect-square h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                    </div>
                    <div class="@BrandTextClasses">
                        <span class="truncate font-semibold text-sidebar-accent-foreground">IAMS</span>
                        <span class="truncate text-xs text-sidebar-foreground/70">Asset &amp; Service</span>
                    </div>
                </a>
                <button class="lg:hidden ml-auto inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-sidebar-foreground transition-colors hover:bg-sidebar-accent hover:text-sidebar-accent-foreground" @onclick="CloseMobileMenu">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 overflow-y-auto p-2 space-y-1">
                <NavItem Href="/" Icon="home" Label="Dashboard" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />

                @* Self-service portal, for anyone who files tickets but does not work the queue.
                   Keyed on permissions rather than the Employee role name so Management, Auditor,
                   and any custom file-only role get the links too - all three can already use
                   /report and /my-tickets, they just had no way to reach them. *@
                @if (_showSelfServiceLinks)
                {
                    <NavItem Href="/report" Icon="alert-triangle" Label="Report a problem" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                    <NavItem Href="/my-tickets" Icon="clipboard-list" Label="My reports" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                }

                <PermissionView Permission="iams:assets:view">
                    <NavItem Href="/assets" Icon="cube" Label="Assets" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                </PermissionView>
                <PermissionView Permission="iams:tickets:queue">
                    <NavItem Href="/tickets" Icon="wrench" Label="Tickets" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                </PermissionView>
                <NavItem Href="/scan" Icon="qr-scan" Label="Scan QR" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                @* Ungated on purpose: WarrantyAlertsController's reads carry only a bare [Authorize],
                   so every authenticated user may see this page. Gating the link on
                   iams:warranty:manage would hide it from Auditor and Management, who can reach it
                   today - the acknowledge and delete controls on the page itself are what carry
                   that permission. Add an iams:warranty:view key if reads should ever be gated. *@
                <NavItem Href="/warranty-alerts" Icon="shield-exclamation" Label="Warranty Alerts" BadgeCount="@_alertCount" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                <NavItem Href="/notifications" Icon="bell" Label="Notifications" BadgeCount="@Notifications.UnreadCount" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                @* Ungated for the same reason: /categories is a bare [Authorize] page reading
                   endpoints that require no permission. *@
                <NavItem Href="/categories" Icon="tag" Label="Categories" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />

                @if (_showAdminGroup)
                {
                    <div class="mt-2 space-y-1">
                        <div class="mx-2 my-2 h-px bg-sidebar-border"></div>
                        <p class="@SectionLabelClasses">Admin</p>
                        <PermissionView Permission="iams:users:view">
                            <NavItem Href="/users" Icon="users" Label="Users" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                        </PermissionView>
                        <PermissionView Permission="iams:roles:view">
                            <NavItem Href="/admin/roles" Icon="users" Label="Roles" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                        </PermissionView>
                    </div>
                }

                <AuthorizeView Roles="SuperAdmin">
                    <div class="mt-2 space-y-1">
                        <div class="mx-2 my-2 h-px bg-sidebar-border"></div>
                        <p class="@SectionLabelClasses">Platform</p>
                        <NavItem Href="/admin/tenants" Icon="building" Label="Tenants" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                        <NavItem Href="/admin/lookups" Icon="tag" Label="Reference Data" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                        <NavItem Href="/admin/email-settings" Icon="mail" Label="Email Settings" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                    </div>
                </AuthorizeView>

                <PermissionView Permission="iams:reports:view">
                    <div class="mt-2 space-y-1">
                        <div class="mx-2 my-2 h-px bg-sidebar-border"></div>
                        <p class="@SectionLabelClasses">Reports</p>
                        <NavItem Href="/reports" Icon="chart" Label="Asset Reports" Collapsed="_sidebarCollapsed" OnNavigation="CloseMobileMenu" />
                    </div>
                </PermissionView>
            </nav>

            @* Logout lives in the top bar's user menu now - this is the profile shortcut only. *@
            <div class="border-t border-sidebar-border p-2">
                <AuthorizeView>
                    <Authorized Context="userContext">
                        <NavLink href="/profile" @onclick="CloseMobileMenu"
                                 class="@ProfileCardClasses"
                                 title="@(_sidebarCollapsed ? userContext.User.Identity?.Name : null)"
                                 ActiveClass="bg-sidebar-accent text-sidebar-accent-foreground">
                            <div class="flex aspect-square h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sidebar-accent text-sm font-medium text-sidebar-accent-foreground">
                                @userContext.User.Identity?.Name?.FirstOrDefault()
                            </div>
                            <div class="@ProfileDetailsClasses">
                                <p class="truncate text-sm font-medium text-sidebar-accent-foreground">@userContext.User.Identity?.Name</p>
                                <p class="truncate text-xs text-sidebar-foreground/70">
                                    <RoleBadge Role="@(userContext.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")" />
                                </p>
                            </div>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </aside>
        </Authorized>
    </AuthorizeView>

    <!-- Main content -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <AuthorizeView>
            <Authorized Context="headerAuth">
                <!-- Top bar -->
                <header class="flex h-16 shrink-0 items-center gap-2 border-b border-border bg-background px-4 lg:px-6">
            @* shadcn SidebarTrigger: one ghost square that opens the drawer on mobile and
               minimizes the rail on desktop, followed by a vertical separator. *@
            <button class="@TriggerClasses lg:hidden" @onclick="OpenMobileMenu" aria-label="Open menu">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 4v16" />
                </svg>
            </button>

            <button class="@TriggerClasses hidden lg:inline-flex"
                    @onclick="ToggleSidebar"
                    title="@(_sidebarCollapsed ? "Expand menu" : "Minimize menu")"
                    aria-label="@(_sidebarCollapsed ? "Expand menu" : "Minimize menu")"
                    aria-expanded="@((!_sidebarCollapsed).ToString().ToLowerInvariant())">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 4v16" />
                </svg>
            </button>

            <!-- Organization Name -->
            <AuthorizeView>
                <Authorized>
                    @{
                        var tenantName = context.User.FindFirst("tenant_name")?.Value;
                    }
                    @if (!string.IsNullOrEmpty(tenantName))
                    {
                        <div class="mx-1 hidden h-4 w-px shrink-0 bg-border sm:block"></div>
                        <span class="hidden truncate text-sm font-medium sm:block">@tenantName</span>
                    }
                </Authorized>
            </AuthorizeView>

            <div class="flex-1"></div>

            <!-- Theme toggle -->
            <ThemeToggle />

            <!-- Quick actions -->
            <div class="relative">
                <button @onclick="ToggleSearch" class="@IconButtonClasses" aria-label="Search assets">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </button>

                <!-- Search Dropdown -->
                @if (_showSearch)
                {
                    <div class="fixed inset-0 z-40" @onclick="CloseSearch"></div>
                    <div class="absolute right-0 z-50 mt-2 w-80 overflow-hidden rounded-md border border-border bg-popover text-popover-foreground shadow-md animate-slide-down sm:w-96">
                        <div class="p-3 border-b border-border">
                            <div class="relative">
                                <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                                <input @ref="_searchInput"
                                       @bind="_searchQuery"
                                       @bind:event="oninput"
                                       @onkeyup="HandleSearchKeyUp"
                                       type="text"
                                       placeholder="Search assets..."
                                       class="h-9 w-full rounded-md border border-input bg-transparent pl-9 pr-3 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                                @if (_searchLoading)
                                {
                                    <svg class="absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 animate-spin text-muted-foreground" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                }
                            </div>
                        </div>

                        <div class="max-h-80 overflow-y-auto">
                            @if (_searchResults.Any())
                            {
                                @foreach (var asset in _searchResults)
                                {
                                    <a href="/assets/@asset.Id" @onclick="CloseSearch" class="flex items-center gap-3 px-4 py-3 hover:bg-accent transition-colors">
                                        <div class="w-10 h-10 rounded-xl @GetDeviceTypeBg(asset.DeviceType) flex items-center justify-center shrink-0">
                                            @GetDeviceTypeIcon(asset.DeviceType)
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-medium text-foreground truncate">@asset.DisplayName</p>
                                            <p class="text-sm text-muted-foreground truncate">
                                                @asset.AssetTag
                                                @if (!string.IsNullOrEmpty(asset.SerialNumber))
                                                {
                                                    <span class="mx-1">•</span>
                                                    <span>@asset.SerialNumber</span>
                                                }
                                            </p>
                                        </div>
                                        <span class="@GetStatusBadgeClass(asset.Status) px-2 py-0.5 text-xs font-medium rounded-full">@asset.Status</span>
                                    </a>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(_searchQuery) && !_searchLoading)
                            {
                                <div class="py-8 text-center">
                                    <svg class="w-12 h-12 mx-auto text-muted-foreground/40 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                    </svg>
                                    <p class="text-sm text-muted-foreground">No assets found</p>
                                </div>
                            }
                            else if (!_searchLoading)
                            {
                                <div class="py-6 text-center">
                                    <p class="text-sm text-muted-foreground">Type to search for assets</p>
                                    <p class="text-xs text-muted-foreground mt-1">Search by name, tag, or serial number</p>
                                </div>
                            }
                        </div>

                        <!-- View All Link -->
                        @if (_searchResults.Any())
                        {
                            <div class="border-t border-border">
                                <a href="/assets?search=@Uri.EscapeDataString(_searchQuery)" @onclick="CloseSearch" class="block px-4 py-2.5 text-center text-sm font-medium text-primary transition-colors hover:bg-accent">
                                    View all results
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Notifications -->
            <div class="relative">
                <button @onclick="ToggleNotifications" class="@IconButtonClasses relative" aria-label="Notifications">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    @if (Notifications.UnreadCount > 0)
                    {
                        <span class="absolute -right-0.5 -top-0.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-destructive px-1 text-[10px] font-medium tabular-nums text-destructive-foreground">
                            @(Notifications.UnreadCount > 9 ? "9+" : Notifications.UnreadCount.ToString())
                        </span>
                    }
                </button>

                <!-- Notification Dropdown -->
                @if (_showNotifications)
                {
                    <div class="fixed inset-0 z-40" @onclick="CloseNotifications"></div>
                    <div class="absolute right-0 z-50 mt-2 w-80 overflow-hidden rounded-md border border-border bg-popover text-popover-foreground shadow-md animate-slide-down sm:w-96">
                        <!-- Header -->
                        <div class="flex items-center justify-between px-4 py-3 border-b border-border">
                            <h3 class="font-semibold text-foreground">Notifications</h3>
                            <div class="flex items-center gap-2">
                                @if (Notifications.UnreadCount > 0)
                                {
                                    <button @onclick="MarkAllAsRead" class="text-xs font-medium text-primary hover:underline">
                                        Mark all read
                                    </button>
                                }
                                @if (!Notifications.IsConnected)
                                {
                                    <span class="h-2 w-2 rounded-full bg-amber-500" title="Reconnecting..."></span>
                                }
                            </div>
                        </div>

                        <!-- Notifications List -->
                        <div class="max-h-96 overflow-y-auto">
                            @if (Notifications.Notifications.Count == 0)
                            {
                                <div class="py-12 text-center">
                                    <svg class="w-12 h-12 mx-auto text-muted-foreground/40 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                                    </svg>
                                    <p class="text-sm text-muted-foreground">No notifications yet</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var notification in Notifications.Notifications)
                                {
                                    <div @key="notification.Id"
                                         class="@GetNotificationItemClasses(notification)"
                                         @onclick="() => HandleNotificationClick(notification)">
                                        <div class="flex gap-3">
                                            <div class="@GetNotificationIconClasses(notification.Type) w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                                                @if (notification.Type == "Warning")
                                                {
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                                    </svg>
                                                }
                                                else if (notification.Type == "Error")
                                                {
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    </svg>
                                                }
                                                else if (notification.Type == "Success")
                                                {
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    </svg>
                                                }
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm font-medium text-foreground">@notification.Title</p>
                                                <p class="text-sm text-muted-foreground line-clamp-2">@notification.Message</p>
                                                <p class="text-xs text-muted-foreground mt-1">@notification.TimeAgo</p>
                                            </div>
                                            @if (!notification.IsRead)
                                            {
                                                <div class="mt-2 h-2 w-2 shrink-0 rounded-full bg-primary"></div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <!-- View All Link -->
                        <div class="border-t border-border">
                            <a href="/notifications" @onclick="CloseNotifications" class="block px-4 py-2.5 text-center text-sm font-medium text-primary transition-colors hover:bg-accent">
                                View all notifications
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- User menu -->
            <div class="relative">
                <button @onclick="ToggleUserMenu" class="flex items-center gap-2 rounded-md p-1 transition-colors hover:bg-accent"
                        title="Account" aria-label="Account menu">
                    <div class="flex aspect-square h-8 w-8 items-center justify-center rounded-lg bg-muted text-sm font-medium text-foreground">
                        @headerAuth.User.Identity?.Name?.FirstOrDefault()
                    </div>
                    <svg class="hidden h-4 w-4 text-muted-foreground sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                @if (_showUserMenu)
                {
                    <div class="fixed inset-0 z-40" @onclick="CloseUserMenu"></div>
                    <div class="absolute right-0 z-50 mt-2 w-60 overflow-hidden rounded-md border border-border bg-popover text-popover-foreground shadow-md animate-slide-down">
                        <div class="px-4 py-3 border-b border-border">
                            <p class="text-sm font-medium text-foreground truncate">@headerAuth.User.Identity?.Name</p>
                            <p class="text-xs mt-1">
                                <RoleBadge Role="@(headerAuth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")" />
                            </p>
                        </div>

                        <a href="/profile" @onclick="CloseUserMenu" class="mx-1 my-1 flex items-center gap-2 rounded-sm px-2 py-1.5 text-sm transition-colors hover:bg-accent hover:text-accent-foreground">
                            <svg class="h-4 w-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            My profile
                        </a>

                        <div class="border-t border-border">
                            <button @onclick="LogoutFromMenu" class="mx-1 my-1 flex w-[calc(100%-0.5rem)] items-center gap-2 rounded-sm px-2 py-1.5 text-sm text-destructive transition-colors hover:bg-destructive/10">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                                Logout
                            </button>
                        </div>
                    </div>
                }
            </div>
        </header>
            </Authorized>
        </AuthorizeView>

        <!-- Page content -->
        <main class="flex-1 overflow-y-auto p-4 lg:p-6 pb-24 lg:pb-6">
            <div class="animate-fade-in">
                @Body
            </div>
        </main>
    </div>

    <!-- Mobile Bottom Navigation -->
    <AuthorizeView>
        <Authorized Context="mobileNavAuth">
            <nav class="fixed bottom-0 left-0 right-0 z-40 border-t border-border bg-background pb-safe lg:hidden">
                <div class="flex items-center justify-around h-16">
                    <!-- Dashboard -->
                    <a href="/" class="@GetFooterNavClass("/", true)">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        <span class="text-xs mt-1">Home</span>
                    </a>

                    <PermissionView Permission="iams:assets:view">
                        <!-- Assets -->
                        <a href="/assets" class="@GetFooterNavClass("/assets")">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                            </svg>
                            <span class="text-xs mt-1">Assets</span>
                        </a>
                    </PermissionView>
                    @if (_showSelfServiceLinks)
                    {
                        <!-- Report a problem -->
                        <a href="/report" class="@GetFooterNavClass("/report")">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <span class="text-xs mt-1">Report</span>
                        </a>
                    }

                    <!-- Scan (Primary/Center) -->
                    <a href="/scan" class="flex flex-col items-center justify-center -mt-5">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg shadow-primary/30">
                            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h2M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                            </svg>
                        </div>
                        <span class="mt-1 text-xs font-medium text-primary">Scan</span>
                    </a>

                    @* Ungated, matching the desktop nav above - the warranty reads require no permission. *@
                        <!-- Alerts -->
                        <a href="/warranty-alerts" class="@GetFooterNavClass("/warranty-alerts") relative">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01" />
                            </svg>
                            @if (_alertCount > 0)
                            {
                                <span class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-destructive px-1 text-[10px] font-medium tabular-nums text-destructive-foreground">
                                    @(_alertCount > 9 ? "9+" : _alertCount.ToString())
                                </span>
                            }
                            <span class="text-xs mt-1">Alerts</span>
                        </a>
                    @if (_showSelfServiceLinks)
                    {
                        <!-- My reports -->
                        <a href="/my-tickets" class="@GetFooterNavClass("/my-tickets")">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                            </svg>
                            <span class="text-xs mt-1">My Reports</span>
                        </a>
                    }

                    <!-- More (opens sidebar) -->
                    <button @onclick="OpenMobileMenu" class="flex flex-col items-center justify-center text-muted-foreground transition-colors hover:text-foreground">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <span class="text-xs mt-1">More</span>
                    </button>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

            <!-- Global Snackbar -->
            <Snackbar />
        </div>

@code {
    private bool _mobileMenuOpen;
    private bool _sidebarCollapsed;
    private bool _showAdminGroup;
    private bool _showSelfServiceLinks;
    private int _alertCount;
    private bool _showNotifications;
    private bool _showSearch;
    private bool _showUserMenu;
    private string _searchQuery = "";
    private bool _searchLoading;
    private List<AssetDesk.Shared.DTOs.AssetDto> _searchResults = new();
    private ElementReference _searchInput;
    private CancellationTokenSource? _searchCts;

    // shadcn's ghost icon button, used for the sidebar trigger and the header actions.
    private const string TriggerClasses =
        "inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-muted-foreground "
        + "transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none "
        + "focus-visible:ring-1 focus-visible:ring-ring";

    private const string IconButtonClasses =
        "inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-muted-foreground "
        + "transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none "
        + "focus-visible:ring-1 focus-visible:ring-ring";

    // Minimize is a desktop-only affordance: below lg the sidebar is an off-canvas drawer that is
    // always full width, so every collapsed style is gated behind lg:. Widths come from the
    // --sidebar-width / --sidebar-width-icon tokens so the nav and Components/UI/Sidebar/* agree.
    private string SidebarClasses
    {
        get
        {
            var width = _sidebarCollapsed
                ? "w-[--sidebar-width] lg:w-[--sidebar-width-icon]"
                : "w-[--sidebar-width]";
            var slide = _mobileMenuOpen ? "" : "-translate-x-full lg:translate-x-0 ";
            return $"fixed inset-y-0 left-0 z-50 {width} bg-sidebar text-sidebar-foreground "
                + $"border-r border-sidebar-border shadow-xl sidebar-transition {slide}lg:relative lg:shadow-none";
        }
    }

    private string LogoBarClasses => _sidebarCollapsed
        ? "flex h-16 items-center gap-2 border-b border-sidebar-border px-2 lg:justify-center"
        : "flex h-16 items-center gap-2 border-b border-sidebar-border px-2";

    private const string BrandBase =
        "flex min-w-0 items-center gap-2 rounded-md p-1 transition-colors hover:bg-sidebar-accent";

    private string BrandClasses => _sidebarCollapsed ? $"{BrandBase} lg:p-0" : BrandBase;

    private string BrandTextClasses => _sidebarCollapsed
        ? "grid min-w-0 flex-1 text-left text-sm leading-tight lg:hidden"
        : "grid min-w-0 flex-1 text-left text-sm leading-tight";

    // shadcn's SidebarGroupLabel: same 2rem row height as a menu button, muted and un-shouty.
    private const string SectionLabelBase =
        "flex h-8 shrink-0 items-center rounded-md px-2 text-xs font-medium text-sidebar-foreground/70";

    private string SectionLabelClasses => _sidebarCollapsed
        ? $"{SectionLabelBase} lg:hidden"
        : SectionLabelBase;

    private const string ProfileCardBase =
        "flex min-w-0 items-center gap-2 rounded-md p-1 transition-colors hover:bg-sidebar-accent "
        + "hover:text-sidebar-accent-foreground";

    private string ProfileCardClasses => _sidebarCollapsed
        ? $"{ProfileCardBase} lg:justify-center"
        : ProfileCardBase;

    private string ProfileDetailsClasses => _sidebarCollapsed
        ? "grid min-w-0 flex-1 leading-tight lg:hidden"
        : "grid min-w-0 flex-1 leading-tight";

    protected override async Task OnInitializedAsync()
    {
        // Initialize theme service
        await Theme.InitializeAsync();

        try
        {
            _sidebarCollapsed = await JS.InvokeAsync<bool>("sidebarManager.getCollapsed");
        }
        catch
        {
            // Fallback to expanded if JS/localStorage is unavailable
        }

        // Subscribe to authentication failure events
        Api.OnAuthenticationFailed += OnAuthenticationFailedAsync;

        // The "Admin" heading should show whenever either link under it would show - a role
        // holding only iams:roles:view (and not iams:users:view) still needs somewhere to reach
        // /admin/roles, and a bare heading with no links under it would look broken.
        _showAdminGroup = await PermissionChecker.HasPermissionAsync("iams:users:view")
            || await PermissionChecker.HasPermissionAsync("iams:roles:view");

        // File tickets but do not work the queue. Excluding queue holders is what keeps these out
        // of Staff's and Admin's sidebar - they reach the same tickets through /tickets, and a
        // second personal entry point beside the queue would just be noise.
        _showSelfServiceLinks = await PermissionChecker.HasPermissionAsync("iams:tickets:file")
            && !await PermissionChecker.HasPermissionAsync("iams:tickets:queue");

        await LoadAlertCount();

        // Initialize sync services. The status indicator was removed from the top bar, but the
        // offline queue still has to come up so queued actions replay when the app is back online.
        try
        {
            await Sync.InitializeAsync();
        }
        catch
        {
            // Offline services may fail in some browsers
        }

        // Initialize notification service
        try
        {
            Notifications.OnNotificationsChanged += OnNotificationsChangedAsync;
            await Notifications.InitializeAsync();
        }
        catch
        {
            // Silently fail if not authenticated
        }
    }

    private async Task OnAuthenticationFailedAsync()
    {
        // Redirect to login when authentication fails
        await InvokeAsync(() => Navigation.NavigateTo("/login", forceLoad: true));
    }

    private async Task OnNotificationsChangedAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAlertCount()
    {
        try
        {
            _alertCount = await Api.GetUnacknowledgedWarrantyAlertCountAsync();
        }
        catch
        {
            // Silently fail if not authenticated or API unavailable
            _alertCount = 0;
        }
    }

    private void OpenMobileMenu() => _mobileMenuOpen = true;
    private void CloseMobileMenu() => _mobileMenuOpen = false;

    private async Task ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        try
        {
            await JS.InvokeVoidAsync("sidebarManager.setCollapsed", _sidebarCollapsed);
        }
        catch
        {
            // Preference just won't persist if localStorage is unavailable
        }
    }

    private string GetFooterNavClass(string href, bool exact = false)
    {
        var isActive = exact
            ? Navigation.Uri.EndsWith(href)
            : Navigation.Uri.Contains(href);

        return isActive
            ? "flex flex-col items-center justify-center text-primary"
            : "flex flex-col items-center justify-center text-muted-foreground transition-colors hover:text-foreground";
    }

    private void ToggleNotifications()
    {
        _showNotifications = !_showNotifications;
        _showSearch = false;
        _showUserMenu = false;
    }

    private void CloseNotifications() => _showNotifications = false;

    private void ToggleUserMenu()
    {
        _showUserMenu = !_showUserMenu;
        _showNotifications = false;
        _showSearch = false;
    }

    private void CloseUserMenu() => _showUserMenu = false;

    private void LogoutFromMenu()
    {
        _showUserMenu = false;
        Logout();
    }

    private async Task ToggleSearch()
    {
        _showSearch = !_showSearch;
        _showNotifications = false;
        _showUserMenu = false;
        if (_showSearch)
        {
            _searchQuery = "";
            _searchResults.Clear();
            await Task.Delay(50);
            await _searchInput.FocusAsync();
        }
    }

    private void CloseSearch()
    {
        _showSearch = false;
        _searchQuery = "";
        _searchResults.Clear();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseSearch();
            return;
        }

        // Debounce search
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, _searchCts.Token);
            await PerformSearch();
        }
        catch (TaskCanceledException)
        {
            // Search was cancelled, ignore
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) || _searchQuery.Length < 2)
        {
            _searchResults.Clear();
            return;
        }

        _searchLoading = true;
        StateHasChanged();

        try
        {
            var result = await Api.GetAssetsAsync(search: _searchQuery, page: 1, pageSize: 10);
            _searchResults = result?.Items ?? new();
        }
        catch
        {
            _searchResults.Clear();
        }
        finally
        {
            _searchLoading = false;
        }
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Available" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
        "InUse" => "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400",
        "Maintenance" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
        "Retired" => "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-400",
        "Lost" => "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400",
        _ => "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-400"
    };

    private string GetDeviceTypeBg(string deviceType) => deviceType switch
    {
        "Laptop" or "Desktop" => "bg-blue-100 dark:bg-blue-900/30",
        "Monitor" => "bg-purple-100 dark:bg-purple-900/30",
        "Phone" or "Tablet" => "bg-green-100 dark:bg-green-900/30",
        "Printer" => "bg-orange-100 dark:bg-orange-900/30",
        "Network" or "Server" => "bg-red-100 dark:bg-red-900/30",
        _ => "bg-slate-100 dark:bg-slate-700"
    };

    private RenderFragment GetDeviceTypeIcon(string deviceType)
    {
        return deviceType switch
        {
            "Laptop" or "Desktop" => builder => { builder.AddMarkupContent(0, "<svg class=\"w-5 h-5 text-blue-600 dark:text-blue-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\" /></svg>"); },
            "Monitor" => builder => { builder.AddMarkupContent(0, "<svg class=\"w-5 h-5 text-purple-600 dark:text-purple-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\" /></svg>"); },
            "Phone" => builder => { builder.AddMarkupContent(0, "<svg class=\"w-5 h-5 text-green-600 dark:text-green-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z\" /></svg>"); },
            "Tablet" => builder => { builder.AddMarkupContent(0, "<svg class=\"w-5 h-5 text-green-600 dark:text-green-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z\" /></svg>"); },
            "Printer" => builder => { builder.AddMarkupContent(0, "<svg class=\"w-5 h-5 text-orange-600 dark:text-orange-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z\" /></svg>"); },
            "Network" or "Server" => builder => { builder.AddMarkupContent(0, "<svg class=\"w-5 h-5 text-red-600 dark:text-red-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01\" /></svg>"); },
            _ => builder => { builder.AddMarkupContent(0, "<svg class=\"w-5 h-5 text-muted-foreground\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4\" /></svg>"); }
        };
    }

    private async Task HandleNotificationClick(AssetDesk.Shared.DTOs.NotificationDto notification)
    {
        if (!notification.IsRead)
        {
            await Notifications.MarkAsReadAsync(notification.Id);
        }

        if (!string.IsNullOrEmpty(notification.Link))
        {
            _showNotifications = false;
            Navigation.NavigateTo(notification.Link);
        }
    }

    private async Task MarkAllAsRead()
    {
        await Notifications.MarkAllAsReadAsync();
    }

    private string GetNotificationItemClasses(AssetDesk.Shared.DTOs.NotificationDto notification)
    {
        var baseClasses = "px-4 py-3 cursor-pointer transition-colors duration-200";
        if (notification.IsRead)
        {
            return $"{baseClasses} hover:bg-accent";
        }
        return $"{baseClasses} bg-accent/60 hover:bg-accent";
    }

    private string GetNotificationIconClasses(string type)
    {
        return type switch
        {
            "Warning" => "bg-amber-100 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400",
            "Error" => "bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400",
            "Success" => "bg-emerald-100 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400",
            _ => "bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400"
        };
    }

    private void Logout()
    {
        var m2idAuthority = Configuration["m2ID:Authority"];
        if (!string.IsNullOrEmpty(m2idAuthority))
        {
            // Use NavigateToLogout extension method for proper OIDC logout
            Navigation.NavigateToLogout("authentication/logout");
        }
        else
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Api.OnAuthenticationFailed -= OnAuthenticationFailedAsync;
        Notifications.OnNotificationsChanged -= OnNotificationsChangedAsync;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        await Notifications.DisposeAsync();
    }
}
