@page "/report"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject SnackbarService Snackbar

<PageTitle>Report a Problem - IAMS</PageTitle>

<div class="max-w-lg mx-auto space-y-4 sm:space-y-6">
    @if (_created is not null)
    {
        <!-- Success -->
        <div class="text-center px-4 py-8 animate-scale-in">
            <div class="w-20 h-20 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mx-auto mb-4 success-pulse">
                <svg class="w-10 h-10 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Report sent</h2>
            <p class="text-slate-500 dark:text-slate-400 mb-1">IT has been notified.</p>
            <p class="text-sm text-slate-400 dark:text-slate-500 font-mono mb-6">@_created.Reference</p>
            <div class="flex flex-col gap-3">
                <a href="/my-tickets" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-primary-600 text-white rounded-xl font-medium hover:bg-primary-700 transition-all duration-200">
                    View My Reports
                </a>
                <button @onclick="StartOver" class="text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-300 font-medium transition-colors">
                    Report another problem
                </button>
            </div>
        </div>
    }
    else if (_type is null)
    {
        <!-- Step 1: type picker -->
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">Report a Problem</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">What's going on?</p>
        </div>

        @if (_linkedAsset is not null)
        {
            <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-900/50">
                <svg class="w-5 h-5 text-primary-600 dark:text-primary-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 01-2-2V5a1 1 0 011-1h16a1 1 0 011 1v1a2 2 0 01-2 2M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                </svg>
                <div class="min-w-0">
                    <p class="text-sm font-medium text-slate-900 dark:text-white truncate">@_linkedAsset.DisplayName</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">@_linkedAsset.AssetTag</p>
                </div>
            </div>
        }

        <div class="space-y-3">
            <button @onclick='() => SelectType(Incident)' class="w-full flex items-center gap-4 p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-amber-300 dark:hover:border-amber-700 hover:shadow-lg transition-all duration-200 btn-press text-left">
                <div class="w-14 h-14 rounded-2xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-7 h-7 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-base font-semibold text-slate-900 dark:text-white">Equipment issue</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Something's broken or not working</p>
                </div>
                <svg class="w-5 h-5 text-slate-300 dark:text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>

            <button @onclick='() => SelectType(Request)' class="w-full flex items-center gap-4 p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-lg transition-all duration-200 btn-press text-left">
                <div class="w-14 h-14 rounded-2xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-7 h-7 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-base font-semibold text-slate-900 dark:text-white">Request equipment</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Ask IT for something you need</p>
                </div>
                <svg class="w-5 h-5 text-slate-300 dark:text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>

            <button @onclick='() => SelectType(SecurityEvent)' class="w-full flex items-center gap-4 p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-red-300 dark:hover:border-red-700 hover:shadow-lg transition-all duration-200 btn-press text-left">
                <div class="w-14 h-14 rounded-2xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center shrink-0">
                    <svg class="w-7 h-7 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01" />
                    </svg>
                </div>
                <div class="flex-1">
                    <p class="text-base font-semibold text-slate-900 dark:text-white">Security concern</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Lost device, phishing, suspicious activity</p>
                </div>
                <svg class="w-5 h-5 text-slate-300 dark:text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    }
    else
    {
        <!-- Step 2: short form -->
        <div class="flex items-center gap-2">
            <button @onclick="() => _type = null" class="p-2 -ml-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 dark:hover:text-slate-300 dark:hover:bg-slate-700 transition-all duration-200">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <div>
                <h1 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">@TypeHeading</h1>
                <p class="text-sm text-slate-500 dark:text-slate-400">@TypeSubheading</p>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 sm:p-5 space-y-4">
            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">@TitleLabel</label>
                <input @bind="_title" @bind:event="oninput" type="text" placeholder="@TitlePlaceholder" maxlength="200"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white placeholder-slate-400 transition-all duration-200 hover:border-slate-300 dark:hover:border-slate-500 focus:border-primary-500 text-base" />
            </div>

            @if (_type != SecurityEvent)
            {
                <div class="space-y-1.5">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Details <span class="text-slate-400 font-normal">(optional)</span></label>
                    <textarea @bind="_description" rows="3" placeholder="Anything that will help IT understand the problem..."
                              class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white placeholder-slate-400 resize-none text-base"></textarea>
                </div>
            }

            @if (_type != Request)
            {
                <div class="space-y-1.5">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">
                        Device <span class="text-slate-400 font-normal">(optional)</span>
                    </label>

                    @if (_linkedAsset is not null)
                    {
                        <div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600">
                            <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 01-2-2V5a1 1 0 011-1h16a1 1 0 011 1v1a2 2 0 01-2 2M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                            </svg>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-slate-900 dark:text-white truncate">@_linkedAsset.DisplayName</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">@_linkedAsset.AssetTag</p>
                            </div>
                            <button @onclick="ClearAsset" class="text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline shrink-0">
                                Change
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="relative">
                            <input @bind="_assetSearch" @bind:event="oninput" @onkeyup="HandleAssetSearch" type="text"
                                   placeholder="Search by tag or name..."
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white placeholder-slate-400 text-base" />

                            @if (_assetResults.Count > 0)
                            {
                                <div class="mt-2 rounded-xl border border-slate-200 dark:border-slate-600 overflow-hidden divide-y divide-slate-100 dark:divide-slate-700">
                                    @foreach (var asset in _assetResults)
                                    {
                                        <button @key="asset.Id" @onclick="() => PickAsset(asset)" class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors text-left">
                                            <div class="min-w-0">
                                                <p class="text-sm text-slate-900 dark:text-white truncate">@asset.DisplayName</p>
                                                <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">@asset.AssetTag</p>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_assetSearch) && _assetSearch.Length >= 2 && !_searchingAssets)
                            {
                                <p class="text-xs text-slate-400 dark:text-slate-500 mt-1.5">No matching devices</p>
                            }
                        </div>
                    }
                </div>
            }

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">
                    Attachments <span class="text-slate-400 font-normal">(optional)</span>
                </label>
                <p class="text-xs text-slate-400 dark:text-slate-500">
                    A photo is often faster than a description. Up to @MaxFiles files, @(MaxFileSizeBytes / (1024 * 1024)) MB each.
                </p>

                <div class="flex gap-2">
                    <label for="@_cameraInputId"
                           class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors text-sm cursor-pointer">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Take Photo
                    </label>
                    <InputFile id="@_cameraInputId" class="sr-only" accept="image/*" capture="environment"
                               OnChange="OnPhotoCaptured" disabled="@_submitting" />

                    <label for="@_filesInputId"
                           class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors text-sm cursor-pointer">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>
                        Choose Files
                    </label>
                    <InputFile id="@_filesInputId" class="sr-only" accept="@AttachmentAccept" multiple
                               OnChange="OnFilesChosen" disabled="@_submitting" />
                </div>

                @if (!string.IsNullOrEmpty(_attachError))
                {
                    <p class="text-xs text-red-600 dark:text-red-400">@_attachError</p>
                }

                @if (_pendingFiles.Count > 0)
                {
                    <div class="flex flex-wrap gap-2 pt-1">
                        @foreach (var f in _pendingFiles)
                        {
                            <div @key="f.Id" class="relative">
                                @if (f.PreviewUrl is not null)
                                {
                                    <img src="@f.PreviewUrl" alt="@f.Name" class="w-16 h-16 object-cover rounded-lg border border-slate-200 dark:border-slate-600" />
                                }
                                else
                                {
                                    <div class="w-16 h-16 flex flex-col items-center justify-center gap-1 rounded-lg border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-700 px-1">
                                        <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                        </svg>
                                        <span class="text-[9px] leading-tight text-slate-500 dark:text-slate-400 truncate w-full text-center" title="@f.Name">@f.Name</span>
                                    </div>
                                }
                                <button type="button" @onclick="() => RemoveFile(f)" disabled="@_submitting"
                                        class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-slate-700 dark:bg-slate-600 text-white flex items-center justify-center hover:bg-red-600 transition-colors disabled:opacity-50">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="flex items-start gap-2 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-900/50">
                    <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <p class="text-sm text-red-700 dark:text-red-400">@_error</p>
                </div>
            }

            <button @onclick="Submit" disabled="@(_submitting || string.IsNullOrWhiteSpace(_title))"
                    class="w-full flex items-center justify-center gap-2 px-5 py-3.5 bg-primary-600 text-white rounded-xl font-semibold text-base hover:bg-primary-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-200 shadow-lg shadow-primary-500/25 btn-press">
                @if (_submitting)
                {
                    <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                }
                @SubmitLabel
            </button>
        </div>
    }
</div>

<style>
    .success-pulse {
        animation: successPulse 0.6s ease-out;
    }
    @@keyframes successPulse {
        0% { transform: scale(0.8); opacity: 0; }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    // Mirrors IAMS.Api.Entities.TicketTypes, which the Web project (Shared DTOs only)
    // cannot reference directly.
    private const string Incident = "Incident";
    private const string Request = "Request";
    private const string SecurityEvent = "SecurityEvent";

    // Mirrors IAMS.Api.Entities.TicketAttachmentCategories.Other, for the same reason as above.
    private const string TicketAttachmentCategoryOther = "Other";

    [SupplyParameterFromQuery] public int? AssetId { get; set; }

    // Matches the API's allow-list in FileStorageService (jpeg/png/gif/webp + pdf/doc/docx/txt)
    // so the picker never offers a type UploadAttachment will reject.
    private const string AttachmentAccept = "image/*,.pdf,.doc,.docx,.txt";
    private const int MaxFiles = 6;
    private const long MaxFileSizeBytes = 5 * 1024 * 1024; // matches FileStorageService's default 5 MB per-file limit
    private const long MaxTotalBytes = 20 * 1024 * 1024;
    private const int MaxImageDimension = 1600; // client-side downscale target for photos

    private sealed class PendingFile
    {
        public Guid Id { get; } = Guid.NewGuid();
        public required string Name { get; init; }
        public required string ContentType { get; init; }
        public required byte[] Data { get; init; }
        public string? PreviewUrl { get; init; }
    }

    private string? _type;
    private string _title = "";
    private string _description = "";
    private int? _linkedAssetId;
    private AssetDto? _linkedAsset;
    private string _assetSearch = "";
    private List<AssetDto> _assetResults = new();
    private bool _searchingAssets;
    private bool _submitting;
    private string? _error;
    private TicketDto? _created;
    private System.Timers.Timer? _searchTimer;

    private readonly List<PendingFile> _pendingFiles = new();
    private string? _attachError;
    private readonly string _cameraInputId = $"report-camera-{Guid.NewGuid():N}";
    private readonly string _filesInputId = $"report-files-{Guid.NewGuid():N}";
    private int _uploadedCount;
    private int _uploadTotal;

    private string SubmitLabel => _submitting && _uploadTotal > 0
        ? $"Uploading {_uploadedCount} of {_uploadTotal}..."
        : _submitting ? "Sending..." : "Send Report";

    private string TypeHeading => _type switch
    {
        Incident => "Equipment Issue",
        Request => "Request Equipment",
        SecurityEvent => "Security Concern",
        _ => "Report a Problem"
    };

    private string TypeSubheading => _type switch
    {
        Incident => "Tell us what's wrong",
        Request => "Tell us what you need",
        SecurityEvent => "The fewer details the faster - just get it to us",
        _ => ""
    };

    private string TitleLabel => _type switch
    {
        Incident => "What's wrong?",
        Request => "What do you need?",
        SecurityEvent => "What happened?",
        _ => "Title"
    };

    private string TitlePlaceholder => _type switch
    {
        Incident => "e.g. Laptop won't turn on",
        Request => "e.g. Second monitor for my desk",
        SecurityEvent => "e.g. Lost my laptop on the way home",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        if (AssetId.HasValue)
        {
            _linkedAssetId = AssetId;
            _linkedAsset = await Api.GetAssetAsync(AssetId.Value);
        }
    }

    private void SelectType(string type)
    {
        _type = type;
        _error = null;
    }

    private void ClearAsset()
    {
        _linkedAssetId = null;
        _linkedAsset = null;
        _assetSearch = "";
        _assetResults.Clear();
    }

    private void PickAsset(AssetDto asset)
    {
        _linkedAssetId = asset.Id;
        _linkedAsset = asset;
        _assetSearch = "";
        _assetResults.Clear();
    }

    private void HandleAssetSearch(KeyboardEventArgs e)
    {
        _searchTimer?.Stop();
        _searchTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(_assetSearch) || _assetSearch.Length < 2)
        {
            _assetResults.Clear();
            return;
        }

        _searchTimer = new System.Timers.Timer(300);
        _searchTimer.Elapsed += async (s, ev) =>
        {
            _searchTimer?.Stop();
            await InvokeAsync(async () =>
            {
                _searchingAssets = true;
                StateHasChanged();
                var results = await Api.GetAssetsAsync(search: _assetSearch, page: 1, pageSize: 6);
                _assetResults = results?.Items.ToList() ?? new();
                _searchingAssets = false;
                StateHasChanged();
            });
        };
        _searchTimer.Start();
    }

    private async Task OnPhotoCaptured(InputFileChangeEventArgs e)
    {
        if (e.File is not null)
        {
            await AddFile(e.File);
        }
    }

    private async Task OnFilesChosen(InputFileChangeEventArgs e)
    {
        // Pass a generous ceiling here purely so GetMultipleFiles doesn't throw on a large
        // selection - our own MaxFiles check below is what actually enforces the cap.
        foreach (var file in e.GetMultipleFiles(50))
        {
            await AddFile(file);
        }
    }

    private async Task AddFile(IBrowserFile file)
    {
        _attachError = null;

        if (_pendingFiles.Count >= MaxFiles)
        {
            _attachError = $"You can attach up to {MaxFiles} files.";
            return;
        }

        var isImage = file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

        try
        {
            // Downscale photos client-side: phone camera shots run 5-10MB, which is slow
            // to upload on the poor connections these offices have and eats into the
            // tenant's storage quota. Non-image files (PDF/DOC/TXT) pass through as-is.
            var source = file;
            if (isImage)
            {
                try
                {
                    source = await file.RequestImageFileAsync(file.ContentType, MaxImageDimension, MaxImageDimension);
                }
                catch
                {
                    // Some browsers/formats can't be resized (e.g. HEIC) - fall back to the original
                    // and let the size/type checks below decide whether it can be attached.
                    source = file;
                }
            }

            if (source.Size > MaxFileSizeBytes)
            {
                _attachError = $"\"{file.Name}\" is over the {MaxFileSizeBytes / (1024 * 1024)} MB limit and wasn't added.";
                return;
            }

            var currentTotal = _pendingFiles.Sum(f => (long)f.Data.Length);
            if (currentTotal + source.Size > MaxTotalBytes)
            {
                _attachError = $"Adding \"{file.Name}\" would go over the {MaxTotalBytes / (1024 * 1024)} MB total limit.";
                return;
            }

            await using var stream = source.OpenReadStream(MaxFileSizeBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            _pendingFiles.Add(new PendingFile
            {
                Name = file.Name,
                ContentType = file.ContentType,
                Data = bytes,
                PreviewUrl = isImage ? $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}" : null
            });
        }
        catch (Exception ex)
        {
            _attachError = $"Couldn't read \"{file.Name}\": {ex.Message}";
        }
    }

    private void RemoveFile(PendingFile file)
    {
        _pendingFiles.Remove(file);
        _attachError = null;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_title)) return;

        _submitting = true;
        _error = null;

        var request = new CreateTicketRequest
        {
            Type = _type!,
            Title = _title.Trim(),
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            AssetId = _type == Request ? null : _linkedAssetId
        };

        var (success, ticket, error) = await Api.CreateTicketAsync(request);

        if (success && ticket is not null)
        {
            // The ticket is filed at this point - that's what the employee cares about.
            // Attachment upload failures are reported separately and never undo this.
            if (_pendingFiles.Count > 0)
            {
                await UploadAttachments(ticket.Id);
            }
            else
            {
                Snackbar.Success("Report sent to IT");
            }

            _created = ticket;
        }
        else
        {
            _error = error ?? "Something went wrong sending your report. Please try again.";
        }

        _submitting = false;
    }

    private async Task UploadAttachments(int ticketId)
    {
        _uploadTotal = _pendingFiles.Count;
        _uploadedCount = 0;
        var failed = 0;

        // Sequential, not parallel: these offices are on poor connections, and a batch of
        // 5-10MB photos uploaded at once is far more likely to time out or saturate the link.
        foreach (var f in _pendingFiles)
        {
            _uploadedCount++;
            StateHasChanged();

            using var stream = new MemoryStream(f.Data);
            var (ok, _, _) = await Api.UploadTicketAttachmentAsync(
                ticketId, stream, f.Name, f.ContentType, TicketAttachmentCategoryOther);

            if (!ok) failed++;
        }

        var attached = _uploadTotal - failed;
        if (failed == 0)
        {
            Snackbar.Success(attached == 1 ? "Report sent with 1 attachment" : $"Report sent with {attached} attachments");
        }
        else if (attached == 0)
        {
            Snackbar.Warning("Report sent to IT, but the attachment(s) couldn't be uploaded.");
        }
        else
        {
            Snackbar.Warning($"Report sent to IT. {attached} of {_uploadTotal} attachments uploaded.");
        }
    }

    private void StartOver()
    {
        _created = null;
        _type = null;
        _title = "";
        _description = "";
        _error = null;
        _pendingFiles.Clear();
        _attachError = null;
        _uploadedCount = 0;
        _uploadTotal = 0;
        if (!AssetId.HasValue)
        {
            ClearAsset();
        }
    }

    public void Dispose()
    {
        _searchTimer?.Dispose();
    }
}
